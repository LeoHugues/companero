{% props view %}
{# How pressing the task is, in its colour: sage all good, honey the moment approaches, coral late. #}
{% set alert = view.status.alert %}
{% set icons = {ok: 'check', warning: 'clock', danger: 'alarm'} %}
<span {{ attributes.defaults({class: 'urgency-pill urgency-pill-' ~ alert}) }}>
    <twig:Icon :name="icons[alert]" size="13" stroke="2.8" class="shrink-0"/>
    <span class="truncate">{{ task_status_label(view.task, view.status) }}</span>
</span>
