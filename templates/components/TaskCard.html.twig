{% props view, member, back = 'home', compact = false %}
{#
    A task as a playing card. In its corner, like a card's index: what it is worth and the suit of its
    category. Then how pressing it is (a dot and a word), its title, where and how often, the time left as
    a thin line, and its picture in an arch (TaskVignette). Across the card: the note for this time (or the
    template's precision) and who is counted on; at the bottom, "Je prends" and "C'est fait".
    Its rarity is the finish of its edge — paper, silver, pearl, gold — never written on it; a surprise
    hidden in it this week makes it one class rarer, and wraps it with a ribbon tied in a bow.
    Once done, it turns over (done_controller.js): its back says thank you.
    The whole card opens its page, where its settings are; only the buttons sit above that link.
    compact: lists (rooms), without the picture, with a single round "done" button.
#}
{% set task = view.task %}
{% set status = view.status %}
{% set boost = task_boost(view) %}
{% set rarity = view.rarity %}
{# The time left: an occasional task asleep is full, a fresh one never looks almost empty. #}
{% set left = task.kind.value == 'occasional' and not task.raised ? 100 : (status.urgency.value == 'fresh' ? max(status.freshness, 70) : status.freshness) %}
<article {{ attributes.defaults({
    class: 'play-card play-card-' ~ rarity.value ~ ' play-card-' ~ status.alert ~ (compact ? ' play-card-compact'),
    id: 'task-' ~ task.id,
    'data-rarity': rarity.value,
    'data-alert': status.alert
}) }}>
    {% if view.bounty %}
        {# Wrapped like a present: a terracotta ribbon across its corner, tied with a bow. #}
        <span class="play-card-ribbon" role="img" aria-label="Surprise cachée" title="Une surprise attend la première personne qui la fait cette semaine">
            <svg class="play-card-bow" width="42" height="28" viewBox="0 0 30 20" aria-hidden="true">
                <g stroke="#9A4318" stroke-width=".8" stroke-linejoin="round">
                    <path d="M13.8 10.5 L9.6 18.8 L12.3 17.9 L13.9 19.6 L15.2 11 Z M16.2 10.5 L20.4 18.8 L17.7 17.9 L16.1 19.6 L14.8 11 Z" fill="#D2622B"/>
                    <path d="M15 10 C11 3 3.5 0.5 2.2 4.6 C1 8.6 8 11.5 15 10 Z M15 10 C19 3 26.5 0.5 27.8 4.6 C29 8.6 22 11.5 15 10 Z" fill="#F58A4E"/>
                </g>
                <path d="M15 10 C11.5 6.5 6.5 5 5 6.6 C7.5 8.6 11 9.8 15 10 Z M15 10 C18.5 6.5 23.5 5 25 6.6 C22.5 8.6 19 9.8 15 10 Z" fill="#B4521F" opacity=".5"/>
                <ellipse cx="15" cy="10" rx="2.9" ry="3.1" fill="#D2622B" stroke="#9A4318" stroke-width=".8"/>
            </svg>
        </span>
    {% endif %}
    <div class="play-card-face">
        <div class="play-card-index" aria-hidden="true">
            <span class="play-card-value">{{ task.currentPoints }}</span>
            <twig:Icon :name="task.category.icon" size="17" stroke="1.8"/>
        </div>
        <div class="min-w-0">
            <p class="play-card-status">
                <span class="play-card-dot"></span>
                <span class="truncate">{{ task_status_label(task, status) }}</span>
                {% if status.weeklyCommitment %}
                    {# The week's commitment, as dots: one per time it is expected, filled once done. #}
                    <span class="commit-dots" role="img" aria-label="{{ status.doneThisWeek }} fois sur {{ status.weeklyCommitment }} cette semaine" title="{{ status.doneThisWeek }} fois sur {{ status.weeklyCommitment }} cette semaine">
                        {%- for i in 1..status.weeklyCommitment %}<span class="commit-dot{{ i <= status.doneThisWeek ? ' is-done' }}"></span>{% endfor -%}
                    </span>
                {% endif %}
            </p>
            <h3 class="play-card-title">
                {# Stretched over the whole card: a tap anywhere opens the card's page. #}
                <a href="{{ path('task_show', {id: task.id}) }}" class="text-ink no-underline after:absolute after:inset-0 after:z-[1] after:rounded-[inherit] after:content-[''] hover:text-ink">{{ task.title }}</a>
            </h3>
            <p class="play-card-meta" title="{{ task_place(task) }} · {{ task_rule_label(task) }}">{{ task_place(task, true) }} · {{ task_rule_label(task, false) }}</p>
            <div class="play-card-time" aria-hidden="true"><span style="width: {{ left }}%"></span></div>
        </div>
        {% if not compact %}<twig:TaskVignette :task="task"/>{% endif %}

        {# The word about this time and who is counted on: the card's whole width. #}
        {% set reminder_note %}<twig:ReminderNote :view="view" :member="member"/>{% endset %}
        {# The note for this time if there is one, otherwise the template's own precision. #}
        {% if task.shownNote or reminder_note|trim is not empty %}
            <div class="play-card-notes">
                {% if task.shownNote %}<p class="task-card-note" title="{{ task.note ? 'Pour cette fois' : 'La précision de la tâche' }}"><twig:Icon :name="task.note ? 'edit' : 'list'" size="13" stroke="2" class="mt-0.5 shrink-0"/><span class="line-clamp-2">{{ task.shownNote }}</span></p>{% endif %}
                {{ reminder_note }}
            </div>
        {% endif %}

        {# Only the buttons sit above the card's link. #}
        <twig:TaskActions :view="view" :back="back" :member="member" :boost="boost" :compact="compact" class="play-card-actions"/>
    </div>
    <div class="play-card-back" aria-hidden="true">
        <span class="play-card-back-in">
            <twig:Icon name="home" size="24" stroke="1.6"/>
            <span class="play-card-back-points">+{{ task.currentPoints + boost }}</span>
            <span class="play-card-back-thanks">Merci {{ member.name }}</span>
        </span>
    </div>
</article>
