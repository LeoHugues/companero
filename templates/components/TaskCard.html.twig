{% props view, member, back = 'home' %}
{% set task = view.task %}
{% set bonus = task_bonus(view) %}
<article {{ attributes.defaults({class: 'card card-hover flex flex-col gap-2.5 p-3.5', id: 'task-' ~ task.id}) }}>
    <div class="flex items-start justify-between gap-2.5">
        <div class="flex min-w-0 flex-col gap-1">
            <h3 class="text-[17px] font-bold">
                <a href="{{ path('task_edit', {id: task.id}) }}" class="text-ink no-underline hover:text-clay-dark">{{ task.title }}</a>
            </h3>
            <p class="meta flex items-center gap-1.5">
                <twig:StatusDot :urgency="view.status.urgency"/>
                <span>
                    {{ task_status_label(task, view.status) }} · {{ task.pet.name ?? task.zone.name ?? 'Toute la coloc' }}
                    {% if view.status.weeklyCommitment %}· {{ view.status.doneThisWeek }}/{{ view.status.weeklyCommitment }} cette sem.{% endif %}
                </span>
            </p>
            <twig:ReminderNote :view="view" :member="member"/>
        </div>
        <p class="flex shrink-0 flex-col items-end">
            <span class="text-[15px] font-extrabold whitespace-nowrap text-clay-dark">+{{ task.points + (bonus.points ?? 0) }} pts</span>
            {% if bonus %}<span class="text-[11px] font-bold whitespace-nowrap text-muted">dont +{{ bonus.points }} {{ bonus.reason.label|lower }}</span>{% endif %}
        </p>
    </div>
    <twig:TaskActions :view="view" :back="back" :member="member"/>
</article>
