{% props value, height = 12, color = 'var(--color-clay)', label = null, key = null, delay = 0 %}
{#
    A progress bar that fills up when the page shows (gauge_controller.js). With a `key`, it
    remembers what it showed last time and rises from there, with the gain: "+4 %".
#}
<div {{ attributes.defaults({class: 'gauge track relative'}) }} style="height: {{ height }}px" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ value }}"{% if label %} aria-label="{{ label }}"{% endif %}
     data-controller="gauge" data-gauge-value-value="{{ value }}"{% if key %} data-gauge-key-value="{{ key }}"{% endif %}{% if delay %} data-gauge-delay-value="{{ delay }}"{% endif %}>
    <div class="gauge-fill h-full rounded-full" style="width: {{ value }}%; background: {{ color }}" data-gauge-target="fill"></div>
</div>
