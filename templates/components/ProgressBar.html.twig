{% props value, height = 12, color = 'var(--color-clay)', label = null %}
<div {{ attributes.defaults({class: 'track'}) }} style="height: {{ height }}px" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ value }}"{% if label %} aria-label="{{ label }}"{% endif %}>
    <div class="h-full rounded-full transition-[width] duration-700 ease-out" style="width: {{ value }}%; background: {{ color }}"></div>
</div>
