{% props views, back = 'home' %}
{# Tasks that are never planned: one tap says "I did it" — unless it was just done. #}
<ul {{ attributes.defaults({class: 'flex gap-2 overflow-x-auto pb-0.5 [scrollbar-width:none]'}) }}>
    {% for view in views %}
        <li id="task-{{ view.task.id }}" class="shrink-0">
            {% if view.availableAt %}
                <span class="quick-chip is-resting" title="Fait{{ view.task.lastCompletedBy ? ' par ' ~ view.task.lastCompletedBy.name }}, à nouveau possible {{ available_again(view.availableAt) }}">
                    <span class="quick-chip-tick"><twig:Icon name="check" size="12" stroke="2.6"/></span>
                    <span class="flex flex-col leading-tight">
                        <span>{{ view.task.title }}</span>
                        <span class="text-[11px] font-medium">{{ view.task.lastCompletedBy ? view.task.lastCompletedBy.name ~ ' · ' }}possible {{ available_again(view.availableAt) }}</span>
                    </span>
                </span>
            {% else %}
                <form method="post" action="{{ path('task_complete', {id: view.task.id}) }}" data-controller="done" data-action="submit->done#celebrate">
                    <input type="hidden" name="_back" value="{{ back }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                    <button type="submit" data-haptic="press" aria-label="J’ai fait « {{ view.task.title }} »" class="quick-chip">
                        <span class="quick-chip-tick"><twig:Icon name="check" size="12" stroke="2.6"/></span>
                        {{ view.task.title }}
                        <span class="text-[12.5px] font-semibold text-clay-dark">+{{ view.task.currentPoints + task_boost(view) }}</span>
                    </button>
                </form>
            {% endif %}
        </li>
    {% endfor %}
</ul>
