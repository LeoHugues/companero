{# The boosts running right now (the cleaning day's, a gift activated): a soft sheet of the Casa's yellow, a bolt on each. #}
{% set boosts = active_boosts() %}
{% if boosts.points or boosts.xp %}
    <section {{ attributes.defaults({class: 'flex flex-col gap-2.5 rounded-[20px] bg-[#FDEBC4] p-3.5'}) }} aria-label="Boosts en cours">
        {% for boost in [boosts.points, boosts.xp] %}
            {% if boost %}
                <p class="flex items-center gap-3 text-[13.5px] leading-snug text-warn-ink">
                    <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-sun text-ink shadow-[inset_0_-2px_0_rgba(46,30,20,.12)]"><twig:Icon name="bolt" size="17" stroke="2.2"/></span>
                    <span class="flex min-w-0 flex-1 flex-col">
                        <span class="font-semibold text-ink">{{ boost.source }} : +1 {{ boost.kind.value == 'xp' ? 'XP' : 'pt' }} tous les 3 pts</span>
                        <span class="text-[12px]">jusqu’à {{ boost.endsAt|date('Hi') == '0000' ? 'minuit' : (boost.endsAt|date('Ymd') != 'now'|date('Ymd') ? 'demain ') ~ boost.endsAt|date('G\\hi') }}</span>
                    </span>
                </p>
            {% endif %}
        {% endfor %}
    </section>
{% endif %}
