{% props active %}
{#
    The bottom bar: thin, four words under four drawings, and "Ajouter" in the middle, a round terracotta button
    standing out of the bar on a bump of its own. What is used every day is a tab: the Casa and my hand (Accueil),
    everything there is to do (Tâches), what the house is missing (Courses), the accounts (Comptes). Each drawing
    fills in with the Casa's colours when its page is open. The profile is the face at the top of the home page.

    "Ajouter" opens a sheet from the bottom (add_sheet_controller.js), its content loaded when it first opens; without
    scripts, it is a page.
#}
{% set items = [
    {key: 'home', href: path('app_home'), label: 'Accueil'},
    {key: 'tasks', href: path('task_board'), label: 'Tâches', title: 'Tout ce qu’il y a à faire'},
    {key: 'new', href: path('task_new'), label: 'Ajouter'},
    {key: 'shopping', href: path('shopping_index'), label: 'Courses', title: 'Ce qui manque'},
    {key: 'ledger', href: ledger_tab_path(), label: 'Comptes', title: 'Les dépenses partagées'},
] %}
<nav {{ attributes.defaults({class: 'nav-bar'}) }} aria-label="Navigation principale" data-controller="add-sheet">
    <svg class="nav-bar-bump" width="132" height="30" viewBox="0 0 132 30" aria-hidden="true">
        <path d="M0 25.5 C24 25.5 32 24 40 15.2 C48 6.5 55 2 66 2 C77 2 84 6.5 92 15.2 C100 24 108 25.5 132 25.5 V30 H0 Z" fill="var(--color-surface)"/>
        <path d="M0 25.5 C24 25.5 32 24 40 15.2 C48 6.5 55 2 66 2 C77 2 84 6.5 92 15.2 C100 24 108 25.5 132 25.5" fill="none" stroke="var(--color-line)" stroke-width="1"/>
    </svg>
    <ul class="nav-bar-items">
        {% for item in items %}
            {% set current = item.key == active %}
            <li>
                {% if item.key == 'new' %}
                    <a href="{{ item.href }}" class="nav-bar-add" data-haptic="press" data-action="add-sheet#open" aria-haspopup="dialog">
                        <span class="nav-bar-add-disc" aria-hidden="true"><twig:Icon name="plus" size="26" stroke="2.6"/></span>
                        <span class="nav-bar-label">{{ item.label }}</span>
                    </a>
                {% else %}
                    <a href="{{ item.href }}" class="nav-bar-link{{ current ? ' is-current' }}"{{ current ? ' aria-current="page"' }}{% if item.title is defined %} title="{{ item.title }}"{% endif %}>
                        <span class="nav-bar-icon" aria-hidden="true">
                            {% if item.key == 'home' %}
                                {# A little Casa: her yellow body and terracotta roof when this is the page. #}
                                <svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                    <path class="nav-fill-sun" d="M5.5 11.5 V20 a2.2 2.2 0 0 0 2.2 2.2 h10.6 a2.2 2.2 0 0 0 2.2 -2.2 V11.5"/>
                                    <path class="nav-stroke-clay" d="M3 12.6 L13 4.4 L23 12.6"/>
                                    <circle cx="10.4" cy="14.6" r="1" fill="currentColor" stroke="none"/>
                                    <circle cx="15.6" cy="14.6" r="1" fill="currentColor" stroke="none"/>
                                    <path d="M10.9 17.6 q2.1 1.7 4.2 0" stroke-width="1.6"/>
                                </svg>
                            {% elseif item.key == 'tasks' %}
                                {# Two playing cards, fanned out. #}
                                <svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round">
                                    <rect class="nav-fill-blush" x="3.6" y="5.4" width="10.6" height="15" rx="2.4" transform="rotate(-11 8.9 12.9)"/>
                                    <rect class="nav-fill-surface" x="11" y="5" width="10.6" height="15" rx="2.4" transform="rotate(9 16.3 12.5)"/>
                                    <path class="nav-fill-clay" d="M16.3 10.2 l2 2.4 l-2 2.4 l-2 -2.4 z" transform="rotate(9 16.3 12.5)" stroke-width="1.3"/>
                                </svg>
                            {% elseif item.key == 'shopping' %}
                                {# A basket: the lilac of the shopping list, its handle terracotta. #}
                                <svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                    <path class="nav-stroke-clay" d="M8.6 10.6 L12 4.6 M17.4 10.6 L14.4 5.6"/>
                                    <path class="nav-fill-lilac" d="M3.4 10.6 H22.6 L20.7 20.4 a2 2 0 0 1 -2 1.6 H7.3 a2 2 0 0 1 -2 -1.6 Z"/>
                                    <path d="M9.6 14.4 V18.2 M13 14.4 V18.2 M16.4 14.4 V18.2" stroke-width="1.6"/>
                                </svg>
                            {% else %}
                                {# Two coins: the Casa's yellow behind, terracotta in front. #}
                                <svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                    <circle class="nav-fill-sun" cx="10" cy="10" r="6.2"/>
                                    <circle class="nav-fill-clay" cx="16" cy="16" r="6.2"/>
                                    <path d="M17.6 13.6 a2.6 2.6 0 1 0 0 4.8 M13.4 15.2 h3.4 M13.4 16.9 h3.4" stroke-width="1.5"/>
                                </svg>
                            {% endif %}
                        </span>
                        <span class="nav-bar-label">{{ item.label }}</span>
                    </a>
                {% endif %}
            </li>
        {% endfor %}
    </ul>

    {#
        What can be added, rising from the bottom: its content (task/new_choose.html.twig) is loaded the first time it
        opens. A tap outside, the cross or "back" closes it.
    #}
    <dialog class="add-sheet" aria-labelledby="add-sheet-title" data-add-sheet-target="dialog" data-action="click->add-sheet#backdrop close->add-sheet#closed">
        {# Focused when it opens, so that no button of it is lit up before a tap. #}
        <div class="add-sheet-panel" tabindex="-1" autofocus>
            <span class="add-sheet-grip" aria-hidden="true"></span>
            <turbo-frame id="add-sheet" src="{{ path('task_new') }}" loading="lazy" target="_top">
                <div class="add-sheet-loading" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
            </turbo-frame>
        </div>
    </dialog>
</nav>
