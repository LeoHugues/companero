{% props task %}
{#
    A template, in the list of templates: what comes back in the house, and how — with the picture of its card.
    Never something to do right now (that is a card, on the home page): no urgency, no button, it opens its page.
#}
{% set rarity = task.rarity %}
<li {{ attributes.defaults({id: 'template-' ~ task.id, 'data-rarity': rarity.value, class: 'flex items-center gap-1'}) }}>
    <a href="{{ path('task_template', {id: task.id}) }}" class="list-row min-w-0 flex-1">
        <twig:TaskVignette :task="task" class="vignette-small"/>
        <span class="flex min-w-0 flex-1 flex-col gap-0.5">
            <span class="row-title">{{ task.title }}</span>
            <span class="row-meta">{{ task_place(task) }} · {{ task_rule_label(task) }}</span>
        </span>
        <span class="flex shrink-0 flex-col items-end gap-1.5">
            <span class="text-[14px] font-semibold whitespace-nowrap tabular-nums">{{ task.points }} <span class="text-[12px] font-medium text-muted">pts</span></span>
            {% if rarity.value != 'common' %}<span class="template-rarity template-rarity-{{ rarity.value }}" title="Carte {{ rarity.label|lower }}"><span class="sr-only">Carte {{ rarity.label|lower }}</span></span>{% endif %}
        </span>
        {% if block('content') is empty %}<twig:Icon name="chevron-right" size="17" class="row-chevron"/>{% endif %}
    </a>
    {% block content %}{% endblock %}
</li>
