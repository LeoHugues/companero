{% props task %}
{#
    A template, in the list of templates: what comes back in the house, and how. Never something to
    do right now (that is a card, on the home page): no urgency, no button, it opens its page.
#}
{% set rarity = task.rarity %}
<li id="template-{{ task.id }}" data-rarity="{{ rarity.value }}" class="flex items-center gap-2">
    <a href="{{ path('task_template', {id: task.id}) }}" class="flex min-w-0 flex-1 items-center gap-3 py-3 text-ink no-underline hover:text-ink">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-track text-ink-soft" aria-hidden="true">
            <twig:Icon :name="task_kind_icon(task)" size="20"/>
        </span>
        <span class="flex min-w-0 flex-1 flex-col gap-0.5">
            <span class="text-[15px] leading-snug font-bold [overflow-wrap:anywhere]">{{ task.title }}</span>
            <span class="text-xs text-muted">{{ task.pet.name ?? task.zone.name ?? (task.category.value == 'pets' ? 'Les animaux' : 'Toute la coloc') }} · {{ task_rule_label(task) }}</span>
        </span>
        <span class="flex shrink-0 flex-col items-end gap-1">
            <span class="text-sm font-extrabold whitespace-nowrap">{{ task.points }} pts</span>
            {% if rarity.value != 'common' %}<span class="template-rarity template-rarity-{{ rarity.value }}" title="Carte {{ rarity.label|lower }}"><span class="sr-only">Carte {{ rarity.label|lower }}</span></span>{% endif %}
        </span>
        {% if block('content') is empty %}<twig:Icon name="chevron-right" size="18" class="shrink-0 text-muted"/>{% endif %}
    </a>
    {% block content %}{% endblock %}
</li>
