{% extends 'base.html.twig' %}

{% block title %}Bilan de la semaine {{ review.week.number }} · Companero{% endblock %}

{% block body %}
    {% set week = review.week %}
    {% set team = review.team %}

    <header class="flex items-center justify-between">
        {% if has_previous %}
            <a href="{{ path('review_show', {week: week.previous.start|date('Y-m-d')}) }}" aria-label="Semaine précédente" class="flex size-11 items-center justify-center rounded-full text-ink hover:bg-track"><twig:Icon name="chevron-left" size="22" stroke="2.4"/></a>
        {% else %}
            <span class="size-11"></span>
        {% endif %}
        <div class="flex flex-col items-center">
            <h1 class="text-[22px]">Bilan de la semaine</h1>
            <p class="meta font-semibold">Semaine {{ week.number }} · du {{ week.start|format_date(pattern: 'd', locale: 'fr') }} au {{ week.day(7)|format_date(pattern: 'd MMMM', locale: 'fr') }}</p>
        </div>
        {% if has_next %}
            <a href="{{ path('review_show', {week: week.next.start|date('Y-m-d')}) }}" aria-label="Semaine suivante" class="flex size-11 items-center justify-center rounded-full text-ink hover:bg-track"><twig:Icon name="chevron-right" size="22" stroke="2.4"/></a>
        {% else %}
            <span class="size-11"></span>
        {% endif %}
    </header>

    <section class="card flex flex-col gap-3 p-4" aria-label="Résumé">
        <div class="flex items-end gap-3">
            <twig:CasaMini :size="88" :happy="team.reached" class="shrink-0"/>
            <p class="bubble mb-6 flex-1 text-sm">
                {%- if team.reached -%}
                    {{ review.current ? 'Objectif collectif atteint ! Encore un peu et je brille.' : 'Belle semaine : objectif collectif atteint, bravo à tous !' }}
                {%- elseif review.current -%}
                    Encore {{ team.goal - team.points }} pts pour l’objectif commun. On y croit !
                {%- else -%}
                    {{ team.points }} pts sur {{ team.goal }}. La semaine prochaine sera la bonne.
                {%- endif -%}
            </p>
        </div>
        <div class="flex flex-col gap-1.5">
            <p class="text-[13px] font-bold">Tâches faites chaque jour</p>
            <ol class="grid h-28 grid-cols-7 items-end gap-2">
                {% for day in review.activity %}
                    <li class="flex h-full flex-col items-center justify-end gap-1">
                        <span class="text-[11px] font-bold text-muted">{{ day.count ?: '' }}</span>
                        <span class="w-full rounded-t-lg {{ day.cleaningDay ? 'bg-clay' : 'bg-sun' }}" style="height: {{ max(4, (72 * day.count / review.busiestDayCount)|round) }}px"
                              aria-label="{{ weekday_name(day.day|date('N')) }} : {{ day.count }} tâche{{ day.count > 1 ? 's' }}"></span>
                        <span class="text-[11px] {{ day.cleaningDay ? 'font-extrabold text-ink' : 'font-semibold text-muted' }}">{{ weekday_name(day.day|date('N'))|first|upper }}</span>
                    </li>
                {% endfor %}
            </ol>
            <p class="text-xs text-muted"><span class="mr-1 inline-block size-2.5 rounded-sm bg-clay align-middle"></span>jour de ménage</p>
        </div>
    </section>

    <twig:TeamBar :team="team"/>

    {% if review.commitments is not empty %}
        <section class="flex flex-col gap-2" aria-labelledby="commitments-title">
            <div class="flex items-baseline justify-between">
                <h2 id="commitments-title" class="section-title">Engagements</h2>
                <p class="meta font-bold">{{ review.keptCommitments }} tenu{{ review.keptCommitments > 1 ? 's' }} sur {{ review.commitments|length }}</p>
            </div>
            <ul class="card divide-y divide-line px-3.5 py-1">
                {% for commitment in review.commitments %}
                    <li class="flex items-center gap-2.5 py-2.5">
                        <span class="flex size-6 shrink-0 items-center justify-center rounded-full {{ commitment.kept ? 'bg-sun' : 'bg-track' }}">
                            <twig:Icon :name="commitment.kept ? 'check' : (review.current ? 'minus' : 'close')" size="14" stroke="3"/>
                        </span>
                        <span class="flex-1 text-[15px] font-semibold">{{ commitment.task.title }}</span>
                        <span class="text-sm font-extrabold {{ commitment.kept ? '' : 'text-clay-dark' }}">{{ commitment.done }}/{{ commitment.expected }}</span>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <section class="flex flex-col gap-2" aria-labelledby="members-title">
        <h2 id="members-title" class="section-title">Chacun sa semaine</h2>
        <ul class="grid grid-cols-2 gap-2.5">
            {% for progress in team.members %}
                <li class="card flex flex-col gap-1.5 p-3">
                    <p class="flex items-center gap-2 text-[15px] font-extrabold"><twig:Avatar :member="progress.member"/> {{ progress.member.name }}</p>
                    <p class="text-[22px] leading-none font-extrabold">{{ progress.points }} <span class="text-[13px] font-semibold text-muted">/ {{ progress.goal }} pts</span></p>
                    <p class="text-xs font-bold {{ progress.reached ? 'text-clay-dark' : 'text-muted' }}">
                        {%- if not progress.wasPresent -%}Absent toute la semaine
                        {%- elseif progress.reached -%}Objectif atteint{{ progress.absentDays ? ' · absent ' ~ progress.absentDays ~ ' j' }}
                        {%- else -%}{{ review.current ? 'En route !' : 'Presque !' }}{{ progress.absentDays ? ' · absent ' ~ progress.absentDays ~ ' j' }}
                        {%- endif -%}
                    </p>
                </li>
            {% endfor %}
        </ul>
    </section>

    <section class="flex flex-col gap-2" aria-labelledby="titles-title">
        <div class="flex items-baseline justify-between">
            <h2 id="titles-title" class="section-title">Titres de la semaine</h2>
            {% if review.titles is not empty %}<p class="meta font-semibold">touche pour révéler</p>{% endif %}
        </div>
        {% if review.titles is not empty %}
            <ul class="grid grid-cols-2 gap-2.5">
                {% for title in review.titles %}
                    <li data-controller="reveal">
                        <button type="button" data-reveal-target="cover" data-action="reveal#show"
                                class="flex h-24 w-full cursor-pointer flex-col items-center justify-center gap-1 rounded-[18px] border-[1.5px] border-dashed border-sand bg-track text-ink transition hover:bg-sun active:scale-95">
                            <twig:Spark/>
                            <span class="text-sm font-extrabold">{{ title.member.name }}</span>
                        </button>
                        <div data-reveal-target="card" hidden class="animate-flip flex h-24 flex-col justify-between rounded-[18px] bg-ink p-3 text-cream">
                            <span class="text-xs font-bold text-sun">{{ title.member.name }}</span>
                            <span class="text-[15px] leading-tight font-extrabold">{{ title.name }}</span>
                            <span class="text-[11px] text-[#D9C8B0]">{{ title.reason }}</span>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="card p-4 text-sm text-muted">
                {{ review.current ? 'Les titres seront révélés lundi, une fois la semaine terminée.' : 'Les titres de cette semaine n’ont pas été distribués.' }}
            </p>
        {% endif %}
    </section>

    {% if review.completions is not empty %}
        <section class="flex flex-col gap-2" aria-labelledby="journal-title">
            <h2 id="journal-title" class="section-title">Fait cette semaine</h2>
            <p class="meta -mt-1">C’était plus long ou plus court que prévu ? Ajuste les points.</p>
            <ul class="card divide-y divide-line px-3.5 py-1">
                {% for completion in review.completions %}
                    <li class="flex items-center gap-2.5 py-2">
                        <twig:Avatar :member="completion.member" size="26"/>
                        <div class="flex min-w-0 flex-1 flex-col">
                            <span class="truncate text-sm font-bold">{{ completion.task.title }}</span>
                            <span class="text-xs text-muted">{{ weekday_name(completion.completedAt|date('N')) }} {{ completion.completedAt|date('G\\hi') }}</span>
                        </div>
                        {% for direction in ['moins', 'plus'] %}
                            <form method="post" action="{{ path('completion_adjust', {id: completion.id}) }}">
                                <input type="hidden" name="sens" value="{{ direction }}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                                <button type="submit" aria-label="{{ direction == 'plus' ? 'Un point de plus' : 'Un point de moins' }} pour {{ completion.member.name }}"
                                        class="flex size-9 cursor-pointer items-center justify-center rounded-full border-[1.5px] border-line text-ink transition hover:bg-track active:scale-90">
                                    <twig:Icon :name="direction == 'plus' ? 'plus' : 'minus'" size="16" stroke="2.4"/>
                                </button>
                            </form>
                        {% endfor %}
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
{% endblock %}

{% block nav %}<twig:BottomNav active="review"/>{% endblock %}
