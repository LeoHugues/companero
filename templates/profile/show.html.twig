{% extends 'base.html.twig' %}

{% block title %}Profil · Companero{% endblock %}

{% block body %}
    <header class="flex items-center gap-3.5">
        <twig:Avatar :member="member" size="64"/>
        <div class="flex flex-1 flex-col gap-0.5">
            <h1 class="text-[26px] leading-tight">{{ member.name }}</h1>
            <p class="text-sm font-bold text-clay-dark">Niveau {{ level.number }} · {{ level.rank }}</p>
        </div>
        <a href="{{ path('household_edit') }}" aria-label="Réglages de la coloc" class="flex size-11 items-center justify-center rounded-full text-ink hover:bg-track"><twig:Icon name="settings"/></a>
    </header>

    <section class="card flex flex-col gap-2 p-3.5" aria-label="Expérience">
        <div class="flex justify-between text-sm font-bold">
            <span>Expérience</span>
            <span>{{ level.xp }} / {{ level.ceiling }} XP</span>
        </div>
        <twig:ProgressBar :value="level.progress" label="Progression vers le niveau suivant"/>
        <p class="meta">Encore {{ level.xpToNext }} XP pour devenir <strong class="text-ink">{{ level.nextRank }}</strong> et ouvrir un cadeau.</p>
        <p class="flex items-center gap-1.5 border-t-[1.5px] border-line pt-2 text-sm font-bold">
            <twig:Icon name="flame" size="18" class="text-clay-dark"/>
            {% if member.streak > 0 %}Série de {{ member.streak }} semaine{{ member.streak > 1 ? 's' }} avec l’objectif atteint{% else %}Atteins ton objectif pour lancer une série{% endif %}
            {% if member.bestStreak > member.streak %}<span class="ml-auto text-xs font-semibold text-muted">record : {{ member.bestStreak }}</span>{% endif %}
        </p>
    </section>

    <section class="flex flex-col gap-2" aria-labelledby="gifts-title">
        <h2 id="gifts-title" class="section-title">Mes cadeaux</h2>
        {% for group in gifts %}
            {% set gift = group.gifts|first %}
            <article class="card flex flex-col gap-2.5 p-3.5">
                <div class="flex items-start gap-3">
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-sun"><twig:Icon :name="group.kind.icon" size="22"/></span>
                    <div class="flex flex-1 flex-col gap-0.5">
                        <h3 class="text-[15px]">{{ group.kind.label }}{% if group.gifts|length > 1 %} <span class="text-muted">×{{ group.gifts|length }}</span>{% endif %}</h3>
                        <p class="text-xs text-muted">{{ group.kind.description }} · {{ gift.offeredBy ? 'offert par ' ~ gift.offeredBy.name : gift.reason|lower }}</p>
                    </div>
                </div>
                {% set kind = group.kind.value %}
                {% if kind in ['team_boost', 'xp_boost'] %}
                    <form method="post" action="{{ path('gift_activate', {id: gift.id}) }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                        <button type="submit" class="btn-primary"><twig:Icon name="bolt" size="18"/> Activer</button>
                    </form>
                {% elseif kind == 'friend_boost' and friends is not empty %}
                    <form method="post" action="{{ path('gift_activate', {id: gift.id}) }}" class="flex flex-wrap items-center gap-2">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                        <span class="text-sm font-bold">Pour</span>
                        {% for friend in friends %}
                            <button type="submit" name="pour" value="{{ friend.id }}" class="chip gap-1.5"><twig:Avatar :member="friend" size="20"/>{{ friend.name }}</button>
                        {% endfor %}
                    </form>
                {% elseif kind == 'streak_freeze' %}
                    <p class="text-xs font-semibold">Il se déclenche tout seul une semaine où ton objectif n’est pas atteint.</p>
                    {% if friends is not empty %}
                        <form method="post" action="{{ path('gift_offer', {id: gift.id}) }}" class="flex flex-wrap items-center gap-2">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                            <span class="text-sm font-bold">Ou l’offrir à</span>
                            {% for friend in friends %}
                                <button type="submit" name="pour" value="{{ friend.id }}" class="chip gap-1.5"><twig:Avatar :member="friend" size="20"/>{{ friend.name }}</button>
                            {% endfor %}
                        </form>
                    {% endif %}
                {% elseif kind == 'treat' and member.household.pets is not empty %}
                    <form method="post" action="{{ path('gift_treat', {id: gift.id}) }}" class="flex flex-wrap items-center gap-2">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                        <span class="text-sm font-bold">Pour</span>
                        {% for pet in member.household.pets %}
                            <button type="submit" name="animal" value="{{ pet.id }}" class="chip">{{ pet.name }}</button>
                        {% endfor %}
                        {% if member.household.pets|length > 1 %}<button type="submit" name="animal" value="" class="chip">Tout le monde</button>{% endif %}
                    </form>
                {% endif %}
            </article>
        {% else %}
            <p class="card p-4 text-sm text-muted">Chaque niveau gagné t’apporte un cadeau : boosts, gels de série{{ member.household.pets is not empty ? ', friandises' }}…</p>
        {% endfor %}
    </section>

    <section class="card flex items-center gap-3 p-3.5" aria-labelledby="home-title">
        <twig:Icon :name="member.atHome ? 'home' : 'door'" class="shrink-0 text-clay-dark"/>
        <div class="flex flex-1 flex-col">
            <h2 id="home-title" class="text-[15px]">{{ member.atHome ? 'Je suis à la maison' : 'Je ne suis pas là' }}</h2>
            <p class="text-xs text-muted">{{ member.atHome ? 'Tu reçois les rappels de la coloc.' : 'Les rappels vont aux colocs présents.' }}</p>
        </div>
        <twig:PresenceToggle :member="member" back="profile"/>
    </section>

    {{ form_start(profile_form, {attr: {class: 'flex flex-col gap-5', 'data-controller': 'presence'}}) }}
        <section class="flex flex-col gap-2">
            {{ form_row(profile_form.weeklyGoal, {label_attr: {class: 'section-title'}, attr: {'data-action': 'change->presence#describe'}}) }}
        </section>
        <section class="card flex flex-col gap-2 p-3.5" aria-labelledby="presence-title">
            <div class="flex items-baseline justify-between gap-2">
                <h2 id="presence-title" class="text-[15px]"><label for="{{ profile_form.presenceDays.vars.id }}">Ma présence cette semaine</label></h2>
                <output for="{{ profile_form.presenceDays.vars.id }}" class="text-[15px] font-extrabold text-clay-dark" data-presence-target="days"></output>
            </div>
            {{ form_widget(profile_form.presenceDays, {attr: {class: 'h-8 w-full cursor-pointer accent-clay', 'data-presence-target': 'slider', 'data-action': 'input->presence#describe', 'aria-describedby': 'presence-help'}}) }}
            <ol class="-mt-1 flex justify-between px-1 text-[11px] font-bold text-muted" aria-hidden="true">
                {% for day in 0..7 %}<li class="w-3 text-center">{{ day }}</li>{% endfor %}
            </ol>
            <p id="presence-help" class="meta" data-presence-target="help">Ton objectif suit tes jours de présence, et reste ainsi les semaines suivantes.</p>
        </section>
        <section class="flex flex-col gap-2" aria-labelledby="reminders-title">
            <h2 id="reminders-title" class="section-title">Rappels</h2>
            <div class="card flex flex-col divide-y divide-line px-3.5 py-1">
                {{ form_row(profile_form.notifyCleaningDay) }}
                {{ form_row(profile_form.notifyOverdue) }}
                {{ form_row(profile_form.notifyWeeklyReview) }}
            </div>
        </section>
        <button type="submit" class="btn-primary self-start">Enregistrer</button>
    {{ form_end(profile_form) }}

    <section class="flex flex-col gap-2" aria-labelledby="titles-title">
        <div class="flex items-baseline justify-between">
            <h2 id="titles-title" class="section-title">Mes titres</h2>
            <p class="meta font-semibold">{{ titles|length }} gagné{{ titles|length > 1 ? 's' }}</p>
        </div>
        {% if titles is not empty %}
            <ul class="grid grid-cols-3 gap-2">
                {% for title in titles %}
                    <li class="flex min-h-[92px] flex-col justify-between gap-1.5 rounded-2xl bg-ink p-2.5 text-cream transition hover:-translate-y-0.5 hover:-rotate-1">
                        <twig:Spark size="18" color="#F6C453"/>
                        <span class="text-[13px] leading-tight font-extrabold">{{ title.name }}</span>
                        <span class="text-[11px] leading-tight text-[#D9C8B0]">sem. {{ title.weekStart|date('W') }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="card p-4 text-sm text-muted">Ton premier titre t’attend au bilan de lundi.</p>
        {% endif %}
    </section>

    <a href="{{ path('app_logout') }}" class="btn-link self-center text-muted" data-turbo="false"><twig:Icon name="logout" size="18"/>&nbsp;Se déconnecter</a>
{% endblock %}

{% block nav %}<twig:BottomNav active="profile"/>{% endblock %}
