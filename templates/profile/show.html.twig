{% extends 'base.html.twig' %}

{% block title %}Profil · Companero{% endblock %}

{% block body %}
    <header class="flex items-center gap-4">
        <twig:LevelRing :member="member" :level="level"/>
        <div class="flex min-w-0 flex-1 flex-col gap-0.5">
            <h1 class="truncate text-[26px] leading-tight">{{ member.name }}</h1>
            <p class="text-sm font-bold text-clay-dark">Niveau {{ level.number }} · {{ level.rank }}</p>
            {% if member.streak > 0 %}
                <p class="flex items-center gap-1 text-[13px] font-bold"><twig:Icon name="flame" size="15" stroke="2.4" class="text-clay-dark"/>{{ member.streak }} semaine{{ member.streak > 1 ? 's' }} de série</p>
            {% endif %}
        </div>
    </header>

    <section class="card flex flex-col gap-2 p-3.5" aria-label="Expérience">
        <div class="flex justify-between text-sm font-bold">
            <span>Expérience</span>
            <span><twig:Count :value="level.xp" key="xp"/> / {{ level.ceiling }} XP</span>
        </div>
        <twig:ProgressBar :value="level.progress" label="Progression vers le niveau suivant" key="xp-level"/>
        <p class="meta">Encore {{ level.xpToNext }} XP pour devenir <strong class="text-ink">{{ level.nextRank }}</strong> et ouvrir un cadeau.</p>
        {% if week %}
            <div class="flex flex-col gap-1.5 border-t-[1.5px] border-line pt-2">
                <div class="flex justify-between text-sm font-bold">
                    <span>Mon objectif de la semaine</span>
                    <span><twig:Count :value="week.points" key="week-points"/> / {{ week.goal }} pts</span>
                </div>
                <twig:ProgressBar :value="week.percent" height="8" color="var(--color-sun)" label="Mon objectif de la semaine" key="week"/>
            </div>
        {% endif %}
        <p class="flex items-center gap-1.5 border-t-[1.5px] border-line pt-2 text-sm font-bold">
            <twig:Icon name="flame" size="18" class="text-clay-dark"/>
            {% if member.streak > 0 %}Série de {{ member.streak }} semaine{{ member.streak > 1 ? 's' }} avec l’objectif atteint{% else %}Atteins ton objectif pour lancer une série{% endif %}
            {% if member.bestStreak > member.streak %}<span class="ml-auto text-xs font-semibold text-muted">record : {{ member.bestStreak }}</span>{% endif %}
        </p>
    </section>

    <ul class="grid grid-cols-3 gap-2" aria-label="Mes chiffres">
        {% for stat in [
            {value: stats.done, label: 'tâches faites', icon: 'check'},
            {value: stats.surprises, label: 'surprise' ~ (stats.surprises > 1 ? 's') ~ ' trouvée' ~ (stats.surprises > 1 ? 's'), icon: 'gem'},
            {value: titles|length, label: 'titre' ~ (titles|length > 1 ? 's'), icon: 'trophy'},
        ] %}
            <li class="stat-tile" style="animation-delay: {{ loop.index0 * 90 }}ms">
                <twig:Icon :name="stat.icon" size="18" class="text-clay-dark"/>
                <span class="text-[22px] leading-tight font-extrabold"><twig:Count :value="stat.value" :delay="loop.index0 * 120"/></span>
                <span class="text-[11px] leading-tight font-bold text-muted">{{ stat.label }}</span>
            </li>
        {% endfor %}
    </ul>

    <a href="{{ path('rewards_show') }}" class="card card-hover flex items-center gap-3 p-3.5 text-ink no-underline hover:text-ink">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-sun"><twig:Icon name="trophy" size="22"/></span>
        <span class="flex flex-1 flex-col">
            <span class="text-[15px] font-extrabold">Mes récompenses</span>
            <span class="text-xs text-muted">Le chemin des niveaux, mes trouvailles, mes titres{{ stats.cards ? ', mes cartons' }}</span>
        </span>
        <twig:Icon name="chevron-right" size="20" class="text-muted"/>
    </a>

    <a href="{{ path('history') }}" class="card card-hover flex items-center gap-3 p-3.5 text-ink no-underline hover:text-ink">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-track"><twig:Icon name="check" size="22" stroke="2.4"/></span>
        <span class="flex flex-1 flex-col">
            <span class="text-[15px] font-extrabold">Ce que j’ai fait</span>
            <span class="text-xs text-muted">Mes tâches des 7 ou 30 derniers jours</span>
        </span>
        <twig:Icon name="chevron-right" size="20" class="text-muted"/>
    </a>

    <section class="flex flex-col gap-2" aria-labelledby="gifts-title">
        <h2 id="gifts-title" class="section-title">Mes cadeaux</h2>
        {% for group in gifts %}
            {% set gift = group.gifts|first %}
            <article class="card flex flex-col gap-2.5 p-3.5 {{ group.kind.value == 'yellow_card' ? 'gift-card-yellow' }}" style="animation-delay: {{ loop.index0 * 80 }}ms">
                <div class="flex items-start gap-3">
                    <span class="flex size-10 shrink-0 items-center justify-center rounded-full {{ group.kind.value == 'yellow_card' ? 'bg-legend-soft' : 'bg-sun' }}">
                        {%- if group.kind.value == 'yellow_card' %}<span class="yellow-card yellow-card-mini" aria-hidden="true"></span>{% else %}<twig:Icon :name="group.kind.icon" size="22"/>{% endif -%}
                    </span>
                    <div class="flex flex-1 flex-col gap-0.5">
                        <h3 class="text-[15px]">{{ group.kind.label }}{% if group.gifts|length > 1 %} <span class="text-muted">×{{ group.gifts|length }}</span>{% endif %}</h3>
                        <p class="text-xs text-muted">{{ group.kind.description }} · {{ gift.offeredBy ? 'offert par ' ~ gift.offeredBy.name : gift.reason|lower }}</p>
                    </div>
                </div>
                {% set kind = group.kind.value %}
                {% if kind in ['team_boost', 'xp_boost'] %}
                    <form method="post" action="{{ path('gift_activate', {id: gift.id}) }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                        <button type="submit" class="btn-primary" data-haptic="success"><twig:Icon name="bolt" size="18"/> Activer</button>
                    </form>
                {% elseif kind == 'friend_boost' and friends is not empty %}
                    <form method="post" action="{{ path('gift_activate', {id: gift.id}) }}" class="flex flex-wrap items-center gap-2">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                        <span class="text-sm font-bold">Pour</span>
                        {% for friend in friends %}
                            <button type="submit" name="pour" value="{{ friend.id }}" class="chip gap-1.5"><twig:Avatar :member="friend" size="20"/>{{ friend.name }}</button>
                        {% endfor %}
                    </form>
                {% elseif kind == 'streak_freeze' %}
                    <p class="text-xs font-semibold">Il se déclenche tout seul une semaine où ton objectif n’est pas atteint.</p>
                    {% if friends is not empty %}
                        <form method="post" action="{{ path('gift_offer', {id: gift.id}) }}" class="flex flex-wrap items-center gap-2">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                            <span class="text-sm font-bold">Ou l’offrir à</span>
                            {% for friend in friends %}
                                <button type="submit" name="pour" value="{{ friend.id }}" class="chip gap-1.5"><twig:Avatar :member="friend" size="20"/>{{ friend.name }}</button>
                            {% endfor %}
                        </form>
                    {% endif %}
                {% elseif kind == 'yellow_card' and friends is not empty %}
                    {# Those who do things may hand out cards: to one coloc or several at once, about something in particular. #}
                    <form method="post" action="{{ path('gift_card', {id: gift.id}) }}" class="flex flex-col gap-2.5">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                        <fieldset class="flex flex-wrap items-center gap-2">
                            <legend class="sr-only">Pour qui ? Un ou plusieurs</legend>
                            <span class="text-sm font-bold">Pour</span>
                            <span class="choice-chips">
                                {% for friend in friends %}
                                    <input type="checkbox" name="pour[]" value="{{ friend.id }}" id="card-{{ gift.id }}-{{ friend.id }}"{{ loop.first ? ' checked' }}>
                                    <label for="card-{{ gift.id }}-{{ friend.id }}" class="gap-1.5"><twig:Avatar :member="friend" size="20"/>{{ friend.name }}</label>
                                {% endfor %}
                            </span>
                        </fieldset>
                        {# Why: a word of justification, required; a few usual ones to start from. #}
                        <div class="flex flex-col gap-1.5" data-controller="fill">
                            <label for="card-reason-{{ gift.id }}" class="text-sm font-bold">Pourquoi ce carton ?</label>
                            <textarea id="card-reason-{{ gift.id }}" name="motif" class="input min-h-[84px] py-2.5" rows="3" required data-fill-target="field"
                                      maxlength="{{ constant('App\\Entity\\YellowCard::REASON_MAX_LENGTH') }}" placeholder="La vaisselle qui traîne depuis mardi, alors que c’était ton tour…"></textarea>
                            <span class="flex flex-wrap gap-1.5">
                                {% for reason in ['La vaisselle qui traîne', 'Le linge oublié dans la machine', 'La lumière restée allumée', 'Le dernier rouleau de PQ non remplacé', 'Les miettes sur le plan de travail'] %}
                                    <button type="button" class="chip h-7 px-2.5 text-xs" data-action="fill#use" data-fill-text-param="{{ reason }}">{{ reason }}</button>
                                {% endfor %}
                            </span>
                            <span class="meta">Il le lira avec le carton : dis-lui ce qui ne va pas, gentiment.</span>
                        </div>
                        <button type="submit" class="btn-primary self-start" data-haptic="card"><span class="yellow-card yellow-card-mini" aria-hidden="true"></span> Siffler le carton</button>
                    </form>
                {% elseif kind == 'treat' and member.household.pets is not empty %}
                    <form method="post" action="{{ path('gift_treat', {id: gift.id}) }}" class="flex flex-wrap items-center gap-2">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                        <span class="text-sm font-bold">Pour</span>
                        {% for pet in member.household.pets %}
                            <button type="submit" name="animal" value="{{ pet.id }}" class="chip" data-haptic="purr">{{ pet.name }}</button>
                        {% endfor %}
                        {% if member.household.pets|length > 1 %}<button type="submit" name="animal" value="" class="chip" data-haptic="purr">Tout le monde</button>{% endif %}
                    </form>
                {% endif %}
            </article>
        {% else %}
            <p class="card p-4 text-sm text-muted">Chaque niveau gagné t’apporte un cadeau : boosts, gels de série, cartons jaunes{{ member.household.pets is not empty ? ', friandises' }}… Et des surprises se cachent dans certaines cartes chaque semaine.</p>
        {% endfor %}
    </section>

    <section class="card flex items-center gap-3 p-3.5" aria-labelledby="home-title">
        <twig:Icon :name="member.atHome ? 'home' : 'door'" class="shrink-0 text-clay-dark"/>
        <div class="flex flex-1 flex-col">
            <h2 id="home-title" class="text-[15px]">{{ member.atHome ? 'Je suis à la maison' : 'Je ne suis pas là' }}</h2>
            <p class="text-xs text-muted">{{ member.atHome ? 'Tu reçois les rappels de la coloc.' : 'Les rappels vont aux colocs présents.' }}</p>
        </div>
        <twig:PresenceToggle :member="member" back="profile"/>
    </section>

    {{ form_start(profile_form, {attr: {class: 'flex flex-col gap-5', 'data-controller': 'presence'}}) }}
        <section class="flex flex-col gap-2">
            {{ form_row(profile_form.weeklyGoal, {label_attr: {class: 'section-title'}, attr: {'data-action': 'change->presence#describe'}}) }}
        </section>
        <section class="card flex flex-col gap-2 p-3.5" aria-labelledby="presence-title">
            <div class="flex items-baseline justify-between gap-2">
                <h2 id="presence-title" class="text-[15px]"><label for="{{ profile_form.presenceDays.vars.id }}">Ma présence cette semaine</label></h2>
                <output for="{{ profile_form.presenceDays.vars.id }}" class="shrink-0 text-[15px] font-extrabold whitespace-nowrap text-clay-dark" data-presence-target="days"></output>
            </div>
            {{ form_widget(profile_form.presenceDays, {attr: {class: 'h-8 w-full cursor-pointer accent-clay', 'data-presence-target': 'slider', 'data-action': 'input->presence#describe', 'aria-describedby': 'presence-help'}}) }}
            <ol class="-mt-1 flex justify-between px-1 text-[11px] font-bold text-muted" aria-hidden="true">
                {% for day in 0..7 %}<li class="w-3 text-center">{{ day }}</li>{% endfor %}
            </ol>
            <p id="presence-help" class="meta" data-presence-target="help">Ton objectif suit tes jours de présence, et reste ainsi les semaines suivantes.</p>
        </section>
        <section class="flex flex-col gap-2" aria-labelledby="reminders-title">
            <h2 id="reminders-title" class="section-title">Rappels</h2>
            {# The phone's notifications: only through the Android app (see notifications_controller.js). #}
            <div class="card flex flex-col gap-2.5 p-3.5" data-controller="notifications" id="notifications">
                <p class="flex items-center gap-2 text-[15px] font-extrabold"><twig:Icon name="bell" size="18"/> Notifications</p>
                <p class="text-sm text-ink-soft" data-notifications-target="state">Elles arrivent sur ton téléphone avec l’appli Android de Companero, à jour : ouvre cette page dans l’appli pour les autoriser et les tester.</p>
                <div class="flex flex-wrap items-center gap-2" data-notifications-target="actions" hidden>
                    <button type="button" class="btn-primary h-10 px-4 text-sm" data-notifications-target="allow" data-action="notifications#allow" hidden>Autoriser</button>
                    <button type="button" class="chip gap-1.5" data-notifications-target="test" data-action="notifications#test" data-haptic="tick"><twig:Icon name="bell" size="16"/> M’envoyer une notification de test</button>
                </div>
                <p class="meta">Ce qui t’arrive : les tâches dont tu as la charge (ou que tu remplaces), celles des animaux dont tu es le maître, celles qu’on vient de signaler, et les cartons jaunes reçus.</p>
            </div>
            <div class="card flex flex-col divide-y divide-line px-3.5 py-1">
                {{ form_row(profile_form.notifyCleaningDay) }}
                {{ form_row(profile_form.notifyOverdue) }}
                {{ form_row(profile_form.notifyWeeklyReview) }}
            </div>
        </section>
        <button type="submit" class="btn-primary self-start">Enregistrer</button>
    {{ form_end(profile_form) }}

    <section class="flex flex-col gap-2" aria-labelledby="titles-title">
        <div class="flex items-baseline justify-between">
            <h2 id="titles-title" class="section-title">Mes titres</h2>
            <p class="meta font-semibold">{{ titles|length }} gagné{{ titles|length > 1 ? 's' }}</p>
        </div>
        {% if titles is not empty %}
            <ul class="grid grid-cols-3 gap-2">
                {% for title in titles %}
                    <li class="flex min-h-[92px] flex-col justify-between gap-1.5 rounded-2xl bg-ink p-2.5 text-cream transition hover:-translate-y-0.5 hover:-rotate-1">
                        <twig:Spark size="18" color="#F6C453"/>
                        <span class="text-[13px] leading-tight font-extrabold">{{ title.name }}</span>
                        <span class="text-[11px] leading-tight text-[#D9C8B0]">sem. {{ title.weekStart|date('W') }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="card p-4 text-sm text-muted">Ton premier titre t’attend au bilan de lundi.</p>
        {% endif %}
    </section>

    <a href="{{ path('household_edit') }}" class="card card-hover flex items-center gap-3 p-3.5 text-ink no-underline hover:text-ink">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-sun"><twig:Icon name="home" size="22"/></span>
        <span class="flex flex-1 flex-col">
            <span class="text-[15px] font-extrabold">Réglages de la coloc</span>
            <span class="text-xs text-muted">Objectif de la maison, jour de ménage, charte, colocs, zones, animaux</span>
        </span>
        <twig:Icon name="chevron-right" size="20" class="text-muted"/>
    </a>

    <a href="{{ path('tour_start') }}" class="card card-hover flex items-center gap-3 p-3.5 text-ink no-underline hover:text-ink">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-track"><twig:Icon name="star" size="22"/></span>
        <span class="flex flex-1 flex-col">
            <span class="text-[15px] font-extrabold">Comment ça marche</span>
            <span class="text-xs text-muted">La Casa réexplique les cartes, les points et les objectifs</span>
        </span>
        <twig:Icon name="chevron-right" size="20" class="text-muted"/>
    </a>

    <a href="{{ path('profile_account') }}" class="card card-hover flex items-center gap-3 p-3.5 text-ink no-underline hover:text-ink">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-track"><twig:Icon name="lock" size="22"/></span>
        <span class="flex flex-1 flex-col">
            <span class="text-[15px] font-extrabold">Mon compte</span>
            <span class="text-xs text-muted">Pseudo « {{ member.username }} », mot de passe</span>
        </span>
        <twig:Icon name="chevron-right" size="20" class="text-muted"/>
    </a>

    <a href="{{ path('app_logout') }}" class="btn-link self-center text-muted" data-turbo="false"><twig:Icon name="logout" size="18"/>&nbsp;Se déconnecter</a>
{% endblock %}

{% block nav %}<twig:BottomNav active="profile"/>{% endblock %}
