{% extends 'base.html.twig' %}

{% block title %}Mon compte · Companero{% endblock %}

{% block body %}
    <header class="page-head items-start">
        <div class="min-w-0">
            <p class="eyebrow">Profil</p>
            <h1 class="page-title mt-1">Mon compte</h1>
        </div>
        <a href="{{ path('profile_show') }}" aria-label="Retour au profil" class="head-button"><twig:Icon name="close" size="19" stroke="2"/></a>
    </header>
    <p class="page-lede -mt-2">Ton pseudo et ton mot de passe te connectent, sur ce téléphone comme ailleurs.</p>

    {{ form_start(form, {attr: {class: 'flex flex-col gap-5'}}) }}
        <div class="form-sheet">
            {{ form_row(form.username) }}
            {{ form_row(form.newPassword) }}
        </div>
        <div class="form-group">
            <h2 class="group-label">Pour confirmer</h2>
            <div class="form-sheet">
                {{ form_row(form.currentPassword) }}
            </div>
        </div>
        <button type="submit" class="btn-primary w-full" data-haptic="success">Enregistrer</button>
    {{ form_end(form) }}
{% endblock %}

{% block nav %}<twig:BottomNav active="home"/>{% endblock %}
