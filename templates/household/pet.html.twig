{% extends 'base.html.twig' %}

{% block title %}{{ pet.name }} · Companero{% endblock %}

{% block body %}
    <header class="page-head items-end">
        <div class="flex min-w-0 items-center gap-3">
            {{ include('household/_pet_portrait.html.twig', {pet: pet, class: 'size-14 rounded-[16px]'}) }}
            <div class="min-w-0">
                <p class="eyebrow">{{ pet.species.label }}</p>
                <h1 class="page-title mt-0.5 truncate">{{ pet.name }}</h1>
            </div>
        </div>
        <a href="{{ path('household_edit') }}" aria-label="Retour aux réglages de la coloc" class="head-button"><twig:Icon name="close" size="19" stroke="2"/></a>
    </header>

    {{ form_start(form, {attr: {class: 'flex flex-col gap-3'}}) }}
        <div class="form-sheet">
            {{ form_row(form.name) }}
            {{ form_row(form.species, {attr: {class: 'choice-segmented'}}) }}
            {{ form_row(form.description) }}
            {{ form_row(form.owners) }}
        </div>
        <button type="submit" class="btn-primary w-full" data-haptic="success">Enregistrer</button>
    {{ form_end(form) }}
{% endblock %}

{% block nav %}<twig:BottomNav active="profile"/>{% endblock %}
