{% extends 'base.html.twig' %}

{% block title %}La coloc · Companero{% endblock %}

{#
    The household's settings: its name, goal and cleaning day, its charter, its colocs (and how to invite one),
    its zones and its animals.
#}
{% block body %}
    <header class="page-head items-end">
        <div class="min-w-0">
            <p class="eyebrow">{{ household.name }}</p>
            <h1 class="page-title mt-1">Réglages de la coloc</h1>
        </div>
        <a href="{{ ux_is_native() ? '/recede_historical_location' : path('profile_show') }}" aria-label="Retour" class="head-button"><twig:Icon name="arrow-left" size="20" stroke="2"/></a>
    </header>

    {{ form_start(household_form, {attr: {class: 'flex flex-col gap-3'}}) }}
        <div class="form-sheet">
            {{ form_row(household_form.name) }}
            {{ form_row(household_form.weeklyGoal) }}
            {{ form_row(household_form.cleaningDay, {help: 'Le rendez-vous de la semaine : les engagements sont attendus ce jour-là.'}) }}
            <div class="-mb-2 border-t border-line/70 pt-1.5">{{ form_row(household_form.cleaningDayBoost) }}</div>
        </div>
        <button type="submit" class="btn-primary w-full" data-haptic="success">Enregistrer</button>
    {{ form_end(household_form) }}

    <a href="{{ path('charter_show') }}" class="sheet list-row px-4">
        <span class="tile tile-sun"><twig:Icon name="flag" size="20" stroke="1.9"/></span>
        <span class="flex min-w-0 flex-1 flex-col gap-0.5">
            <span class="row-title">La charte de la coloc</span>
            <span class="row-meta">{{ household.charterRules|length }} règle{{ household.charterRules|length > 1 ? 's' }} de bon sens pour vivre ensemble</span>
        </span>
        <twig:Icon name="chevron-right" size="17" class="row-chevron"/>
    </a>

    <section class="flex flex-col gap-2.5" aria-labelledby="members-title">
        <h2 id="members-title" class="group-label">Les colocs</h2>
        <ul class="list-sheet">
            {% for member in household.members %}
                <li class="list-row min-h-12">
                    <twig:Avatar :member="member" size="32"/>
                    <span class="row-title flex-1">{{ member.name }}</span>
                    {% if member.claimed %}
                        <span class="flex items-center gap-1 rounded-full py-0.5 pr-2.5 pl-2 text-[12px] font-semibold {{ member.atHome ? 'bg-ok-soft text-ok-ink' : 'bg-track/60 text-muted' }}"><twig:Icon :name="member.atHome ? 'home' : 'door'" size="13" stroke="2"/>{{ member.atHome ? 'à la maison' : 'pas là' }}</span>
                    {% else %}
                        <span class="flex items-center gap-1 rounded-full bg-[#FCE6D6] py-0.5 pr-2.5 pl-2 text-[12px] font-semibold text-[#8E3F17]" title="Le lien d’invitation permet de le réclamer"><twig:Icon name="link" size="13" stroke="2"/>à réclamer</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
        <div class="sheet flex flex-col gap-3 p-4" data-controller="copy">
            <p class="flex items-center gap-3">
                <span class="tile tile-sky"><twig:Icon name="link" size="19" stroke="1.9"/></span>
                <span class="flex flex-col gap-0.5">
                    <span class="text-[15px] font-semibold">Inviter quelqu’un</span>
                    <span class="text-[12.5px] leading-snug text-muted">Envoie ce lien à ton nouveau coloc{{ household.unclaimedMembers is not empty ? ' (on y choisit son profil s’il est déjà prêt)' }}.</span>
                </span>
            </p>
            <input type="text" readonly class="input text-[13.5px] text-ink-soft" value="{{ url('onboarding_join', {token: household.inviteToken}) }}" data-copy-target="source" aria-label="Lien d’invitation">
            <div class="flex items-center justify-between gap-3">
                <button type="button" class="btn-soft" data-action="copy#copy" data-haptic="tick"><twig:Icon name="link" size="16" stroke="2"/><span data-copy-target="label">Copier le lien</span></button>
                <form method="post" action="{{ path('household_invite_reset') }}" data-turbo-confirm="L’ancien lien ne marchera plus. Continuer ?">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                    <button type="submit" class="btn-link h-10 text-[13px]"><twig:Icon name="repeat" size="15" stroke="1.9"/>Nouveau lien</button>
                </form>
            </div>
        </div>
        <form method="post" action="{{ path('household_member_add') }}" class="sheet flex flex-col gap-3 p-4">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
            <label for="new-member" class="field-label">Préparer le profil d’un coloc</label>
            <input type="text" id="new-member" name="prenom" class="input" maxlength="40" required placeholder="Son prénom" autocomplete="off">
            <p class="text-[12.5px] leading-snug text-muted">Tu peux lui confier des tâches et des animaux tout de suite ; le lien d’invitation lui permettra ensuite de réclamer son profil.</p>
            <button type="submit" class="btn-soft self-start"><twig:Icon name="plus" size="16" stroke="2.4"/>Préparer son profil</button>
        </form>
    </section>

    <section class="flex flex-col gap-2.5" aria-labelledby="zones-title">
        <h2 id="zones-title" class="group-label">Zones</h2>
        <ul class="list-sheet">
            {% for zone in household.zones %}
                <li class="flex items-center gap-1">
                    <a href="{{ path('zone_edit', {id: zone.id}) }}" class="list-row min-h-12 min-w-0 flex-1">
                        <span class="flex min-w-0 flex-1 flex-col">
                            <span class="row-title">{{ zone.name }}</span>
                            {% if zone.private or zone.planShape %}<span class="row-meta">{{ [zone.private ? 'privée', zone.planShape ? 'sur le plan']|filter(v => v)|join(' · ')|capitalize }}</span>{% endif %}
                        </span>
                    </a>
                    <a href="{{ path('zone_edit', {id: zone.id}) }}" aria-label="Réglages de la zone {{ zone.name }}" class="row-button"><twig:Icon name="settings" size="17" stroke="1.9"/></a>
                    <form method="post" action="{{ path('zone_delete', {id: zone.id}) }}" data-turbo-confirm="Supprimer la zone « {{ zone.name }} » ? Ses tâches restent, pour toute la coloc.">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                        <button type="submit" aria-label="Supprimer la zone {{ zone.name }}" class="row-button -mr-1.5"><twig:Icon name="trash" size="17" stroke="1.9"/></button>
                    </form>
                </li>
            {% endfor %}
        </ul>
        {{ form_start(zone_form, {attr: {class: 'sheet flex flex-col gap-3 p-4'}}) }}
            {{ form_row(zone_form.name) }}
            <div class="-mt-1">{{ form_row(zone_form.private) }}</div>
            <button type="submit" class="btn-soft self-start"><twig:Icon name="plus" size="16" stroke="2.4"/>Ajouter la zone</button>
        {{ form_end(zone_form) }}
    </section>

    <section class="flex flex-col gap-2.5" aria-labelledby="pets-title">
        <h2 id="pets-title" class="group-label">Les animaux</h2>
        {% if household.pets is not empty %}
            <ul class="list-sheet">
                {% for pet in household.pets %}
                    <li class="flex items-center gap-1">
                        <a href="{{ path('pet_edit', {id: pet.id}) }}" class="list-row min-w-0 flex-1">
                            {{ include('household/_pet_portrait.html.twig', {pet: pet, class: 'size-12 rounded-[14px]'}) }}
                            <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                                <span class="row-title">{{ pet.name }}</span>
                                <span class="row-meta">{{ pet.species.label }}{{ pet.description ? ' · ' ~ pet.description }}</span>
                                <span class="text-[12px] leading-snug font-medium {{ pet.owners is empty ? 'text-clay-dark' : 'text-muted' }}">{{ pet.owners is empty ? 'Pas encore de maître : à qui est-il ?' : 'À ' ~ pet.owners|map(o => o.name)|join(', ', ' et ') }}</span>
                            </span>
                        </a>
                        <a href="{{ path('pet_edit', {id: pet.id}) }}" aria-label="Réglages de {{ pet.name }}" class="row-button"><twig:Icon name="settings" size="17" stroke="1.9"/></a>
                        <form method="post" action="{{ path('pet_delete', {id: pet.id}) }}" data-turbo-confirm="Retirer {{ pet.name }} de la coloc ? Ses tâches restent.">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                            <button type="submit" aria-label="Retirer {{ pet.name }}" class="row-button -mr-1.5"><twig:Icon name="trash" size="17" stroke="1.9"/></button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        {{ form_start(pet_form, {attr: {class: 'sheet flex flex-col gap-5 p-4'}}) }}
            {{ form_row(pet_form.name) }}
            {{ form_row(pet_form.species, {attr: {class: 'choice-segmented'}}) }}
            {{ form_row(pet_form.description) }}
            {{ form_row(pet_form.owners) }}
            <button type="submit" class="btn-soft self-start"><twig:Icon name="plus" size="16" stroke="2.4"/>Ajouter l’animal</button>
        {{ form_end(pet_form) }}
        {% if treats is not empty %}
            <ul class="flex flex-col gap-1.5 px-1" aria-label="Dernières friandises">
                {% for treat in treats %}
                    <li class="flex items-center gap-2 text-[12.5px] leading-snug text-muted"><twig:Icon name="paw" size="13" stroke="2" class="shrink-0 text-dust"/>{{ treat.owner.name }} a donné une friandise {{ treat.pet ? 'à ' ~ treat.pet.name : 'à tout le monde' }} · {{ treat.usedAt|format_date(pattern: 'EEEE d MMM', locale: 'fr') }}</li>
                {% endfor %}
            </ul>
        {% endif %}
        <p class="px-1 text-[12.5px] leading-snug text-muted">Leurs tâches (repas, litière…) se créent dans la catégorie « Animaux », avec qui s’en charge et qui prévenir en son absence.</p>
    </section>
{% endblock %}

{% block nav %}<twig:BottomNav active="profile"/>{% endblock %}
