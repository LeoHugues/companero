{% extends 'base.html.twig' %}

{% block title %}La coloc · Companero{% endblock %}

{% block body %}
    <header class="flex items-center justify-between">
        <h1 class="text-[26px]">La coloc</h1>
        <a href="{{ path('profile_show') }}" aria-label="Retour au profil" class="flex size-11 items-center justify-center rounded-full text-ink"><twig:Icon name="close" size="22" stroke="2.2"/></a>
    </header>

    {{ form_start(household_form, {attr: {class: 'flex flex-col gap-5'}}) }}
        {{ form_row(household_form.name) }}
        {{ form_row(household_form.cleaningDay, {help: 'Le rendez-vous de la semaine : les engagements sont attendus ce jour-là.'}) }}
        <button type="submit" class="btn-primary self-start">Enregistrer</button>
    {{ form_end(household_form) }}

    <section class="flex flex-col gap-2" aria-labelledby="members-title">
        <h2 id="members-title" class="section-title">Les colocs</h2>
        <ul class="card divide-y divide-line px-3.5 py-1">
            {% for member in household.members %}
                <li class="flex items-center gap-2.5 py-2.5">
                    <twig:Avatar :member="member"/><span class="flex-1 text-[15px] font-bold">{{ member.name }}</span>
                    <span class="flex items-center gap-1 text-xs font-bold {{ member.atHome ? 'text-ink' : 'text-muted' }}"><twig:Icon :name="member.atHome ? 'home' : 'door'" size="14" stroke="2.4"/>{{ member.atHome ? 'à la maison' : 'pas là' }}</span>
                </li>
            {% endfor %}
        </ul>
        <div class="card flex flex-col gap-2 p-3.5" data-controller="copy">
            <p class="field-label">Inviter quelqu’un</p>
            <p class="meta">Envoie ce lien à ton nouveau coloc :</p>
            <input type="text" readonly class="input text-sm" value="{{ url('onboarding_join', {token: household.inviteToken}) }}" data-copy-target="source" aria-label="Lien d’invitation">
            <div class="flex items-center gap-3">
                <button type="button" class="btn-primary" data-action="copy#copy"><twig:Icon name="link" size="18"/> <span data-copy-target="label">Copier le lien</span></button>
                <form method="post" action="{{ path('household_invite_reset') }}" data-turbo-confirm="L’ancien lien ne marchera plus. Continuer ?">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                    <button type="submit" class="btn-link">Nouveau lien</button>
                </form>
            </div>
        </div>
    </section>

    <section class="flex flex-col gap-2" aria-labelledby="zones-title">
        <h2 id="zones-title" class="section-title">Zones</h2>
        <ul class="card divide-y divide-line px-3.5 py-1">
            {% for zone in household.zones %}
                <li class="flex items-center gap-2.5 py-2">
                    <span class="flex-1 text-[15px] font-bold">{{ zone.name }}{% if zone.private %} <span class="text-xs font-semibold text-muted">· privée</span>{% endif %}</span>
                    <form method="post" action="{{ path('zone_delete', {id: zone.id}) }}" data-turbo-confirm="Supprimer la zone « {{ zone.name }} » ? Ses tâches restent, pour toute la coloc.">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                        <button type="submit" aria-label="Supprimer la zone {{ zone.name }}" class="flex size-10 cursor-pointer items-center justify-center rounded-full text-muted hover:bg-track hover:text-ink"><twig:Icon name="trash" size="18"/></button>
                    </form>
                </li>
            {% endfor %}
        </ul>
        {{ form_start(zone_form, {attr: {class: 'card flex flex-col gap-3 p-3.5'}}) }}
            {{ form_row(zone_form.name) }}
            {{ form_row(zone_form.private) }}
            <button type="submit" class="btn-primary self-start"><twig:Icon name="plus" size="18" stroke="2.6"/> Ajouter la zone</button>
        {{ form_end(zone_form) }}
    </section>

    <section class="flex flex-col gap-2" aria-labelledby="pets-title">
        <h2 id="pets-title" class="section-title">Les animaux</h2>
        {% if household.pets is not empty %}
            <ul class="card divide-y divide-line px-3.5 py-1">
                {% for pet in household.pets %}
                    <li class="flex items-center gap-2.5 py-2">
                        <twig:Icon name="paw" size="20" class="shrink-0 text-clay-dark"/>
                        <span class="flex flex-1 flex-col">
                            <span class="text-[15px] font-bold">{{ pet.name }}</span>
                            <span class="text-xs text-muted">{{ pet.species.label }}{{ pet.description ? ' · ' ~ pet.description }}</span>
                        </span>
                        <form method="post" action="{{ path('pet_delete', {id: pet.id}) }}" data-turbo-confirm="Retirer {{ pet.name }} de la coloc ? Ses tâches restent.">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                            <button type="submit" aria-label="Retirer {{ pet.name }}" class="flex size-10 cursor-pointer items-center justify-center rounded-full text-muted hover:bg-track hover:text-ink"><twig:Icon name="trash" size="18"/></button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        {{ form_start(pet_form, {attr: {class: 'card flex flex-col gap-3 p-3.5'}}) }}
            {{ form_row(pet_form.name) }}
            {{ form_row(pet_form.species) }}
            {{ form_row(pet_form.description) }}
            <button type="submit" class="btn-primary self-start"><twig:Icon name="plus" size="18" stroke="2.6"/> Ajouter l’animal</button>
        {{ form_end(pet_form) }}
        <p class="meta">Leurs tâches (repas, litière…) se créent dans la catégorie « Animaux », avec qui s’en charge et qui prévenir en son absence.</p>
    </section>
{% endblock %}

{% block nav %}<twig:BottomNav active="profile"/>{% endblock %}
