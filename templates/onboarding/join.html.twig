{% extends 'base.html.twig' %}

{% block title %}Rejoindre {{ household.name }} · Companero{% endblock %}
{% block main_class %}pb-10{% endblock %}

{#
    Joining a coloc by its invitation link, as someone new, one question at a time (steps_controller.js) like creating
    it: who is already there and your first name, then what will log you in again. Its profiles waiting to be claimed
    are offered first (join_choose.html.twig).
#}
{% block body %}
    {% set names = household.members|map(m => m.name)|join(', ', ' et ') %}
    {{ include('_casa_hero.html.twig', {mood: enum('App\\Enum\\CasaMood').Radiant, speech: 'Bienvenue ! On t’attendait.'}) }}

    {{ form_start(form, {attr: {class: 'hero-sheet', 'data-controller': 'steps', 'data-action': 'keydown->steps#enter'}}) }}
        <div class="steps-head">
            <button type="button" class="steps-back" data-steps-target="back" data-action="steps#back" hidden><twig:Icon name="chevron-left" size="17" stroke="2.2"/>Retour</button>
            <ol class="steps-dots" aria-hidden="true">
                {% for i in 1..2 %}<li data-steps-target="dot"{% if i == 1 %} class="is-done"{% endif %}></li>{% endfor %}
            </ol>
        </div>

        <section class="steps-step" data-steps-target="step" data-speech="Bienvenue chez {{ household.name }} ! Tu t’appelles comment ?">
            <div>
                <h1 class="home-title">Rejoindre {{ household.name }}</h1>
                <div class="mt-2.5 flex items-center gap-2.5">
                    <p class="flex shrink-0">
                        {% for member in household.members|slice(0, 5) %}<twig:Avatar :member="member" size="30" class="-mr-2 ring-2 ring-surface"/>{% endfor %}
                    </p>
                    <p class="ml-1.5 text-[13.5px] leading-snug text-muted">{{ names }} {{ household.members|length > 1 ? 'sont' : 'est' }} déjà là.</p>
                </div>
            </div>
            {{ form_row(form.name, {help: 'C’est lui que tes colocs verront, sur les cartes et les comptes.'}) }}
            <button type="button" class="btn-primary h-[52px] w-full text-[16px]" data-steps-target="next" data-action="steps#next" hidden>Suivant<twig:Icon name="chevron-right" size="19" stroke="2.4"/></button>
        </section>

        <section class="steps-step" data-steps-target="step" data-speech="Enchantée, {name} ! De quoi te reconnecter, et tu es chez toi.">
            <div>
                <h2 class="home-title">Pour te reconnecter</h2>
                <p class="mt-1 text-[13.5px] leading-snug text-muted">Sur ce téléphone, tu restes connecté : tu n’en auras besoin que sur un autre.</p>
            </div>
            {{ form_row(form.username) }}
            {{ form_row(form.plainPassword, {help: 'Au moins 8 caractères.', attr: {minlength: 8}}) }}
            <button type="submit" class="btn-primary h-[52px] w-full text-[16px]" data-haptic="success" data-turbo-submits-with="On t’installe…">Je rejoins la coloc<twig:Icon name="chevron-right" size="19" stroke="2.4"/></button>
        </section>
    {{ form_end(form) }}

    {% if can_choose %}
        <a href="{{ path('onboarding_join', {token: household.inviteToken}) }}" class="btn-link self-center">Mon profil est déjà là</a>
    {% else %}
        <p class="text-center text-[13.5px] text-muted">Déjà un compte ? <a href="{{ path('app_login') }}" class="font-semibold">Se connecter</a></p>
    {% endif %}
{% endblock %}
