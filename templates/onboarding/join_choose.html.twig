{% extends 'base.html.twig' %}

{% block title %}Rejoindre {{ household.name }} · Companero{% endblock %}
{% block main_class %}pb-10{% endblock %}

{% block body %}
    {{ include('_casa_hero.html.twig', {mood: enum('App\\Enum\\CasaMood').Radiant, speech: 'Bienvenue ! On t’attendait. Tu es… ?'}) }}

    <section class="hero-sheet gap-4">
        <div>
            <h1 class="home-title">Rejoindre {{ household.name }}</h1>
            <p class="mt-1 text-[13.5px] leading-snug text-muted">Ton profil est peut-être déjà prêt : choisis-le, tu retrouveras tout ce qui t’attend.</p>
        </div>
        <ul class="-mx-4 flex flex-col border-t border-line/70 px-4" aria-label="Les profils à réclamer">
            {% for member in unclaimed %}
                <li class="[&+li]:border-t [&+li]:border-line/70">
                    <a href="{{ path('onboarding_claim', {token: household.inviteToken, member: member.id}) }}" class="list-row py-3">
                        <twig:Avatar :member="member" size="40"/>
                        <span class="row-title flex-1 text-[16px]">Je suis {{ member.name }}</span>
                        <twig:Icon name="chevron-right" size="17" class="row-chevron"/>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </section>

    <a href="{{ path('onboarding_join', {token: household.inviteToken, nouveau: 1}) }}" class="btn-link self-center">Je suis quelqu’un d’autre</a>
{% endblock %}
