{% extends 'onboarding/tour/_layout.html.twig' %}

{% block speech %}Dernière étape : à toi de régler les tiens. Tout se change ensuite dans ton profil.{% endblock %}

{% block heading %}Mes réglages{% endblock %}

{% block content %}
    {{ form_start(form, {attr: {id: 'tour-settings', class: 'flex flex-col gap-5', 'data-controller': 'presence'}}) }}
        <div class="form-sheet">
            {{ form_row(form.goal, {attr: {class: 'choice-segmented is-wrapping', 'data-action': 'change->presence#describe'}, help: 'De 5 à 20 minutes par jour. Pour que la maison atteigne ses ' ~ household.weeklyGoal ~ ' pts, ça fait environ ' ~ share ~ ' pts chacun. Commence petit : tu pourras monter.'}) }}
            <div class="flex flex-col gap-2 border-t border-line/70 pt-4" aria-labelledby="presence-title">
                <div class="flex items-baseline justify-between gap-2">
                    <h2 id="presence-title" class="field-label"><label for="{{ form.presenceDays.vars.id }}">Je suis là combien de jours par semaine ?</label></h2>
                    <output for="{{ form.presenceDays.vars.id }}" class="shrink-0 text-[14px] font-semibold whitespace-nowrap text-clay-dark" data-presence-target="days"></output>
                </div>
                {{ form_widget(form.presenceDays, {attr: {class: 'h-8 w-full cursor-pointer', 'data-presence-target': 'slider', 'data-action': 'input->presence#describe', 'aria-describedby': 'presence-help'}}) }}
                <ol class="-mt-1.5 flex justify-between px-1 text-[11px] font-semibold text-dust tabular-nums" aria-hidden="true">
                    {% for day in 0..7 %}<li class="w-3 text-center">{{ day }}</li>{% endfor %}
                </ol>
                <p id="presence-help" class="text-[12.5px] leading-snug text-muted" data-presence-target="help">Ton objectif suit tes jours de présence.</p>
            </div>
        </div>
        <section class="flex flex-col gap-2" aria-labelledby="reminders-title">
            <h2 id="reminders-title" class="group-label">Mes rappels</h2>
            {# In the Android app: allow the phone's notifications right here (notifications_controller.js). #}
            <div class="sheet flex flex-col gap-3 p-4" data-controller="notifications">
                <p class="flex items-center gap-3">
                    <span class="tile tile-sky"><twig:Icon name="bell" size="19" stroke="1.9"/></span>
                    <span class="text-[15px] font-semibold">Notifications</span>
                </p>
                <p class="text-[13.5px] leading-snug text-ink-soft" data-notifications-target="state">Elles arrivent sur ton téléphone avec l’appli Android de Companero.</p>
                <div class="flex flex-wrap items-center gap-2" data-notifications-target="actions" hidden>
                    <button type="button" class="btn-primary h-10 px-4 text-[14px]" data-notifications-target="allow" data-action="notifications#allow" hidden>Autoriser</button>
                    <button type="button" class="btn-soft" data-notifications-target="test" data-action="notifications#test" data-haptic="tick"><twig:Icon name="bell" size="16" stroke="1.9"/>Essayer</button>
                </div>
            </div>
            <div class="form-sheet is-rows">
                {{ form_row(form.notifyCleaningDay) }}
                {{ form_row(form.notifyOverdue) }}
                {{ form_row(form.notifyWeeklyReview) }}
            </div>
        </section>
    {{ form_end(form) }}
{% endblock %}

{% block next %}
    <button type="submit" form="tour-settings" class="btn-primary h-[52px] px-6 text-[16px]" data-haptic="success">C’est parti <twig:Icon name="chevron-right" size="19" stroke="2.4"/></button>
{% endblock %}
