{% extends 'onboarding/tour/_layout.html.twig' %}

{% block speech %}La plupart des tâches n’ont pas de date : elles ont un rythme. Elles glissent.{% endblock %}

{% block heading %}Le glissement{% endblock %}

{% block content %}
    <p class="-mt-1 text-[15px] leading-relaxed text-ink-soft">
        L’aspirateur ou le coup de balai du salon, c’est environ <strong class="font-semibold text-ink">tous les 2 jours</strong>. Plus le temps
        passe depuis la dernière fois, plus la carte devient pressante. Fais glisser le temps pour voir :
    </p>

    {{ include('onboarding/tour/_demo_card.html.twig', {glide: true, age: 1}) }}

    {# The words of the home page's groups, in their colours. #}
    <ul class="sheet grid grid-cols-2 gap-x-3 gap-y-3 p-4" aria-label="Les états d’une carte">
        <li class="care-group-title is-fresh mt-0"><span class="care-group-dot"></span>Fraîche</li>
        <li class="care-group-title is-soon mt-0"><span class="care-group-dot"></span>Bientôt</li>
        <li class="care-group-title is-due mt-0"><span class="care-group-dot"></span>C’est le moment</li>
        <li class="care-group-title is-late mt-0"><span class="care-group-dot"></span>En retard</li>
    </ul>

    <ul class="list-sheet text-[14px] leading-snug text-ink-soft">
        <li class="py-3"><strong class="font-semibold text-ink">Pas besoin d’attendre</strong> qu’elle soit due : on la fait quand on veut, et elle repart à zéro.</li>
        <li class="py-3"><strong class="font-semibold text-ink">Jamais en double</strong> : c’est toujours la même carte, qui attend son tour, de plus en plus pressante.</li>
        <li class="py-3"><strong class="font-semibold text-ink">Pas de punition</strong> : en retard ou pas, elle rapporte les mêmes points.</li>
    </ul>
{% endblock %}
