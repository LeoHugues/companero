{#
    A card to try out, looking just like a real one (TaskCard, TaskVignette, TaskActions), driven by
    tour_card_controller.js. glide: a slider ages it half a day at a time.
#}
{% set rhythm = rhythm|default(2) %}
{% set age = age|default(rhythm) %}
<div class="flex flex-col gap-3" data-controller="tour-card" data-tour-card-rhythm-value="{{ rhythm }}" data-tour-card-age-value="{{ age }}">
    <article class="play-card play-card-common play-card-warning" data-tour-card-target="card" aria-label="Une carte pour essayer">
        <div class="play-card-face">
            <div class="play-card-index" aria-hidden="true">
                <span class="play-card-value">20</span>
                <twig:Icon name="broom" size="17" stroke="1.8"/>
            </div>
            <div class="min-w-0">
                <p class="play-card-status">
                    <span class="play-card-dot"></span>
                    <span class="truncate" data-tour-card-target="label">Aujourd’hui</span>
                </p>
                <h3 class="play-card-title">Aspirateur ou balai au salon</h3>
                <p class="play-card-meta">Salon · tous les {{ rhythm }} j</p>
                <div class="play-card-time" aria-hidden="true"><span data-tour-card-target="time" style="width: 8%; transition: width 400ms ease, background-color 400ms ease"></span></div>
            </div>
            <twig:TaskVignette art="vacuum"/>

            <div class="task-actions play-card-actions relative z-[2] flex flex-wrap items-center justify-between gap-x-2 gap-y-2">
                <button type="button" class="seat" data-tour-card-target="seat" data-action="tour-card#take">
                    <span class="seat-empty" aria-hidden="true"><twig:Icon name="plus" size="12" stroke="2.6"/></span>
                    Je prends
                </button>
                <button type="button" class="seat seat-taken seat-mine" title="Tu t’en occupes — touche pour la laisser" data-tour-card-target="taken" data-action="tour-card#leave" hidden>
                    <twig:Avatar :member="app.user" size="28"/>
                    <span class="flex flex-col leading-none">
                        <span class="text-[10px] font-semibold tracking-wide text-muted uppercase">Pris par</span>
                        <span class="text-[13px] font-semibold text-ink">toi</span>
                    </span>
                    <twig:Icon name="close" size="13" stroke="2.4" class="seat-leave"/>
                </button>
                <button type="button" class="done-button ml-auto" data-tour-card-target="done" data-action="tour-card#done">
                    <span class="done-button-check" aria-hidden="true"><twig:Icon name="check" size="14" stroke="2.6"/></span>
                    C’est fait
                    <span class="done-button-points">+20</span>
                </button>
            </div>
        </div>
    </article>

    {% if glide|default(false) %}
        <div class="sheet flex flex-col gap-2 p-4">
            <div class="flex items-baseline justify-between gap-2">
                <label for="tour-days" class="field-label">Le temps passe…</label>
                <output for="tour-days" class="shrink-0 text-[14px] font-semibold text-clay-dark" data-tour-card-target="days"></output>
            </div>
            <input type="range" id="tour-days" min="0" max="4" step="0.5" value="{{ age }}" class="h-8 w-full cursor-pointer" data-tour-card-target="slider" data-action="input->tour-card#age">
            <ol class="-mt-1.5 flex justify-between px-1 text-[11px] font-semibold text-dust tabular-nums" aria-hidden="true">
                {% for day in 0..4 %}<li class="w-3 text-center">{{ day }}</li>{% endfor %}
            </ol>
        </div>
    {% endif %}

    <p class="animate-pop flex items-start gap-2.5 rounded-[16px] bg-ok-soft px-3.5 py-3 text-[14px] leading-snug font-medium text-ok-ink" role="status" data-tour-card-target="message" hidden>
        <twig:Icon name="check" size="17" stroke="2.4" class="mt-px shrink-0"/>
        <span>{{ glide|default(false) ? 'Faite : elle repart à zéro, fraîche comme au premier jour.' : 'Bravo ! Pour de vrai, ces 20 points seraient à toi, et la Casa te dirait merci.' }}</span>
    </p>
</div>
