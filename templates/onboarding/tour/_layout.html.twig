{% extends 'base.html.twig' %}
{#
    A step of the tour (TourController): where we are, the Casa who speaks, what there is to see,
    then "Retour" and "Suivant" at the bottom. Read again from the profile (replay), it can be left
    at any time and ends on the profile.
#}
{% block title %}{{ block('heading') }} · Companero{% endblock %}
{% block main_class %}pb-32{% endblock %}

{% block body %}
    {% set steps = replay ? 4 : 6 %}
    <header class="page-head">
        <ol class="flex flex-1 items-center gap-1.5" aria-label="Étape {{ index + 1 }} sur {{ steps }}">
            {% for i in 0..(steps - 1) %}
                <li class="h-1.5 flex-1 rounded-full transition-colors {{ i <= index ? 'bg-clay' : 'bg-track' }}"{% if i == index %} aria-current="step"{% endif %}></li>
            {% endfor %}
        </ol>
        {% if replay %}
            <a href="{{ path('profile_show') }}" aria-label="Fermer" class="head-button"><twig:Icon name="close" size="19" stroke="2"/></a>
        {% endif %}
    </header>

    {% block casa %}
        <div class="flex items-end gap-2.5">
            <twig:CasaMini :size="62" :happy="true" class="shrink-0"/>
            <p class="bubble animate-pop mb-7">{% block speech %}{% endblock %}</p>
        </div>
    {% endblock %}

    <h1 class="page-title">{% block heading %}{% endblock %}</h1>

    {% block content %}{% endblock %}

    <nav class="tour-bar" aria-label="Étapes">
        <div class="mx-auto flex h-[76px] max-w-md items-center justify-between gap-3 px-5">
            {% if previous %}
                <a href="{{ previous }}" class="btn-link"><twig:Icon name="chevron-left" size="18" stroke="2"/>Retour</a>
            {% else %}
                <span></span>
            {% endif %}
            {% block next %}
                <a href="{{ next }}" class="btn-primary h-[52px] px-6 text-[16px]" data-haptic="tick">{{ replay and next == path('profile_show') ? 'Terminer' : 'Suivant' }}<twig:Icon name="chevron-right" size="19" stroke="2.4"/></a>
            {% endblock %}
        </div>
    </nav>
{% endblock %}
