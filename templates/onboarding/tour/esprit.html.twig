{% extends 'onboarding/tour/_layout.html.twig' %}

{% block casa %}
    <twig:Casa :mood="enum('App\\Enum\\CasaMood').Radiant" :speech="'Salut ' ~ app.user.name ~ ' ! Moi, c’est la Casa.'" class="min-h-[230px]"/>
{% endblock %}

{% block heading %}{{ replay ? 'Comment ça marche' : 'Bienvenue dans ' ~ household.name }}{% endblock %}

{% block content %}
    <p class="-mt-1 text-[15.5px] leading-relaxed text-ink-soft">
        Companero, c’est l’outil de la coloc pour l’intendance de la maison : le ménage, le linge, les poubelles,
        le jardin, les animaux, les petites réparations, les courses qui manquent…
    </p>

    <ul class="list-sheet">
        {% for item in [
            {icon: 'list', tile: 'tile-sun', title: 'Voir ce qui attend', text: 'Toutes les tâches de la maison, et depuis quand elles n’ont pas été faites.'},
            {icon: 'calendar', tile: 'tile-sky', title: 'S’organiser ensemble', text: 'Qui s’en occupe, le jour de ménage, un rappel au bon moment.'},
            {icon: 'star', tile: 'tile-blush', title: 'Se motiver', text: 'Des points, des objectifs, et une Casa qui rayonne quand on prend soin d’elle.'},
        ] %}
            <li class="flex items-start gap-3 py-3.5 animate-rise" style="animation-delay: {{ loop.index0 * 120 }}ms">
                <span class="tile {{ item.tile }}"><twig:Icon :name="item.icon" size="20" stroke="1.9"/></span>
                <span class="flex flex-col gap-0.5">
                    <span class="row-title">{{ item.title }}</span>
                    <span class="text-[13.5px] leading-snug text-ink-soft">{{ item.text }}</span>
                </span>
            </li>
        {% endfor %}
    </ul>

    {% if not replay %}<p class="text-center text-[13px] text-muted">Deux minutes de visite, et c’est parti.</p>{% endif %}
{% endblock %}
