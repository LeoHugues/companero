{% extends 'base.html.twig' %}

{% block title %}Je suis {{ member.name }} · Companero{% endblock %}
{% block main_class %}pb-10{% endblock %}

{% block body %}
    <twig:Casa :mood="enum('App\\Enum\\CasaMood').Radiant" :speech="'Salut ' ~ member.name ~ ' ! Ta place était gardée.'" class="mt-4"/>

    <header class="flex items-center gap-3">
        <twig:Avatar :member="member" size="48"/>
        <div class="flex flex-col">
            <h1 class="text-[26px] leading-tight">Je suis {{ member.name }}</h1>
            <p class="meta">dans {{ household.name }}</p>
        </div>
    </header>
    <p class="meta -mt-1">Choisis ton pseudo et ton mot de passe : ce sont eux qui te connecteront.</p>

    {{ form_start(form, {attr: {class: 'flex flex-col gap-5'}}) }}
        {{ form_row(form.username) }}
        {{ form_row(form.plainPassword) }}
        <button type="submit" class="btn-primary h-[52px] w-full text-[17px]">C’est moi</button>
    {{ form_end(form) }}

    <a href="{{ path('onboarding_join', {token: household.inviteToken}) }}" class="btn-link self-center">Ce n’est pas moi</a>
{% endblock %}
