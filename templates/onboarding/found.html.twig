{% extends 'base.html.twig' %}

{% block title %}Créer la coloc · Companero{% endblock %}
{% block main_class %}pb-10{% endblock %}

{% block body %}
    {{ include('_casa_hero.html.twig', {mood: enum('App\\Enum\\CasaMood').Radiant, speech: 'Salut ! Moi c’est la Casa. On s’organise ensemble ?'}) }}

    {{ form_start(form, {attr: {class: 'hero-sheet'}}) }}
        <div>
            <h1 class="home-title">Créer la coloc</h1>
            <p class="mt-1 text-[13.5px] text-muted">Tu pourras inviter tes colocs juste après.</p>
        </div>
        {{ form_row(form.householdName) }}
        {{ form_row(form.cleaningDay, {help: 'Un rendez-vous, pas une obligation : ce qui est fait ce jour-là rapporte un petit bonus.'}) }}
        <p class="eyebrow -mb-2 border-t border-line/70 pt-4">Et toi</p>
        {{ form_row(form.name) }}
        {{ form_row(form.username) }}
        {{ form_row(form.plainPassword) }}
        <button type="submit" class="btn-primary h-[52px] w-full text-[16px]">C’est parti</button>
    {{ form_end(form) }}

    <p class="text-center text-[13.5px] text-muted">Déjà inscrit ? <a href="{{ path('app_login') }}" class="font-semibold">Se connecter</a></p>
{% endblock %}
