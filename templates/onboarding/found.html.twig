{% extends 'base.html.twig' %}

{% block title %}Créer la coloc · Companero{% endblock %}
{% block main_class %}pb-10{% endblock %}

{% block body %}
    <twig:Casa :mood="enum('App\\Enum\\CasaMood').Radiant" speech="Salut ! Moi c’est la Casa. On s’organise ensemble ?" class="mt-4"/>

    <h1 class="text-[26px]">Créer la coloc</h1>
    <p class="meta -mt-2">Tu pourras inviter tes colocs juste après.</p>

    {{ form_start(form, {attr: {class: 'flex flex-col gap-5'}}) }}
        {{ form_row(form.householdName) }}
        {{ form_row(form.cleaningDay, {help: 'Un rendez-vous, pas une obligation : ce qui est fait ce jour-là rapporte un petit bonus.'}) }}
        {{ form_row(form.name) }}
        {{ form_row(form.username) }}
        {{ form_row(form.plainPassword) }}
        <button type="submit" class="btn-primary h-[52px] w-full text-[17px]">C’est parti</button>
    {{ form_end(form) }}

    <p class="meta text-center">Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a></p>
{% endblock %}
