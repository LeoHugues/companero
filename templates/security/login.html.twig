{% extends 'base.html.twig' %}

{% block title %}Connexion · Companero{% endblock %}
{% block main_class %}pb-10{% endblock %}

{% block body %}
    <twig:Casa :mood="enum('App\\Enum\\CasaMood').Okay" speech="Te revoilà ! Connecte-toi pour retrouver la coloc." class="mt-6"/>

    <form method="post" class="flex flex-col gap-4">
        <h1 class="text-[26px]">Connexion</h1>

        {% if error %}
            <p class="text-sm font-bold text-clay-dark" role="alert">Pseudo ou mot de passe incorrect.</p>
        {% endif %}

        <div class="flex flex-col gap-2">
            <label for="pseudo" class="field-label">Pseudo</label>
            <input type="text" id="pseudo" name="pseudo" value="{{ last_username }}" class="input" autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" required autofocus>
        </div>
        <div class="flex flex-col gap-2">
            <label for="password" class="field-label">Mot de passe</label>
            <input type="password" id="password" name="password" class="input" autocomplete="current-password" required>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="btn-primary h-[52px] w-full text-[17px]">Se connecter</button>
    </form>

    <p class="meta text-center">Pas encore de coloc ? <a href="{{ path('onboarding_found') }}">Créer la vôtre</a></p>
{% endblock %}
