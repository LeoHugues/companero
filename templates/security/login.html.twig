{% extends 'base.html.twig' %}

{% block title %}Connexion · Companero{% endblock %}
{% block main_class %}pb-10{% endblock %}

{% block body %}
    {{ include('_casa_hero.html.twig', {mood: enum('App\\Enum\\CasaMood').Okay, speech: 'Te revoilà ! Connecte-toi pour retrouver la coloc.'}) }}

    <form method="post" class="hero-sheet">
        <h1 class="home-title">Connexion</h1>

        {% if error %}
            <p class="-mt-2 flex items-center gap-2 rounded-xl bg-danger-soft px-3 py-2 text-[13.5px] font-medium text-danger-ink" role="alert"><twig:Icon name="alarm" size="16" stroke="2" class="shrink-0"/>Pseudo ou mot de passe incorrect.</p>
        {% endif %}

        <div class="flex flex-col gap-2">
            <label for="pseudo" class="field-label">Pseudo</label>
            <input type="text" id="pseudo" name="pseudo" value="{{ last_username }}" class="input" autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" required autofocus>
        </div>
        <div class="flex flex-col gap-2">
            <label for="password" class="field-label">Mot de passe</label>
            <input type="password" id="password" name="password" class="input" autocomplete="current-password" required>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button type="submit" class="btn-primary h-[52px] w-full text-[16px]">Se connecter</button>
    </form>

    <p class="text-center text-[13.5px] text-muted">Pas encore de coloc ? <a href="{{ path('onboarding_found') }}" class="font-semibold">Créer la vôtre</a></p>
{% endblock %}
