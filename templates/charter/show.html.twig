{% extends 'base.html.twig' %}

{% block title %}La charte · Companero{% endblock %}

{% block body %}
    <header class="page-head items-end">
        <div class="min-w-0">
            <p class="eyebrow">{{ household.name }}</p>
            <h1 class="page-title mt-1">La charte de la coloc</h1>
        </div>
        <a href="{{ path('household_edit') }}" aria-label="Retour aux réglages de la coloc" class="head-button"><twig:Icon name="close" size="19" stroke="2"/></a>
    </header>
    <p class="page-lede -mt-2">Rien à voir avec l’appli : c’est juste comme ça qu’on vit bien ensemble. Tout le monde peut l’écrire, la réordonner avec les flèches, ou en rediscuter.</p>

    {{ include('charter/_rules.html.twig', {household: household, editable: true}) }}

    <section class="sheet flex flex-col gap-3 p-4" aria-labelledby="agreed-title">
        <h2 id="agreed-title" class="eyebrow">Ça leur va</h2>
        <ul class="flex flex-wrap gap-2">
            {% for member in household.members %}
                <li class="flex items-center gap-1.5 rounded-full py-1 pr-3 pl-1 text-[13.5px] font-semibold {{ member.hasAcceptedCharter ? 'bg-ok-soft text-ok-ink' : 'bg-track/60 text-muted' }}">
                    <twig:Avatar :member="member" size="24"/>{{ member.name }}
                    {% if member.hasAcceptedCharter %}<twig:Icon name="check" size="14" stroke="2.6"/>{% else %}<span class="text-[12px] font-medium">pas encore</span>{% endif %}
                </li>
            {% endfor %}
        </ul>
        {% if not app.user.hasAcceptedCharter %}
            <form method="post" action="{{ path('charter_accept') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                <button type="submit" class="btn-primary w-full" data-haptic="success"><twig:Icon name="check" size="18" stroke="2.4"/>Ça me va</button>
            </form>
        {% endif %}
    </section>

    <section class="flex flex-col gap-2" aria-labelledby="new-rule-title">
        <h2 id="new-rule-title" class="group-label">Ajouter une règle</h2>
        {{ form_start(form, {attr: {class: 'sheet flex flex-col gap-4 p-4'}}) }}
            {{ form_row(form.text) }}
            {# The reason is a bonus: folded until someone wants to give one. #}
            <details class="group flex flex-col gap-2"{{ form.why.vars.value or form.why.vars.errors is not empty ? ' open' }}>
                <summary class="flex w-fit cursor-pointer list-none items-center gap-1.5 text-[13.5px] font-semibold text-clay-dark"><twig:Icon name="plus" size="15" stroke="2.4" class="transition group-open:rotate-45"/> Expliquer pourquoi</summary>
                <div class="mt-2">{{ form_row(form.why, {label: 'Pourquoi ? (facultatif)'}) }}</div>
            </details>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-line/70 pt-3.5">
                <button type="submit" class="btn-soft"><twig:Icon name="plus" size="16" stroke="2.4"/>Ajouter la règle</button>
                <p class="text-[12.5px] leading-snug text-muted">Chacun sera invité à relire la charte.</p>
            </div>
        {{ form_end(form) }}
    </section>
{% endblock %}

{% block nav %}<twig:BottomNav active="home"/>{% endblock %}
