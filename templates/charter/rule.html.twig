{% extends 'base.html.twig' %}

{% block title %}Une règle de la charte · Companero{% endblock %}

{% block body %}
    <header class="page-head items-end">
        <div class="min-w-0">
            <p class="eyebrow">La charte · règle n° {{ rule.position + 1 }}</p>
            <h1 class="page-title mt-1">Modifier la règle</h1>
        </div>
        <a href="{{ path('charter_show') }}" aria-label="Retour à la charte" class="head-button"><twig:Icon name="close" size="19" stroke="2"/></a>
    </header>

    {{ form_start(form, {attr: {class: 'flex flex-col gap-3'}}) }}
        <div class="form-sheet">
            {{ form_row(form.text) }}
            {{ form_row(form.why) }}
        </div>
        <p class="px-1 text-[12.5px] leading-snug text-muted">Chacun sera invité à relire la charte.</p>
        <button type="submit" class="btn-primary w-full" data-haptic="success">Enregistrer</button>
    {{ form_end(form) }}

    <form method="post" action="{{ path('charter_rule_delete', {id: rule.id}) }}" class="flex justify-center" data-turbo-confirm="Retirer cette règle de la charte ?">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
        <button type="submit" class="btn-link hover:text-danger-ink"><twig:Icon name="trash" size="17" stroke="1.9"/>Retirer la règle</button>
    </form>
{% endblock %}

{% block nav %}<twig:BottomNav active="profile"/>{% endblock %}
