{% extends 'base.html.twig' %}

{% block title %}Ce qui a été fait · Companero{% endblock %}

{% block body %}
    {% set mine = history.member is not null %}
    {% set who = mine ? 'moi' : 'coloc' %}

    <header class="flex flex-col gap-0.5">
        <h1 class="text-[26px]">{{ mine ? 'Ce que j’ai fait' : 'Ce que la coloc a fait' }}</h1>
        <p class="text-sm text-muted">Ces {{ history.days }} derniers jours. Une date ou des points à corriger ? Touche la tâche.</p>
    </header>

    <nav class="flex flex-wrap items-center justify-between gap-2" aria-label="Choisir la vue">
        <div class="flex gap-1.5" role="group" aria-label="Qui">
            {% for key, label in {moi: 'Moi', coloc: 'La coloc'} %}
                <a href="{{ path('history', {qui: key, jours: history.days}) }}" class="chip {{ key == who ? 'chip-active' : '' }}"{% if key == who %} aria-current="page"{% endif %}>{{ label }}</a>
            {% endfor %}
        </div>
        <div class="flex gap-1.5" role="group" aria-label="Période">
            {% for days in periods %}
                <a href="{{ path('history', {qui: who, jours: days}) }}" class="chip {{ days == history.days ? 'chip-active' : '' }}"{% if days == history.days %} aria-current="page"{% endif %}>{{ days }} jours</a>
            {% endfor %}
        </div>
    </nav>

    <section class="card flex flex-col gap-3 p-4" aria-label="En résumé">
        <div class="grid grid-cols-2 gap-3">
            <p class="flex flex-col"><span class="text-[28px] leading-none font-extrabold">{{ history.completions|length }}</span><span class="meta font-semibold">tâche{{ history.completions|length > 1 ? 's' }}</span></p>
            <p class="flex flex-col"><span class="text-[28px] leading-none font-extrabold text-clay-dark">{{ history.totalPoints }}</span><span class="meta font-semibold">points</span></p>
        </div>
        <ol class="flex h-20 items-end {{ history.days > 7 ? 'gap-[2px]' : 'gap-2' }}" aria-label="Points par jour">
            {% for day in history.daily %}
                {% set label = weekday_name(day.day|date('N')) ~ ' ' ~ day.day|date('j') ~ ' : ' ~ day.points ~ ' pts' %}
                <li class="flex h-full flex-1 flex-col items-center justify-end gap-1" title="{{ label }}" aria-label="{{ label }}">
                    <span class="w-full rounded-t-md {{ day.points ? 'bg-clay' : 'bg-track' }}" style="height: {{ max(3, (56 * day.points / history.bestDayPoints)|round) }}px"></span>
                    {% if history.days <= 7 %}<span class="text-[11px] font-bold text-muted">{{ weekday_name(day.day|date('N'))|first|upper }}</span>{% endif %}
                </li>
            {% endfor %}
        </ol>
        {% if history.byZone is not empty %}
            <p class="text-xs text-muted">Surtout : {{ history.byZone|map(z => z.name ~ ' (' ~ z.count ~ ')')|join(', ') }}</p>
        {% endif %}
    </section>

    {% if not mine %}
        <section class="flex flex-col gap-2" aria-labelledby="share-title">
            <h2 id="share-title" class="section-title">Chacun</h2>
            <ul class="card divide-y divide-line px-3.5 py-1">
                {% for share in history.byMember %}
                    <li class="flex items-center gap-2.5 py-2.5">
                        <twig:Avatar :member="share.member" size="28"/>
                        <span class="flex-1 text-[15px] font-bold">{{ share.member.name }}</span>
                        <span class="text-xs text-muted">{{ share.count }} tâche{{ share.count > 1 ? 's' }}</span>
                        <span class="w-16 text-right text-sm font-extrabold">{{ share.points }} pts</span>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <section class="flex flex-col gap-2" aria-labelledby="days-title">
        <h2 id="days-title" class="section-title">Jour par jour</h2>
        {% for day in history.byDay %}
            <article class="flex flex-col gap-1">
                <h3 class="flex items-baseline justify-between px-1 text-sm">
                    <span class="font-extrabold">{{ day.day|format_date(pattern: 'EEEE d MMMM', locale: 'fr')|capitalize }}</span>
                    <span class="font-bold text-muted">{{ day.points }} pts</span>
                </h3>
                <ul class="card divide-y divide-line px-3.5 py-1">
                    {% for completion in day.completions %}
                        <li>
                            <a href="{{ path('completion_edit', {id: completion.id}) }}" class="flex items-center gap-2.5 py-2 text-ink no-underline hover:text-ink" aria-label="Corriger : {{ completion.task.title }}">
                                {% if not mine %}<twig:Avatar :member="completion.member" size="26"/>{% endif %}
                                <span class="flex min-w-0 flex-1 flex-col">
                                    <span class="truncate text-sm font-bold">{{ completion.task.title }}</span>
                                    <span class="text-xs text-muted">{{ not mine ? completion.member.name ~ ' · ' }}{{ completion.completedAt|date('G\\hi') }} · {{ completion.task.zone.name ?? completion.task.pet.name ?? (completion.task.category.value == 'pets' ? 'Les animaux' : 'Toute la coloc') }}</span>
                                </span>
                                <span class="text-sm font-extrabold whitespace-nowrap text-clay-dark">+{{ history.pointsOf(completion) }}</span>
                                <twig:Icon name="edit" size="15" class="shrink-0 text-muted"/>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </article>
        {% else %}
            <p class="card p-4 text-sm text-muted">{{ mine ? 'Rien de noté ces derniers jours. La Casa t’attend !' : 'Rien de noté ces derniers jours.' }}</p>
        {% endfor %}
    </section>
{% endblock %}

{% block nav %}<twig:BottomNav :active="history.member ? 'profile' : 'review'"/>{% endblock %}
