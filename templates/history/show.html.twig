{% extends 'base.html.twig' %}

{% block title %}Ce qui a été fait · Companero{% endblock %}

{% block body %}
    {% set mine = history.member is not null %}
    {% set who = mine ? 'moi' : 'coloc' %}

    <header class="page-head items-end">
        <div class="min-w-0">
            <p class="eyebrow">Ces {{ history.days }} derniers jours</p>
            <h1 class="page-title mt-1">{{ mine ? 'Ce que j’ai fait' : 'Ce que la coloc a fait' }}</h1>
        </div>
        <a href="{{ ux_is_native() ? '/recede_historical_location' : path(mine ? 'profile_show' : 'review_show') }}" aria-label="Retour" class="head-button"><twig:Icon name="arrow-left" size="20" stroke="2"/></a>
    </header>
    <p class="page-lede -mt-2">Une date ou des points à corriger ? Touche la tâche.</p>

    <nav class="grid grid-cols-2 gap-2.5" aria-label="Choisir la vue">
        <div class="segmented" role="group" aria-label="Qui">
            {% for key, label in {moi: 'Moi', coloc: 'La coloc'} %}
                <a href="{{ path('history', {qui: key, jours: history.days}) }}"{% if key == who %} aria-current="page"{% endif %} data-haptic="tick">{{ label }}</a>
            {% endfor %}
        </div>
        <div class="segmented" role="group" aria-label="Période">
            {% for days in periods %}
                <a href="{{ path('history', {qui: who, jours: days}) }}"{% if days == history.days %} aria-current="page"{% endif %} data-haptic="tick">{{ days }} jours</a>
            {% endfor %}
        </div>
    </nav>

    <section class="sheet flex flex-col gap-4 p-4" aria-label="En résumé">
        <div class="grid grid-cols-2 gap-3">
            <p class="flex flex-col gap-1"><span class="stat-value"><twig:Count :value="history.completions|length"/></span><span class="stat-label">tâche{{ history.completions|length > 1 ? 's' }} faite{{ history.completions|length > 1 ? 's' }}</span></p>
            <p class="flex flex-col gap-1"><span class="stat-value text-clay-dark"><twig:Count :value="history.totalPoints"/></span><span class="stat-label">points</span></p>
        </div>
        <ol class="flex h-[76px] items-end {{ history.days > 7 ? 'gap-[3px]' : 'gap-2' }}" aria-label="Points par jour">
            {% for day in history.daily %}
                {% set label = weekday_name(day.day|date('N')) ~ ' ' ~ day.day|date('j') ~ ' : ' ~ day.points ~ ' pts' %}
                <li class="flex h-full flex-1 flex-col items-center justify-end gap-1.5" title="{{ label }}" aria-label="{{ label }}">
                    <span class="week-bar {{ day.points ? 'is-cleaning' : 'is-empty' }} {{ history.days > 7 ? 'rounded-[3px]' }}" style="height: {{ max(4, (52 * day.points / history.bestDayPoints)|round) }}px; animation-delay: {{ min(loop.index0, 30) * 20 }}ms"></span>
                    {% if history.days <= 7 %}<span class="text-[11px] font-semibold text-dust">{{ weekday_name(day.day|date('N'))|first|upper }}</span>{% endif %}
                </li>
            {% endfor %}
        </ol>
        {% if history.byZone is not empty %}
            <p class="border-t border-line/70 pt-3 text-[12.5px] leading-snug text-muted">Surtout : <span class="text-ink-soft">{{ history.byZone|map(z => z.name ~ ' (' ~ z.count ~ ')')|join(', ') }}</span></p>
        {% endif %}
    </section>

    {% if not mine %}
        <section class="flex flex-col gap-2" aria-labelledby="share-title">
            <h2 id="share-title" class="group-label">Chacun</h2>
            <ul class="list-sheet">
                {% for share in history.byMember %}
                    <li class="list-row min-h-12">
                        <twig:Avatar :member="share.member" size="30"/>
                        <span class="row-title flex-1">{{ share.member.name }}</span>
                        <span class="text-[12.5px] text-muted">{{ share.count }} tâche{{ share.count > 1 ? 's' }}</span>
                        <span class="w-16 text-right text-[14px] font-semibold tabular-nums">{{ share.points }} <span class="text-[12px] font-medium text-muted">pts</span></span>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <section class="flex flex-col gap-4" aria-labelledby="days-title">
        <h2 id="days-title" class="sr-only">Jour par jour</h2>
        {% for day in history.byDay %}
            <article class="flex flex-col gap-2">
                <h3 class="flex items-baseline justify-between gap-2 px-1">
                    <span class="eyebrow">{{ day.day|format_date(pattern: 'EEEE d MMMM', locale: 'fr') }}</span>
                    <span class="text-[12.5px] font-medium text-muted tabular-nums">{{ day.points }} pts</span>
                </h3>
                <ul class="list-sheet">
                    {% for completion in day.completions %}
                        <li>
                            <a href="{{ path('completion_edit', {id: completion.id}) }}" class="list-row" aria-label="Corriger : {{ completion.task.title }}">
                                {% if not mine %}<twig:Avatar :member="completion.member" size="30"/>{% endif %}
                                <span class="flex min-w-0 flex-1 flex-col">
                                    <span class="row-title truncate">{{ completion.task.title }}</span>
                                    <span class="row-meta">{{ not mine ? completion.member.name ~ ' · ' }}{{ completion.completedAt|date('G\\hi') }} · {{ task_place(completion.task) }}</span>
                                </span>
                                <span class="row-points">+{{ history.pointsOf(completion) }}</span>
                                <twig:Icon name="edit" size="15" class="row-chevron"/>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </article>
        {% else %}
            <p class="sheet-empty">{{ mine ? 'Rien de noté ces derniers jours. La Casa t’attend !' : 'Rien de noté ces derniers jours.' }}</p>
        {% endfor %}
    </section>
{% endblock %}

{% block nav %}<twig:BottomNav :active="history.member ? 'profile' : 'review'"/>{% endblock %}
