{#
    On the home page, under the state of the house: what is missing at a glance, the urgent things first in coral
    (and a coral dot on the cart), and "+" to say that something else is. The rest of the strip opens the list.
#}
<section class="missing-strip" aria-labelledby="missing-title">
    <a href="{{ path('shopping_index') }}" class="missing-strip-link">
        <span class="tile tile-lilac relative" aria-hidden="true">
            <twig:Icon name="cart" size="21" stroke="1.8"/>
            {% if missing|filter(item => item.urgent) is not empty %}<span class="tile-dot"></span>{% endif %}
        </span>
        <span class="flex min-w-0 flex-1 flex-col gap-0.5">
            <span class="flex items-baseline gap-1.5">
                <span id="missing-title" class="eyebrow">Il manque</span>
                {% if missing is not empty %}<span class="text-[11px] font-semibold text-dust">{{ missing|length }}</span>{% endif %}
            </span>
            {% if missing is empty %}
                <span class="missing-strip-names font-medium text-muted">Rien pour l’instant</span>
            {% else %}
                <span class="missing-strip-names">
                    {%- for item in missing -%}
                        {% if not loop.first %}<span class="text-dust"> · </span>{% endif %}<span class="{{ item.urgent ? 'text-danger-ink' }}">{{ item.name }}</span>
                    {%- endfor -%}
                </span>
            {% endif %}
        </span>
    </a>
    <a href="{{ path('shopping_index', {ajouter: 1}) }}" class="missing-strip-add" aria-label="Il manque quelque chose : le noter" title="Il manque quelque chose" data-haptic="press"><twig:Icon name="plus" size="21" stroke="2.4"/></a>
</section>
