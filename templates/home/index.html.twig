{% extends 'base.html.twig' %}

{% block body %}
    <header class="flex items-center justify-between gap-3">
        <div class="flex min-w-0 flex-col">
            <p class="truncate text-[17px] leading-tight font-extrabold">{{ weekday_name(now|date('N'))|capitalize }} {{ now|format_date(pattern: 'd MMMM', locale: 'fr') }}</p>
            {% if is_cleaning_day %}
                <p class="flex items-center gap-1 text-[13px] font-bold text-clay-dark"><span class="size-2 rounded-full bg-clay"></span>C’est le jour de ménage</p>
            {% else %}
                <p class="truncate text-[13px] font-semibold text-muted">Ménage {{ weekday_name(app.user.household.cleaningDay) }}</p>
            {% endif %}
        </div>
        {# One segmented pill: am I home, my streak, my level. #}
        <div class="flex h-9 shrink-0 items-stretch overflow-hidden rounded-full border-[1.5px] border-ink bg-surface text-[13px] font-extrabold whitespace-nowrap">
            <form method="post" action="{{ path('presence_toggle') }}" class="flex">
                <input type="hidden" name="_back" value="home">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                <button type="submit" aria-pressed="{{ app.user.atHome ? 'true' : 'false' }}" aria-label="{{ app.user.atHome ? 'Je suis à la maison : signaler que je pars' : 'Je ne suis pas là : signaler mon retour' }}"
                        class="flex cursor-pointer items-center gap-1 pr-2.5 pl-2 transition active:scale-95 {{ app.user.atHome ? 'bg-ink text-cream' : 'text-muted' }}">
                    <twig:Icon :name="app.user.atHome ? 'home' : 'door'" size="16" stroke="2.4"/>{{ app.user.atHome ? 'Là' : 'Pas là' }}
                </button>
            </form>
            <a href="{{ path('profile_show') }}" class="flex items-center gap-2.5 px-2.5 text-ink no-underline hover:bg-track hover:text-ink" aria-label="Niveau {{ level.number }}{{ app.user.streak ? ', série de ' ~ app.user.streak ~ ' semaine' ~ (app.user.streak > 1 ? 's') }}">
                {% if app.user.streak > 0 %}<span class="flex items-center gap-0.5 text-clay-dark"><twig:Icon name="flame" size="15" stroke="2.4"/>{{ app.user.streak }}</span>{% endif %}
                <span>Niv. {{ level.number }}</span>
            </a>
        </div>
    </header>

    <twig:BoostBanner/>

    <twig:Casa
        :mood="mood"
        :cleanliness="cleanliness"
        :reacting="just_done is not same as(false)"
        :speech="just_done ? 'Merci ' ~ app.user.name ~ ' ! +' ~ just_done.points ~ ' pts pour toi' ~ (just_done.xp|default(0) ? ' (et +' ~ just_done.xp ~ ' XP)') ~ '.' : null"
        class="min-h-[262px]"
    />

    <section class="flex flex-col gap-1.5" aria-label="Propreté de la Casa">
        <div class="flex items-center justify-between gap-2">
            <h1 class="text-lg">La Casa</h1>
            <p class="ml-auto text-sm font-bold">Propreté <twig:Count :value="cleanliness" key="casa"/> %</p>
            {# A shortcut to the plan of the house: a little floor plan of its own. #}
            <a href="{{ path('plan_show') }}" class="plan-shortcut" aria-label="Le plan de la maison" title="Le plan de la maison">
                <svg viewBox="0 0 28 28" width="26" height="26" aria-hidden="true">
                    <rect x="2" y="2" width="24" height="24" rx="4" fill="#FFFCF6" stroke="#2E1E14" stroke-width="2"/>
                    <rect x="4.5" y="4.5" width="10" height="9" rx="1.5" fill="#F6C453"/>
                    <rect x="16" y="4.5" width="7.5" height="13" rx="1.5" fill="#F2A27A"/>
                    <rect x="4.5" y="15" width="10" height="8.5" rx="1.5" fill="#D9B48C"/>
                    <rect x="16" y="19" width="7.5" height="4.5" rx="1.5" fill="#E8692C"/>
                </svg>
                <span>Plan</span>
            </a>
            <a href="{{ path('household_edit') }}" aria-label="Réglages de la coloc" title="Réglages de la coloc" class="-mr-2 flex size-9 items-center justify-center rounded-full text-muted hover:bg-track hover:text-ink"><twig:Icon name="settings" size="19"/></a>
        </div>
        <twig:ProgressBar :value="cleanliness" label="Propreté de la Casa" key="casa"/>
    </section>

    {% if quick is not empty %}
        <section class="flex flex-col gap-2" aria-labelledby="quick-title">
            <h2 id="quick-title" class="flex items-center gap-1.5 text-[15px]"><twig:Icon name="bolt" size="18"/> En un geste</h2>
            <twig:QuickTasks :views="quick"/>
        </section>
    {% endif %}

    {% if dormant is not empty %}
        <section class="flex flex-col gap-2" aria-labelledby="raise-title">
            <h2 id="raise-title" class="flex items-center gap-1.5 text-[15px]"><twig:Icon name="siren" size="18"/> Ça arrive ?</h2>
            <ul class="flex flex-wrap gap-2">
                {% for view in dormant %}
                    <li><twig:RaiseButton :task="view.task" compact/></li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    <twig:TeamBar :team="team" :household="app.user.household" :detailed="false"/>

    {% if mine is not empty %}
        <section class="flex flex-col gap-2.5" aria-labelledby="mine-title">
            <h2 id="mine-title" class="pt-0.5 text-xl">On compte sur toi</h2>
            {% for view in mine %}
                <twig:TaskCard :view="view" :member="app.user"/>
            {% endfor %}
        </section>
    {% endif %}

    <section class="flex flex-col gap-2.5" aria-labelledby="todo-title">
        <h2 id="todo-title" class="pt-0.5 text-xl">Prendre soin de la Casa</h2>
        {% for view in pressing %}
            <twig:TaskCard :view="view" :member="app.user"/>
        {% else %}
            <p class="card p-4 text-[15px]">Rien d’urgent : la Casa est contente. Profites-en !</p>
        {% endfor %}
    </section>

    {% if upcoming is not empty %}
        <section class="flex flex-col gap-2.5" aria-labelledby="soon-title">
            <h2 id="soon-title" class="section-title">Bientôt</h2>
            {% for view in upcoming %}
                <twig:TaskCard :view="view" :member="app.user"/>
            {% endfor %}
        </section>
    {% endif %}

    {% if later is not empty %}
        <section class="flex flex-col gap-2.5" aria-labelledby="later-title">
            <h2 id="later-title" class="section-title">Pas pressé</h2>
            {% for view in later %}
                <twig:TaskCard :view="view" :member="app.user"/>
            {% endfor %}
        </section>
    {% endif %}

    <p class="flex items-center justify-center gap-5">
        <a href="{{ path('task_index') }}" class="btn-link">Les modèles</a>
    </p>
{% endblock %}

{% block nav %}<twig:BottomNav active="home"/>{% endblock %}
