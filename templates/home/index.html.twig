{% extends 'base.html.twig' %}

{% block body %}
    {% set quest = quests|first %}
    {#
        The top of the page: the Casa planted across the whole width, the date and "am I home" on her sky.
        Her bubble asks for a hand with a free task; the card of the house's state straddles her ground:
        her cleanliness, and that task, which "Une autre ?" swaps (quest_controller.js).
    #}
    <div class="contents" data-controller="quest">
        <section class="home-hero" aria-labelledby="casa-title">
            <h1 id="casa-title" class="sr-only">La Casa</h1>
            <header class="home-hero-top">
                <div class="flex min-w-0 flex-col gap-0.5">
                    <p class="truncate text-base leading-tight font-semibold">{{ weekday_name(now|date('N'))|capitalize }} {{ now|format_date(pattern: 'd MMMM', locale: 'fr') }}</p>
                    <p class="flex items-center gap-1.5 text-[13px] font-medium text-clay-dark"><span class="size-1.5 rounded-full bg-clay"></span>{{ is_cleaning_day ? 'C’est le jour de ménage' : 'Ménage ' ~ weekday_name(app.user.household.cleaningDay) }}</p>
                </div>
                <div class="flex shrink-0 items-center gap-2">
                    <form method="post" action="{{ path('presence_toggle') }}">
                        <input type="hidden" name="_back" value="home">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                        <button type="submit" data-haptic="toggle" aria-pressed="{{ app.user.atHome ? 'true' : 'false' }}" aria-label="{{ app.user.atHome ? 'Je suis à la maison : signaler que je pars' : 'Je ne suis pas là : signaler mon retour' }}"
                                class="home-presence {{ app.user.atHome ? 'is-home' }}">
                            <twig:Icon :name="app.user.atHome ? 'home' : 'door'" size="16" stroke="1.8"/>{{ app.user.atHome ? 'Là' : 'Pas là' }}
                        </button>
                    </form>
                    <a href="{{ path('profile_show') }}" class="home-me" aria-label="Mon profil : niveau {{ level.number }}{{ app.user.streak ? ', série de ' ~ app.user.streak ~ ' semaine' ~ (app.user.streak > 1 ? 's') }}">
                        <svg viewBox="0 0 40 40" width="40" height="40" class="-rotate-90" aria-hidden="true">
                            <circle cx="20" cy="20" r="18" fill="none" stroke="var(--color-track)" stroke-width="2.5"/>
                            <circle cx="20" cy="20" r="18" fill="none" stroke="var(--color-sun)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="113.1" stroke-dashoffset="{{ (113.1 * (1 - level.progress / 100))|round(1) }}"/>
                        </svg>
                        <twig:Avatar :member="app.user" size="28" class="absolute inset-0 m-auto"/>
                        <span class="home-me-level">{{ level.number }}</span>
                    </a>
                </div>
            </header>

            <twig:Casa
                hero
                :mood="mood"
                :cleanliness="cleanliness"
                :reacting="just_done is not same as(false)"
                :speech="just_done ? 'Merci ' ~ app.user.name ~ ' ! +' ~ just_done.points ~ ' pts pour toi.' : (quest ? casa_quest_line(quest) : null)"
            />

            <a href="{{ path('plan_show') }}" class="home-plan" aria-label="Le plan de la maison"><twig:Icon name="plan" size="16" stroke="1.8"/>Plan</a>
        </section>

        {#
            The card of the house's state, with two faces and a small switch between them (state_switch_controller.js):
            the Casa's cleanliness and the task she asks for, by default; the goal of the house and what earned its points.
        #}
        <section class="casa-state sheet" aria-label="État de la maison" data-controller="state-switch" data-action="turbo:morph-element->state-switch#restore">
            <div class="state-switch" role="tablist" aria-label="Afficher">
                <button type="button" role="tab" id="state-tab-casa" aria-controls="state-casa" aria-selected="true" data-state-switch-target="tab" data-action="state-switch#show" data-state-switch-face-param="casa"><twig:Icon name="home" size="15" stroke="2.1"/>Propreté</button>
                <button type="button" role="tab" id="state-tab-team" aria-controls="state-team" aria-selected="false" data-state-switch-target="tab" data-action="state-switch#show" data-state-switch-face-param="team"><twig:Icon name="trophy" size="15" stroke="2.1"/>Objectif</button>
            </div>
            {# Both faces share one stage: its height glides from one to the other, and a sideways swipe turns it. #}
            <div class="state-faces" data-state-switch-target="stage" data-action="touchstart->state-switch#touchStart touchend->state-switch#touchEnd">
                <div class="state-face" id="state-casa" role="tabpanel" aria-labelledby="state-tab-casa" data-state-switch-target="panel" data-face="casa">
                    <div class="flex items-end justify-between gap-3">
                        <h2 class="min-w-0 text-xl leading-tight font-bold tracking-tight"><span class="sr-only">Propreté de la Casa : </span>{{ mood.title }}</h2>
                        <p class="shrink-0 text-[30px] leading-none font-bold tracking-tight"><twig:Count :value="cleanliness" key="casa"/><span class="text-base font-semibold text-muted"> %</span></p>
                    </div>
                    {% set next = mood.next %}
                    <div class="casa-gauge">
                        <twig:ProgressBar :value="cleanliness" :height="8" label="Propreté de la Casa" key="casa"/>
                        {% for step in [55, 80, 92] %}
                            <span class="casa-gauge-step {{ next and next[0] == step ? 'is-next' }}" style="left: {{ step }}%" aria-hidden="true"></span>
                        {% endfor %}
                    </div>
                    <p class="-mt-1 text-[12.5px] text-muted">
                        {% if next %}<span class="font-semibold text-clay-dark">+{{ next[0] - cleanliness }} %</span> et {{ next[1] }}{% else %}Elle rayonne : bravo la coloc.{% endif %}
                    </p>

                    {% for view in quests %}
                        <div class="quest" data-quest-target="quest" data-line="{{ casa_quest_line(view) }}" {{ not loop.first ? 'hidden' }}>
                            <twig:TaskVignette :task="view.task" class="vignette-small"/>
                            <div class="min-w-0 flex-1">
                                <p class="line-clamp-2 text-[14.5px] leading-tight font-semibold"><a href="{{ path('task_show', {id: view.task.id}) }}" class="text-ink no-underline hover:text-ink">{{ view.task.title }}</a></p>
                                <p class="mt-0.5 text-xs text-muted">+{{ view.task.currentPoints + task_boost(view) }} pts · {{ task_status_label(view.task, view.status)|lower }}</p>
                            </div>
                            <form method="post" action="{{ path('task_reserve', {id: view.task.id}) }}" class="shrink-0">
                                <input type="hidden" name="_back" value="home">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                                <button type="submit" class="seat-stacked" aria-label="Je m’en occupe : « {{ view.task.title }} »">
                                    <span class="seat-stacked-disc" aria-hidden="true"><span class="seat-empty"><twig:Icon name="plus" size="12" stroke="2.6"/></span></span>
                                    Je prends
                                </button>
                            </form>
                            {% if quests|length > 1 %}
                                <button type="button" class="quest-next" data-action="quest#next" data-haptic="tick" aria-label="Une autre quête" title="Une autre"><twig:Icon name="repeat" size="15" stroke="1.8"/></button>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
                <twig:TeamBar id="state-team" class="state-face" role="tabpanel" aria-labelledby="state-tab-team" data-state-switch-target="panel" data-face="team" hidden :team="team" :household="app.user.household" :detailed="false" :done="done_this_week"/>
            </div>
        </section>
    </div>

    <twig:BoostBanner/>

    {% if not app.user.hasAcceptedCharter %}
        <a href="{{ path('charter_show') }}" class="sheet flex items-center gap-3 p-3.5 text-ink no-underline hover:text-ink">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-sun"><twig:Icon name="flag" size="22" stroke="1.8"/></span>
            <span class="flex flex-1 flex-col">
                <span class="text-[15px] font-semibold">La charte de la coloc a changé</span>
                <span class="text-xs text-muted">Jette un œil, et dis si ça te va</span>
            </span>
            <twig:Icon name="chevron-right" size="20" class="text-muted"/>
        </a>
    {% endif %}

    {% set late = mine|filter(v => v.status.urgency.value == 'late')|length %}
    <section class="flex flex-col gap-3.5" aria-labelledby="mine-title">
        <div class="flex items-end justify-between gap-3">
            <div>
                <h2 id="mine-title" class="home-title">À toi de jouer</h2>
                <p class="mt-1 text-[13px] text-muted">{{ mine is empty ? 'Aucune carte en main' : mine|length ~ ' carte' ~ (mine|length > 1 ? 's') ~ (late ? ' · ' ~ late ~ ' en retard') }}</p>
            </div>
            {% if mine is not empty %}<p class="shrink-0 text-[13px] font-semibold text-clay-dark">{{ mine|reduce((sum, v) => sum + v.task.currentPoints, 0) }} pts</p>{% endif %}
        </div>
        {# Their cards side by side, to slide through; the next one shows at the edge. Last, the deck: a card to draw. #}
        <ul class="hand">
            {% for view in mine %}
                <li class="hand-card"><twig:TaskCard :view="view" :member="app.user"/></li>
            {% endfor %}
            <li class="hand-card"><twig:Deck :view="draw"/></li>
        </ul>
    </section>

    {% if quick_count > 0 %}
        <section class="-mx-5 flex flex-col gap-3" aria-labelledby="quick-title">
            <div class="flex items-baseline justify-between gap-2 px-5">
                <h2 id="quick-title" class="eyebrow">En un geste</h2>
                <a href="{{ path('task_quick_settings') }}" class="text-[12.5px] font-semibold text-muted no-underline hover:text-ink" aria-label="Régler « En un geste » : ordre et tâches montrées">Régler</a>
            </div>
            {% if quick is not empty %}
                <twig:QuickTasks :views="quick" class="px-5"/>
            {% else %}
                <p class="meta px-5">Aucune tâche montrée ici : <a href="{{ path('task_quick_settings') }}">choisir lesquelles</a>.</p>
            {% endif %}
        </section>
    {% endif %}

    {% if dormant is not empty %}
        <section class="flex flex-col gap-2.5" aria-labelledby="raise-title">
            <h2 id="raise-title" class="eyebrow">Ça arrive ?</h2>
            <ul class="flex flex-wrap gap-2">
                {% for view in dormant %}
                    <li><twig:RaiseButton :task="view.task" compact/></li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {# Everything there is to do, by urgency — the fresh ones folded under "Plus tard"; filtered by care_controller.js. #}
    <section class="flex flex-col gap-3.5" aria-labelledby="todo-title" data-controller="care" data-action="turbo:morph@window->care#apply">
        <div class="flex items-baseline gap-2.5">
            <h2 id="todo-title" class="home-title">Prendre soin de la Casa</h2>
            <span class="text-[15px] font-semibold text-dust">{{ care_counts.all }}</span>
        </div>
        <div class="segmented" role="group" aria-label="Afficher">
            {% for filter, label in {mine: 'Pour moi', free: 'Libres', all: 'Tout'} %}
                <button type="button" aria-pressed="{{ filter == 'all' ? 'true' : 'false' }}" data-care-target="button" data-action="care#show" data-care-filter-param="{{ filter }}" data-haptic="tick">
                    {{ label }} <span class="font-medium text-dust">{{ care_counts[filter] }}</span>
                </button>
            {% endfor %}
        </div>

        {% set titles = {late: 'En retard', due: 'C’est le moment', soon: 'Bientôt', fresh: 'Plus tard'} %}
        {% for urgency, views in groups|filter(views => views is not empty) %}
            {% set cards %}
                <ul class="flex flex-col gap-3">
                    {% for view in views %}
                        <li data-care-target="item" data-mine="{{ view.task.id in for_me ? 1 : 0 }}" data-free="{{ view.isFree ? 1 : 0 }}"><twig:TaskCard :view="view" :member="app.user"/></li>
                    {% endfor %}
                </ul>
            {% endset %}
            {% if urgency == 'fresh' %}
                <details class="care-group" id="care-later" data-care-target="group" aria-labelledby="later-title" data-controller="disclosure" data-action="toggle->disclosure#remember turbo:morph-element->disclosure#restore">
                    <summary class="care-group-title is-{{ urgency }}"><span class="care-group-dot"></span><span id="later-title">{{ titles[urgency] }}</span><span class="care-group-count" data-care-count>{{ views|length }}</span><span class="care-group-fold">Afficher</span></summary>
                    {{ cards }}
                </details>
            {% else %}
                <div class="care-group" data-care-target="group" aria-labelledby="{{ urgency }}-title">
                    <h3 class="care-group-title is-{{ urgency }}"><span class="care-group-dot"></span><span id="{{ urgency }}-title">{{ titles[urgency] }}</span><span class="care-group-count" data-care-count>{{ views|length }}</span></h3>
                    {{ cards }}
                </div>
            {% endif %}
        {% endfor %}
        <p class="sheet-empty" data-care-target="empty" {{ care_counts.all ? 'hidden' }}>Rien ici : la Casa est contente. Profites-en !</p>
    </section>
{% endblock %}

{% block nav %}<twig:BottomNav active="home"/>{% endblock %}
