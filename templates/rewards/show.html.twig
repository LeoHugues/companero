{% extends 'base.html.twig' %}

{% block title %}Mes récompenses · Companero{% endblock %}

{#
    What I earned: this week's surprises hidden in the cards, the road of levels and what each one brings,
    what I found, the yellow cards received and given, my titles.
#}
{% block body %}
    <header class="page-head items-end">
        <div class="min-w-0">
            <p class="eyebrow">Profil</p>
            <h1 class="page-title mt-1">Mes récompenses</h1>
        </div>
        <a href="{{ path('profile_show') }}" aria-label="Retour au profil" class="head-button"><twig:Icon name="arrow-left" size="20" stroke="2"/></a>
    </header>

    {# This week's surprises: how many are hidden in the cards, who found what. #}
    <section class="surprises flex flex-col gap-3 p-4" aria-labelledby="surprises-title">
        <div class="flex items-center gap-3">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-[13px] bg-sun text-ink"><twig:Icon name="gift" size="22" stroke="1.9"/></span>
            <div class="flex min-w-0 flex-col gap-0.5">
                <h2 id="surprises-title" class="text-[16px] leading-snug font-semibold">Les surprises de la semaine</h2>
                <p class="text-[12.5px] leading-snug text-[#D9C8B0]">
                    {%- if week_bounties is empty %}Pas de surprise cette semaine : elles arrivent lundi.
                    {%- else %}{{ week_bounties|length }} cachée{{ week_bounties|length > 1 ? 's' }} dans les cartes · {{ found_this_week }} trouvée{{ found_this_week > 1 ? 's' }}{% endif -%}
                </p>
            </div>
        </div>
        {% if week_bounties is not empty %}
            <ul class="flex flex-col gap-1.5">
                {% for bounty in week_bounties %}
                    <li class="road-step flex items-center gap-2.5 rounded-[14px] bg-white/[.07] px-3 py-2.5" style="animation-delay: {{ loop.index0 * 70 }}ms">
                        {% if bounty.claimed %}
                            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-sun text-ink">
                                {%- if bounty.kind.value == 'yellow_card' %}<span class="yellow-card yellow-card-mini" aria-hidden="true"></span>{% else %}<twig:Icon :name="bounty.kind.icon" size="16" stroke="2"/>{% endif -%}
                            </span>
                            <span class="flex min-w-0 flex-1 flex-col leading-tight">
                                <span class="truncate text-[14px] font-semibold">{{ bounty.task.title }}</span>
                                <span class="text-[12px] text-[#D9C8B0]">{{ bounty.label }} · trouvée par {{ bounty.claimedBy ? (bounty.claimedBy == member ? 'toi' : bounty.claimedBy.name) : 'quelqu’un' }}</span>
                            </span>
                        {% else %}
                            <span class="flex size-8 shrink-0 items-center justify-center rounded-full border-[1.5px] border-dashed border-sun/80 text-[13px] font-bold text-sun">?</span>
                            <span class="flex min-w-0 flex-1 flex-col leading-tight">
                                <a href="{{ path('task_show', {id: bounty.task.id}) }}" class="truncate text-[14px] font-semibold text-cream no-underline hover:text-sun">{{ bounty.task.title }}</a>
                                <span class="text-[12px] text-[#D9C8B0]">Une surprise attend la première personne qui la fait</span>
                            </span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    {# The road of levels: what was reached, where I am, what comes next and what it brings. #}
    <section class="flex flex-col gap-2.5" aria-labelledby="road-title">
        <div class="section-head px-1">
            <h2 id="road-title" class="eyebrow">Le chemin des niveaux</h2>
            <p class="text-[12.5px] text-muted"><span class="font-semibold text-ink"><twig:Count :value="level.xp" key="xp"/></span> XP</p>
        </div>
        <ol class="road">
            {% for step in road %}
                {% set reached = step.number <= level.number %}
                {% set current = step.number == level.number %}
                <li class="road-step road-node {{ current ? 'is-current' : (reached ? 'is-reached' : 'is-locked') }}" style="animation-delay: {{ loop.index0 * 60 }}ms">
                    <span class="road-dot" aria-hidden="true">
                        {%- if current %}{{ step.number }}{% elseif reached %}<twig:Icon name="check" size="15" stroke="2.6"/>{% else %}<twig:Icon name="lock" size="13" stroke="2.2"/>{% endif -%}
                    </span>
                    <div class="flex min-w-0 flex-1 flex-col gap-1.5 {{ current ? 'sheet p-3.5' : 'pt-1 pb-1.5' }}">
                        <p class="flex items-baseline justify-between gap-2">
                            <span class="text-[15px] leading-snug font-semibold {{ reached ? '' : 'text-muted' }}">Niveau {{ step.number }} · {{ step.rank }}</span>
                            <span class="shrink-0 text-[11.5px] font-medium text-muted tabular-nums">{{ step.xp }} XP</span>
                        </p>
                        {% if current %}
                            <twig:ProgressBar :value="level.progress" :height="7" label="Vers le niveau {{ step.number + 1 }}" key="xp-level"/>
                            <p class="text-[12px] text-muted">Encore {{ level.xpToNext }} XP pour le niveau {{ step.number + 1 }}</p>
                        {% endif %}
                        {% if step.gifts is not empty %}
                            <ul class="flex flex-wrap gap-1.5">
                                {% for gift in step.gifts %}
                                    <li class="road-gift {{ reached ? 'is-reached' }}">
                                        {%- if gift.value == 'yellow_card' %}<span class="yellow-card yellow-card-mini" aria-hidden="true"></span>{% else %}<twig:Icon :name="gift.icon" size="13" stroke="2.2"/>{% endif %}{{ gift.label -}}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ol>
    </section>

    <section class="flex flex-col gap-2" aria-labelledby="found-title">
        <h2 id="found-title" class="group-label">Mes trouvailles</h2>
        {% if found is not empty %}
            <ul class="list-sheet">
                {% for bounty in found %}
                    <li class="list-row">
                        <span class="tile tile-sun size-9 rounded-full">
                            {%- if bounty.kind.value == 'yellow_card' %}<span class="yellow-card yellow-card-mini" aria-hidden="true"></span>{% else %}<twig:Icon :name="bounty.kind.icon" size="17" stroke="1.9"/>{% endif -%}
                        </span>
                        <span class="flex min-w-0 flex-1 flex-col">
                            <span class="row-title truncate">{{ bounty.label }}</span>
                            <span class="row-meta truncate">{{ bounty.task.title }} · {{ bounty.claimedAt|format_date(pattern: 'EEEE d MMM', locale: 'fr') }}</span>
                        </span>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="sheet-empty">Chaque semaine, quelques cartes cachent une surprise : elles passent d’une rareté au-dessus et portent un petit ruban. Fais-en une la première !</p>
        {% endif %}
    </section>

    <section class="flex flex-col gap-2" aria-labelledby="cards-title">
        <h2 id="cards-title" class="group-label">Cartons jaunes</h2>
        {% if cards_received is not empty or cards_given is not empty %}
            <ul class="list-sheet">
                {% for card in cards_received %}
                    <li class="list-row items-start gap-3.5 py-3">
                        <span class="yellow-card mt-0.5" aria-hidden="true">{{ card.givenBy.initial }}</span>
                        <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                            <span class="text-[14.5px] leading-snug font-semibold">« {{ card.reason }} »</span>
                            <span class="row-meta">Reçu de {{ card.givenBy.name }} · {{ card.givenAt|format_date(pattern: 'EEEE d MMM', locale: 'fr') }}</span>
                        </span>
                    </li>
                {% endfor %}
                {% for card in cards_given %}
                    <li class="list-row items-start gap-3.5 py-3">
                        <span class="yellow-card mt-0.5 opacity-60" aria-hidden="true">{{ card.givenTo.initial }}</span>
                        <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                            <span class="text-[14.5px] leading-snug font-semibold">« {{ card.reason }} »</span>
                            <span class="row-meta">Donné à {{ card.givenTo.name }} · {{ card.givenAt|format_date(pattern: 'EEEE d MMM', locale: 'fr') }}</span>
                        </span>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="sheet-empty">Ceux qui font des choses ont le droit de siffler : un carton jaune se gagne en montant de niveau ou dans une surprise, et se donne à un coloc pour un truc en particulier. Pour rire, sans perdre de points.</p>
        {% endif %}
    </section>

    <section class="flex flex-col gap-2" aria-labelledby="trophies-title">
        <div class="section-head px-1">
            <h2 id="trophies-title" class="eyebrow">Mes titres</h2>
            <p class="text-[12.5px] text-muted">{{ titles|length }} gagné{{ titles|length > 1 ? 's' }}</p>
        </div>
        {% if titles is not empty %}
            <ul class="grid grid-cols-3 gap-2.5">
                {% for title in titles %}
                    <li class="road-step trophy-card" style="animation-delay: {{ loop.index0 * 60 }}ms">
                        <twig:Spark size="16" color="#F6C453"/>
                        <span class="text-[13px] leading-tight font-semibold">{{ title.name }}</span>
                        <span class="text-[11px] leading-tight text-[#D9C8B0]">sem. {{ title.weekStart|date('W') }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="sheet-empty">Ton premier titre t’attend au bilan de lundi.</p>
        {% endif %}
    </section>
{% endblock %}

{% block nav %}<twig:BottomNav active="home"/>{% endblock %}
