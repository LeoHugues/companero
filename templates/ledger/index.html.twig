{% extends 'base.html.twig' %}

{% block title %}Les comptes · Companero{% endblock %}

{#
    The household's accounts, the whole coloc's first: who is in each, and where I stand. None yet:
    the coloc's opens in one tap (with everyone, in euros), another one (a weekend away) has its form. From "+ Une
    dépense" (?depense=1), a tap on an account opens its expense form.
#}
{% block body %}
    {% if adding and ledgers is not empty %}
        {{ include('task/_add_head.html.twig', {title: 'Dans quel compte ?', lede: 'La dépense s’y ajoute, avec ceux qui y sont.'}) }}
    {% else %}
        <header class="page-head items-end">
            <div class="min-w-0">
                <p class="eyebrow">{{ app.user.household.name }}</p>
                <h1 class="page-title mt-1">Les comptes</h1>
            </div>
        </header>
    {% endif %}

    {% if ledgers is empty %}
        <div class="flex items-end gap-2.5">
            <twig:CasaMini :size="58" class="shrink-0"/>
            <p class="bubble mb-7 text-[13.5px]">Les courses, l’électricité, les pizzas du vendredi : notez qui a payé quoi, et pour qui. Je fais les comptes, et je dis qui rembourse qui.</p>
        </div>
        <form method="post" action="{{ path('ledger_open_common') }}" class="sheet flex flex-col gap-3 p-4">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
            <input type="hidden" name="_adding" value="{{ adding ? 1 : 0 }}">
            <p class="flex items-center gap-3">
                <span class="tile tile-sage" aria-hidden="true"><twig:Icon name="home" size="20" stroke="1.8"/></span>
                <span class="flex flex-col gap-0.5">
                    <span class="text-[15px] font-semibold">Les dépenses communes</span>
                    <span class="row-meta">Toute la coloc, en euros : ceux qui arrivent y entrent d’eux-mêmes.</span>
                </span>
            </p>
            <button type="submit" class="btn-primary w-full" data-haptic="success"><twig:Icon name="coins" size="19" stroke="2"/>Ouvrir les comptes de la coloc</button>
        </form>
        <a href="{{ path('ledger_new') }}" class="head-link self-center"><twig:Icon name="plus" size="16" stroke="2.2"/>Un autre compte : un week-end, une soirée…</a>
    {% else %}
        <ul class="list-sheet">
            {% for ledger in ledgers %}
                {% set balance = mine[loop.index0] %}
                <li>
                    <a href="{{ adding ? path('expense_new', {id: ledger.id}) : path('ledger_show', {id: ledger.id}) }}" class="list-row" id="ledger-{{ ledger.id }}">
                        <span class="tile {{ ledger.everyone ? 'tile-sage' : 'tile-lilac' }}" aria-hidden="true"><twig:Icon :name="ledger.everyone ? 'home' : 'coins'" size="20" stroke="1.8"/></span>
                        <span class="flex min-w-0 flex-1 flex-col gap-1">
                            <span class="row-title">{{ ledger.name }}</span>
                            <span class="flex min-w-0 items-center gap-2" title="{{ (totals[ledger.id] ?? 0)|money(ledger.currency) }} de dépenses en tout">
                                <span class="faces" aria-hidden="true">
                                    {% for participant in ledger.participants|slice(0, 5) %}<twig:Avatar :member="participant" size="20"/>{% endfor %}
                                </span>
                                {% if balance is not null %}
                                    <span class="ledger-standing {{ balance > 0 ? 'is-owed' : (balance < 0 ? 'is-owing') }}">{{ balance > 0 ? 'On te doit ' ~ balance|money(ledger.currency) : (balance < 0 ? 'Tu dois ' ~ (-balance)|money(ledger.currency) : 'Tu es quitte') }}</span>
                                {% else %}
                                    <span class="row-meta truncate">{{ (totals[ledger.id] ?? 0)|money(ledger.currency) }} de dépenses</span>
                                {% endif %}
                            </span>
                        </span>
                        <twig:Icon :name="adding ? 'plus' : 'chevron-right'" size="18" :stroke="adding ? 2.2 : 2" class="row-chevron"/>
                    </a>
                </li>
            {% endfor %}
        </ul>
        {% if not adding %}
            <a href="{{ path('ledger_new') }}" class="head-link self-start"><twig:Icon name="plus" size="16" stroke="2.2"/>Un nouveau compte</a>
        {% endif %}
    {% endif %}
{% endblock %}

{% block nav %}<twig:BottomNav active="ledger"/>{% endblock %}
