{#
    On the home page, under what is missing: where I stand in the accounts at a glance — owed in sage, owing in
    terracotta; account by account when there are several — and "+" to note an expense. The rest of the strip opens
    the accounts (the only one, straight away).
#}
{% set unsettled = ledgers|filter(ledger => standing[ledger.id] != 0) %}
<section class="missing-strip" aria-labelledby="ledger-strip-title">
    <a href="{{ ledgers|length == 1 ? path('ledger_show', {id: (ledgers|first).id}) : path('ledger_index') }}" class="missing-strip-link">
        <span class="tile tile-sage" aria-hidden="true"><twig:Icon name="coins" size="21" stroke="1.8"/></span>
        <span class="flex min-w-0 flex-1 flex-col gap-0.5">
            <span id="ledger-strip-title" class="eyebrow">Les comptes</span>
            <span class="missing-strip-names">
                {%- if ledgers is empty -%}
                    <span class="font-medium text-muted">Partager une dépense</span>
                {%- elseif unsettled is empty -%}
                    <span class="font-medium text-muted">Tu es quitte</span>
                {%- elseif ledgers|length == 1 -%}
                    {%- set cents = standing[(ledgers|first).id] -%}
                    <span class="{{ cents > 0 ? 'text-ok-ink' : 'text-clay-dark' }}">{{ cents > 0 ? 'On te doit ' ~ cents|money((ledgers|first).currency) : 'Tu dois ' ~ (-cents)|money((ledgers|first).currency) }}</span>
                {%- else -%}
                    {%- for ledger in unsettled -%}
                        {%- set cents = standing[ledger.id] -%}
                        {%- if not loop.first %}<span class="text-dust"> · </span>{% endif %}{{ ledger.name }} <span class="{{ cents > 0 ? 'text-ok-ink' : 'text-clay-dark' }}">{{ cents|money(ledger.currency, true) }}</span>
                    {%- endfor -%}
                {%- endif -%}
            </span>
        </span>
    </a>
    <a href="{{ path('ledger_expense_any') }}" class="missing-strip-add" aria-label="Noter une dépense partagée" title="Une dépense" data-haptic="press"><twig:Icon name="plus" size="21" stroke="2.4"/></a>
</section>
