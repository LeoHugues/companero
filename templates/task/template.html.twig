{% extends 'base.html.twig' %}

{% block title %}{{ view.task.title }} · Modèle · Companero{% endblock %}

{#
    A template's page: the rule it follows, what it is worth, who takes care of it. What there is to
    do right now is the task's own page (its card), linked from here.
#}
{% block body %}
    {% set task = view.task %}
    {% set status = view.status %}

    <header class="page-head">
        <a href="{{ ux_is_native() ? '/recede_historical_location' : path('task_index') }}" aria-label="Retour aux modèles" class="head-button"><twig:Icon name="arrow-left" size="20" stroke="2"/></a>
        <a href="{{ path('task_edit', {id: task.id}) }}" class="head-link"><twig:Icon name="edit" size="16" stroke="1.9"/>Modifier le modèle</a>
    </header>

    <section class="flex items-start gap-4" id="template-{{ task.id }}" data-rarity="{{ task.rarity.value }}">
        <div class="flex min-w-0 flex-1 flex-col gap-1.5">
            <p class="eyebrow flex items-center gap-1.5"><twig:Icon :name="task_kind_icon(task)" size="13" stroke="2.2"/>Modèle · {{ task.kind.label }}</p>
            <h1 class="page-title">{{ task.title }}</h1>
            <p class="text-[14px] text-muted">{{ task_place(task) }} · {{ task_rule_label(task) }}</p>
        </div>
        <twig:TaskVignette :task="task" class="mt-1 shrink-0"/>
    </section>
    {% if task.description %}
        <p class="task-note"><twig:Icon name="list" size="15" class="mt-0.5 shrink-0"/><span>{{ task.description }}</span></p>
    {% endif %}

    <section class="flex flex-col gap-2" aria-labelledby="rule-title">
        <h2 id="rule-title" class="group-label">La règle</h2>
        <dl class="list-sheet facts">
            <div><dt>Vaut</dt><dd class="font-semibold text-clay-dark">{{ task.points }} pts</dd></div>
            <div>
                <dt>Carte</dt>
                {# A tiny card in its finish: the rarity is seen, not written on the cards. #}
                <dd class="flex items-center justify-end gap-2"><span class="rarity-swatch rarity-swatch-{{ task.rarity.value }}" aria-hidden="true"></span>{{ task.rarity.label|lower }}</dd>
            </div>
            <div><dt>Catégorie</dt><dd class="flex items-center justify-end gap-1.5"><twig:Icon :name="task.category.icon" size="15" stroke="1.9" class="text-muted"/>{{ task.category.label }}</dd></div>
            {% if task.kind.isPlanned or task.kind.value == 'occasional' %}
                <div>
                    <dt>Alertes</dt>
                    <dd class="flex flex-col items-end gap-1">
                        {% if task.kind.isPlanned %}<span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-warn" aria-hidden="true"></span>orange {{ task.warningHours ? duration_label(task.warningHours) ~ ' avant' : (task.kind.value == 'rolling' ? 'aux 60 % du rythme' : '2 jours avant') }}</span>{% endif %}
                        <span class="flex items-center gap-1.5"><span class="size-2 rounded-full bg-danger" aria-hidden="true"></span>rouge {{ duration_label(task.marginHours) }} après{{ task.kind.value == 'occasional' ? ' avoir été signalée' }}</span>
                    </dd>
                </div>
            {% endif %}
            {% if task.cooldownHours %}
                <div><dt>Délai</dt><dd>pas avant {{ duration_label(task.cooldownHours) }} après l’avoir faite</dd></div>
            {% endif %}
            <div>
                <dt>S’en charge</dt>
                <dd class="flex items-center justify-end gap-1.5">
                    {% if task.assignee %}<twig:Avatar :member="task.assignee" size="20"/>{{ task.assignee.name }}{% if task.backup %} <span class="font-normal text-muted">(sinon {{ task.backup.name }})</span>{% endif %}{% else %}qui est là{% endif %}
                </dd>
            </div>
            <div><dt>Créé</dt><dd>par {{ task.createdBy.name }} le {{ task.createdAt|date('d/m/Y') }}</dd></div>
        </dl>
    </section>

    <section class="flex flex-col gap-2" aria-labelledby="now-title">
        <h2 id="now-title" class="group-label">En ce moment</h2>
        {% if task.kind.isPlanned %}
            <a href="{{ path('task_show', {id: task.id}) }}" class="sheet list-row px-4">
                <twig:UrgencyPill :view="view"/>
                <span class="row-title flex-1">Voir la tâche à faire</span>
                <twig:Icon name="chevron-right" size="17" class="row-chevron"/>
            </a>
        {% elseif task.kind.value == 'occasional' %}
            {% if task.raised %}
                <a href="{{ path('task_show', {id: task.id}) }}" class="sheet list-row px-4">
                    <twig:UrgencyPill :view="view"/>
                    <span class="row-title flex-1">Sa carte attend sur l’accueil</span>
                    <twig:Icon name="chevron-right" size="17" class="row-chevron"/>
                </a>
            {% else %}
                <div class="sheet flex items-center gap-3 p-4">
                    <p class="flex-1 text-[13.5px] leading-snug text-muted">Elle dort. Quand ça arrive, dis-le : sa carte apparaît sur l’accueil jusqu’à ce que quelqu’un s’en occupe.</p>
                    <twig:RaiseButton :task="task" :back="'template-' ~ task.id"/>
                </div>
            {% endif %}
        {% else %}
            <p class="sheet flex items-center gap-3 p-4 text-[13.5px] leading-snug text-muted"><span class="tile tile-sun"><twig:Icon name="bolt" size="19" stroke="1.9"/></span>Une tâche express se fait d’un appui, depuis l’accueil (« En un geste »).</p>
        {% endif %}
    </section>

    <section class="flex flex-col gap-2" aria-labelledby="history-title">
        <div class="section-head px-1">
            <h2 id="history-title" class="eyebrow">Déjà fait</h2>
            <p class="text-[12.5px] text-muted">{{ done_last_30_days }} fois en 30 jours</p>
        </div>
        {% if completions is not empty %}
            <ul class="list-sheet">
                {% for completion in completions %}
                    <li>
                        <a href="{{ path('completion_edit', {id: completion.id}) }}" class="list-row">
                            <twig:Avatar :member="completion.member" size="32"/>
                            <span class="flex min-w-0 flex-1 flex-col">
                                <span class="row-title">{{ completion.member.name }}</span>
                                <span class="row-meta">{{ completion.completedAt|format_date(pattern: 'EEEE d MMMM', locale: 'fr') }} à {{ completion.completedAt|date('G\\hi') }}</span>
                            </span>
                            <span class="row-points">+{{ points[completion.id] ?? 0 }}</span>
                            <twig:Icon name="chevron-right" size="17" class="row-chevron"/>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="sheet-empty">Jamais encore.</p>
        {% endif %}
    </section>
{% endblock %}

{% block nav %}<twig:BottomNav active="tasks"/>{% endblock %}
