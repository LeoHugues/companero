{% extends 'base.html.twig' %}

{% block title %}En un geste · Companero{% endblock %}

{# The express tasks of "En un geste", on the home page: their order, and those left out. #}
{% block body %}
    <header class="page-head">
        <a href="{{ ux_is_native() ? '/recede_historical_location' : path('app_home') }}" aria-label="Retour" class="head-button"><twig:Icon name="arrow-left" size="20" stroke="2"/></a>
        <a href="{{ path('task_new_template') }}" class="head-link"><twig:Icon name="plus" size="16" stroke="2.2"/>Une express</a>
    </header>
    <div>
        <p class="eyebrow">Sur l’accueil</p>
        <h1 class="page-title mt-1">En un geste</h1>
        <p class="page-lede mt-1.5">Les tâches express : dans quel ordre, et lesquelles y montrer. Pour toute la coloc.</p>
    </div>

    {% if tasks is not empty %}
        <ol class="list-sheet">
            {% for task in tasks %}
                <li id="quick-{{ task.id }}" class="list-row" data-hidden="{{ task.quickHidden ? 'true' : 'false' }}">
                    <form method="post" action="{{ path('task_quick_arrange', {id: task.id}) }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                        <button type="submit" name="action" value="{{ task.quickHidden ? 'afficher' : 'masquer' }}" data-haptic="toggle"
                                class="quick-eye {{ task.quickHidden ? '' : 'is-shown' }}"
                                aria-label="{{ task.quickHidden ? 'Montrer' : 'Ne plus montrer' }} « {{ task.title }} » sur l’accueil" aria-pressed="{{ task.quickHidden ? 'false' : 'true' }}">
                            <twig:Icon :name="task.quickHidden ? 'eye-off' : 'eye'" size="18" stroke="1.9"/>
                        </button>
                    </form>
                    <a href="{{ path('task_template', {id: task.id}) }}" class="flex min-w-0 flex-1 flex-col text-ink no-underline hover:text-ink {{ task.quickHidden ? 'opacity-55' }}">
                        <span class="row-title truncate">{{ task.title }}</span>
                        <span class="row-meta">{{ task.quickHidden ? 'pas sur l’accueil' : task_place(task) }} · +{{ task.points }}</span>
                    </a>
                    <form method="post" action="{{ path('task_quick_arrange', {id: task.id}) }}" class="-mr-1.5 flex shrink-0 items-center">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                        <button type="submit" name="action" value="monter" class="row-button" aria-label="Monter « {{ task.title }} »" data-haptic="tick"{{ loop.first ? ' disabled' }}><twig:Icon name="arrow-up" size="17" stroke="2"/></button>
                        <button type="submit" name="action" value="descendre" class="row-button" aria-label="Descendre « {{ task.title }} »" data-haptic="tick"{{ loop.last ? ' disabled' }}><twig:Icon name="arrow-down" size="17" stroke="2"/></button>
                    </form>
                </li>
            {% endfor %}
        </ol>
    {% else %}
        <p class="sheet-empty">Pas encore de tâche express. <a href="{{ path('task_new_template') }}">En créer une</a> : vider le lave-vaisselle, sortir le verre…</p>
    {% endif %}
{% endblock %}

{% block nav %}<twig:BottomNav active="home"/>{% endblock %}
