{% extends 'base.html.twig' %}

{% block title %}Les modèles · Companero{% endblock %}

{#
    The templates, the other face of the "Tâches" tab: what comes back in the house (regular, on a fixed day, express,
    occasional) and the catalogue of one-off tasks launched by hand. A search box, and folds by room, by kind of work
    or by how they come back.
#}
{% block body %}
    {{ include('task/_tabs.html.twig', {tab: 'templates', todo: null, templates: count}) }}
    <p class="page-lede -mt-1 px-1">Les règles de la maison : ce qui revient tout seul, quand c’est le moment.</p>

    <div class="flex flex-col gap-5" data-controller="filter">
        <div class="flex flex-col gap-3">
            <label class="relative block">
                <span class="sr-only">Chercher un modèle</span>
                <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-muted"><twig:Icon name="search" size="18" stroke="1.9"/></span>
                <input type="search" class="input bg-surface pl-10 shadow-[0_6px_16px_-12px_rgba(46,30,20,.35)]" placeholder="Chercher parmi les {{ count }} modèles…" autocomplete="off"
                       data-filter-target="input" data-action="input->filter#filter">
            </label>
            <nav class="flex flex-wrap items-center gap-1.5 px-1" aria-label="Ranger par">
                <span class="mr-1 text-[12.5px] font-medium text-muted">Ranger par</span>
                {% for key, label in groupings %}
                    <a href="{{ path('task_index', {par: key}) }}" class="sort-chip"{% if grouping == key %} aria-current="page"{% endif %} data-haptic="tick">{{ label }}</a>
                {% endfor %}
            </nav>
        </div>

        {% for group in groups %}
            <details class="fold" id="fold-{{ group.key }}" open data-filter-target="group" data-controller="disclosure" data-action="toggle->disclosure#remember turbo:morph-element->disclosure#restore">
                <summary class="fold-summary">
                    <span class="min-w-0">
                        <span class="flex items-baseline gap-2"><span class="fold-title">{{ group.label }}</span><span class="fold-count">{{ group.tasks|length }}</span></span>
                        {% if group.hint %}<span class="fold-hint">{{ group.hint }}</span>{% endif %}
                    </span>
                    <twig:Icon name="chevron-down" size="17" stroke="2" class="fold-chevron"/>
                </summary>
                <ul class="list-sheet">
                    {% for task in group.tasks %}
                        {% set occasional = task.kind.value == 'occasional' %}
                        <twig:TemplateRow :task="task" data-filter-target="item" data-filter-text="{{ task.title }} {{ task_place(task) }} {{ task.category.label }} {{ task.kind.label }}">
                            {% if occasional and task.raised %}
                                <span class="raise-awake" title="Signalée : sa carte attend sur l’accueil"><twig:Icon name="siren" size="13" stroke="2.2"/></span>
                            {% elseif occasional %}
                                <twig:RaiseButton :task="task" back="tasks" round/>
                            {% endif %}
                        </twig:TemplateRow>
                    {% endfor %}
                </ul>
            </details>
        {% else %}
            <p class="sheet-empty">Aucun modèle encore. <a href="{{ path('task_new_template') }}">En créer un</a> : une tâche qui revient toute seule.</p>
        {% endfor %}

        {% if catalog is not empty %}
            <details class="fold" id="fold-catalog" data-filter-target="group" data-controller="disclosure" data-action="toggle->disclosure#remember turbo:morph-element->disclosure#restore">
                <summary class="fold-summary">
                    <span class="min-w-0">
                        <span class="flex items-baseline gap-2"><span class="fold-title">Catalogue</span><span class="fold-count">{{ catalog|length }}</span></span>
                        <span class="fold-hint">Des tâches ponctuelles toutes prêtes : on en lance une quand il le faut.</span>
                    </span>
                    <twig:Icon name="chevron-down" size="17" stroke="2" class="fold-chevron"/>
                </summary>
                <ul class="list-sheet">
                    {% for item in catalog %}
                        <li class="flex items-center gap-1" data-filter-target="item" data-filter-text="{{ item.title }} {{ item.zone.name ?? '' }} {{ item.category.label }}">
                            <a href="{{ path('task_new_one_off', {modele: item.id}) }}" class="list-row min-w-0 flex-1">
                                <twig:TaskVignette :task="item" class="vignette-small"/>
                                <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                                    <span class="row-title">{{ item.title }}</span>
                                    <span class="row-meta">{{ item.zone ? item.zone.name ~ ' · ' }}{{ item.category.label }}</span>
                                </span>
                                <span class="catalog-launch">Lancer<span>+{{ item.points }}</span></span>
                            </a>
                            <form method="post" action="{{ path('catalog_delete', {id: item.id}) }}" data-turbo-confirm="Retirer « {{ item.title }} » du catalogue ?">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                                <button type="submit" class="row-button -mr-1.5" aria-label="Retirer « {{ item.title }} » du catalogue"><twig:Icon name="trash" size="17" stroke="1.9"/></button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            </details>
        {% endif %}

        <p class="sheet-empty" data-filter-target="empty" hidden>Aucun modèle ne correspond. <a href="{{ path('task_new_template') }}">En créer un</a></p>
    </div>
{% endblock %}

{% block nav %}<twig:BottomNav active="tasks"/>{% endblock %}
