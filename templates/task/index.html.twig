{% extends 'base.html.twig' %}

{% block title %}Les modèles · Companero{% endblock %}

{#
    The templates: what comes back in the house (regular, on a fixed day, express, occasional) and the
    catalogue of one-off tasks launched by hand. What there is to do right now is on the home page.
    A search box, and folds by room, by kind of work or by how they come back.
#}
{% block body %}
    <header class="flex items-center justify-between gap-3">
        <div class="flex flex-col gap-0.5">
            <h1 class="text-[26px]">Les modèles</h1>
            <p class="text-sm text-muted">Les règles de la maison. Ce qu’il y a à faire est sur <a href="{{ path('app_home') }}">l’accueil</a>.</p>
        </div>
        <a href="{{ path('plan_show') }}" class="chip shrink-0 gap-1.5"><twig:Icon name="plan" size="18"/> Plan</a>
    </header>

    <div class="flex flex-col gap-4" data-controller="filter">
        <div class="flex flex-col gap-2.5">
            <label class="relative block">
                <span class="sr-only">Chercher un modèle</span>
                <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-muted"><twig:Icon name="search" size="18"/></span>
                <input type="search" class="input pl-10" placeholder="Chercher parmi les {{ count }} modèles…" autocomplete="off"
                       data-filter-target="input" data-action="input->filter#filter">
            </label>
            <nav class="flex items-center gap-2" aria-label="Ranger par">
                <span class="text-sm font-bold text-muted">Ranger par</span>
                {% for key, label in groupings %}
                    <a href="{{ path('task_index', {par: key}) }}" class="chip h-8 px-3 text-[13px] {{ grouping == key ? 'chip-active' : '' }}"{% if grouping == key %} aria-current="page"{% endif %}>{{ label }}</a>
                {% endfor %}
            </nav>
        </div>

        {% for group in groups %}
            <details class="fold" id="fold-{{ group.key }}" open data-filter-target="group" data-controller="disclosure" data-action="toggle->disclosure#remember turbo:morph-element->disclosure#restore">
                <summary class="fold-summary">
                    <span class="flex min-w-0 flex-1 flex-col">
                        <span class="truncate">{{ group.label }}</span>
                        {% if group.hint %}<span class="text-xs font-semibold text-muted">{{ group.hint }}</span>{% endif %}
                    </span>
                    <span class="fold-count">{{ group.tasks|length }}</span>
                    <twig:Icon name="chevron-down" size="18" stroke="2.4" class="fold-chevron"/>
                </summary>
                <ul class="card divide-y divide-line px-3.5">
                    {% for task in group.tasks %}
                        {% set occasional = task.kind.value == 'occasional' %}
                        <twig:TemplateRow :task="task" data-filter-target="item" data-filter-text="{{ task.title }} {{ task.zone.name ?? '' }} {{ task.pet.name ?? '' }} {{ task.category.label }} {{ task.kind.label }}">
                            {% if occasional and task.raised %}
                                <span class="raise-awake" title="Signalée : sa carte attend sur l’accueil"><twig:Icon name="siren" size="13" stroke="2.4"/></span>
                            {% elseif occasional %}
                                <twig:RaiseButton :task="task" back="tasks" round/>
                            {% endif %}
                        </twig:TemplateRow>
                    {% endfor %}
                </ul>
            </details>
        {% else %}
            <p class="card p-4 text-sm text-muted">Aucun modèle encore. <a href="{{ path('task_new_template') }}">En créer un</a> : une tâche qui revient toute seule.</p>
        {% endfor %}

        {% if catalog is not empty %}
            <details class="fold" id="fold-catalog" data-filter-target="group" data-controller="disclosure" data-action="toggle->disclosure#remember turbo:morph-element->disclosure#restore">
                <summary class="fold-summary">
                    <span class="flex min-w-0 flex-1 flex-col">
                        <span>Catalogue</span>
                        <span class="text-xs font-semibold text-muted">Des tâches ponctuelles toutes prêtes : on en lance une quand il le faut.</span>
                    </span>
                    <span class="fold-count">{{ catalog|length }}</span>
                    <twig:Icon name="chevron-down" size="18" stroke="2.4" class="fold-chevron"/>
                </summary>
                <ul class="card divide-y divide-line px-3.5">
                    {% for item in catalog %}
                        <li class="flex items-center gap-2" data-filter-target="item" data-filter-text="{{ item.title }} {{ item.zone.name ?? '' }} {{ item.category.label }}">
                            <a href="{{ path('task_new_one_off', {modele: item.id}) }}" class="flex min-w-0 flex-1 items-center gap-3 py-3 text-ink no-underline hover:text-ink">
                                <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-track text-ink-soft" aria-hidden="true"><twig:Icon name="layers" size="20"/></span>
                                <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                                    <span class="text-[15px] leading-snug font-bold">{{ item.title }}</span>
                                    <span class="text-xs text-muted">{{ item.zone ? item.zone.name ~ ' · ' }}{{ item.category.label }}</span>
                                </span>
                                <span class="flex h-8 shrink-0 items-center gap-1 rounded-full bg-sun px-3 text-xs font-extrabold">Lancer · {{ item.points }}</span>
                            </a>
                            <form method="post" action="{{ path('catalog_delete', {id: item.id}) }}" data-turbo-confirm="Retirer « {{ item.title }} » du catalogue ?">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                                <button type="submit" class="flex size-8 cursor-pointer items-center justify-center rounded-full text-dust transition hover:bg-track hover:text-ink" aria-label="Retirer « {{ item.title }} » du catalogue"><twig:Icon name="trash" size="16"/></button>
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            </details>
        {% endif %}

        <p class="card p-4 text-sm text-muted" data-filter-target="empty" hidden>Aucun modèle ne correspond. <a href="{{ path('task_new_template') }}">En créer un</a></p>
    </div>
{% endblock %}

{% block nav %}<twig:BottomNav active="tasks"/>{% endblock %}
