{% extends 'base.html.twig' %}

{% block title %}Les modèles · Companero{% endblock %}

{#
    The templates: what comes back in the house (regular, on a fixed day, express) and the catalogue
    of one-off tasks launched by hand. What there is to do right now is on the home page.
#}
{% block body %}
    <header class="flex items-center justify-between gap-3">
        <div class="flex flex-col gap-0.5">
            <h1 class="text-[26px]">Les modèles</h1>
            <p class="text-sm text-muted">Les règles de la maison. Ce qu’il y a à faire est sur <a href="{{ path('app_home') }}">l’accueil</a>.</p>
        </div>
        <a href="{{ path('plan_show') }}" class="chip shrink-0 gap-1.5"><twig:Icon name="plan" size="18"/> Plan</a>
    </header>

    <nav class="-mx-5 flex gap-2 overflow-x-auto px-5 pb-1" aria-label="Filtrer par zone">
        <a href="{{ path('task_index') }}" class="chip shrink-0 {{ current_zone is null ? 'chip-active' : '' }}"{% if current_zone is null %} aria-current="page"{% endif %}>Tout</a>
        {% for zone in zones %}
            <a href="{{ path('task_index', {zone: zone.id}) }}" class="chip shrink-0 {{ current_zone == zone.id ? 'chip-active' : '' }}"{% if current_zone == zone.id %} aria-current="page"{% endif %}>{{ zone.name }}</a>
        {% endfor %}
    </nav>

    <section class="flex flex-col gap-2" aria-labelledby="recurring-title">
        <div class="flex flex-col">
            <h2 id="recurring-title" class="section-title">Reviennent toutes seules</h2>
            <p class="meta">Une tâche à faire arrive sur l’accueil quand c’est le moment.</p>
        </div>
        {% if recurring is not empty %}
            <ul class="card divide-y divide-line px-3.5">
                {% for task in recurring %}<twig:TemplateRow :task="task"/>{% endfor %}
            </ul>
        {% else %}
            <p class="meta py-2">Aucun modèle ici. <a href="{{ path('task_new_template') }}">En créer un</a></p>
        {% endif %}
    </section>

    {% if quick is not empty and current_zone is null %}
        <section class="flex flex-col gap-2" aria-labelledby="quick-title">
            <div class="flex flex-col">
                <h2 id="quick-title" class="section-title">Express</h2>
                <p class="meta">Jamais en retard : un appui sur l’accueil quand c’est fait.</p>
            </div>
            <ul class="card divide-y divide-line px-3.5">
                {% for task in quick %}<twig:TemplateRow :task="task"/>{% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if catalog is not empty and current_zone is null %}
        <section class="flex flex-col gap-2" aria-labelledby="catalog-title">
            <div class="flex flex-col">
                <h2 id="catalog-title" class="section-title">Catalogue</h2>
                <p class="meta">Des tâches ponctuelles toutes prêtes : on en lance une quand il le faut.</p>
            </div>
            <ul class="card divide-y divide-line px-3.5">
                {% for item in catalog %}
                    <li>
                        <a href="{{ path('task_new_one_off', {modele: item.id}) }}" class="flex items-center gap-3 py-3 text-ink no-underline hover:text-ink">
                            <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-track text-ink-soft" aria-hidden="true"><twig:Icon name="layers" size="20"/></span>
                            <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                                <span class="text-[15px] leading-snug font-bold">{{ item.title }}</span>
                                <span class="text-xs text-muted">{{ item.category.label }} · ponctuelle</span>
                            </span>
                            <span class="text-sm font-extrabold whitespace-nowrap">{{ item.points }} pts</span>
                            <span class="flex h-8 shrink-0 items-center gap-1 rounded-full bg-sun px-3 text-xs font-extrabold">Lancer</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
{% endblock %}

{% block nav %}<twig:BottomNav active="tasks"/>{% endblock %}
