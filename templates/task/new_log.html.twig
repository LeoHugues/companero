{% extends 'base.html.twig' %}

{% block title %}J’ai fait quelque chose · Companero{% endblock %}

{# The save button floats above the bottom bar; in the app's modal, at the very bottom. #}
{% block main_class %}{{ ux_is_native() ? 'pb-6' : 'pb-28' }}{% endblock %}

{% block body %}
    {{ include('task/_add_head.html.twig', {
        title: 'J’ai fait quelque chose',
        lede: 'La tâche repart de ce moment-là, et ses points comptent ce jour-là.',
    }) }}

    {{ form_start(form, {attr: {class: 'flex flex-col gap-4'}}) }}
        <div class="form-sheet">
            {{ form_row(form.task) }}
            {{ form_row(form.doneAt) }}
        </div>
        <p class="px-1 text-[13px] leading-snug text-muted">Ce n’est pas dans la liste ? <a href="{{ path('task_new_one_off', {fait: 1}) }}" class="font-semibold">Noter autre chose</a>, une tâche faite une fois.</p>

        <div class="save-bar {{ ux_is_native() ? 'is-native' }}">
            <div class="save-bar-in"><button type="submit" class="btn-primary" data-haptic="press"><twig:Icon name="check" size="19" stroke="2.4"/>C’est fait</button></div>
        </div>
    {{ form_end(form) }}
{% endblock %}

{% block nav %}{% if not ux_is_native() %}<twig:BottomNav active="new"/>{% endif %}{% endblock %}
