{% extends 'base.html.twig' %}

{% block title %}{{ task.title }} · Companero{% endblock %}

{% block body %}
    <header class="flex items-center justify-between">
        <h1 class="text-[22px]">Modifier la tâche</h1>
        <a href="{{ ux_is_native() ? '/recede_historical_location' : path('task_index') }}" aria-label="Fermer" class="flex size-11 items-center justify-center rounded-full text-ink"><twig:Icon name="close" size="22" stroke="2.2"/></a>
    </header>

    <p class="meta -mt-2">Ajoutée par {{ task.createdBy.name }} le {{ task.createdAt|date('d/m/Y') }}{% if task.lastCompletedAt %} · faite pour la dernière fois le {{ task.lastCompletedAt|date('d/m à H\\hi') }}{% endif %}.</p>

    {{ include('task/_form.html.twig', {submit_label: 'Enregistrer'}) }}

    <form method="post" action="{{ path('task_delete', {id: task.id}) }}" data-turbo-confirm="Retirer « {{ task.title }} » de la liste ?" class="self-center">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
        <button type="submit" class="btn-link text-clay-dark"><twig:Icon name="trash" size="18"/>&nbsp;Retirer cette tâche</button>
    </form>
{% endblock %}

{# In the Android app this form is a modal (see App\Native\NativeConfiguration): no bottom navigation. #}
{% block nav %}{% if not ux_is_native() %}<twig:BottomNav active="tasks"/>{% endif %}{% endblock %}
