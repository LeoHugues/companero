{% extends 'base.html.twig' %}

{% block title %}Une tâche à faire · Companero{% endblock %}

{# Room for the save bar, fixed at the bottom of the screen. #}
{% block main_class %}{{ ux_is_native() ? 'pb-28' : 'pb-48' }}{% endblock %}

{% block body %}
    {{ include('task/_tunnel.html.twig', {
        step: 2,
        title: template ? template.title : 'Une tâche à faire',
        icon: 'check',
        what: 'À faire une fois : elle arrive sur l’accueil et disparaît une fois faite. Pour une tâche qui revient, crée plutôt un modèle.'
    }) }}

    {% if catalog is not empty %}
        <section class="flex flex-col gap-2" aria-labelledby="catalog-title">
            <h2 id="catalog-title" class="field-label">Depuis le catalogue</h2>
            <ul class="-mx-5 flex gap-2 overflow-x-auto px-5 pb-1">
                {% for item in catalog %}
                    <li>
                        <a href="{{ path('task_new_one_off', {modele: item.id}) }}"
                           class="flex min-h-[76px] w-[116px] flex-col justify-between gap-1.5 rounded-2xl border-[1.5px] {{ template and template.id == item.id ? 'border-ink bg-sun' : 'border-line bg-surface' }} p-2.5 text-ink no-underline transition hover:-translate-y-0.5 hover:border-ink hover:text-ink">
                            <span class="text-sm leading-tight font-bold">{{ item.title }}</span>
                            <span class="text-xs font-extrabold text-clay-dark">+{{ item.points }} pts</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {{ include('task/_form.html.twig', {submit_label: 'Ajouter la tâche'}) }}
{% endblock %}

{% block nav %}{% if not ux_is_native() %}<twig:BottomNav active="new"/>{% endif %}{% endblock %}
