{#
    The header of the "+" tunnel. step 1: choose what it is about; step 2: fill it in.
    Variables: step, title, and on step 2 icon, tile (its colour) and what (a reminder of what is being created).
#}
<header class="flex flex-col gap-4">
    <div class="page-head">
        {% if step > 1 %}
            <a href="{{ path('task_new') }}" class="head-link pl-2.5"><twig:Icon name="arrow-left" size="17" stroke="2"/>Changer</a>
        {% else %}
            <span class="size-10" aria-hidden="true"></span>
        {% endif %}
        <p class="flex items-center gap-2 text-[12px] font-semibold text-muted" aria-label="Étape {{ step }} sur 2">
            <span class="flex gap-1" aria-hidden="true"><span class="h-1.5 w-5 rounded-full bg-clay"></span><span class="h-1.5 w-5 rounded-full {{ step > 1 ? 'bg-clay' : 'bg-track' }}"></span></span>
            Étape {{ step }}/2
        </p>
        <a href="{{ ux_is_native() ? '/recede_historical_location' : path('app_home') }}" aria-label="Fermer" class="head-button"><twig:Icon name="close" size="19" stroke="2"/></a>
    </div>
    <h1 class="page-title">{{ title }}</h1>
    {% if what is defined %}
        <p class="-mt-1 flex items-start gap-3 rounded-[18px] bg-track/45 py-3 pr-4 pl-3 text-[13.5px] leading-snug text-ink-soft">
            <span class="tile {{ tile|default('tile-sand') }} size-9 rounded-[11px]"><twig:Icon :name="icon" size="18" stroke="1.9"/></span>
            <span class="pt-px">{{ what }}</span>
        </p>
    {% endif %}
</header>
