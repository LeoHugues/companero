{% extends 'base.html.twig' %}

{% block title %}Nouvelle tâche · Companero{% endblock %}

{# Room for the save bar, fixed at the bottom of the screen. #}
{% block main_class %}{{ ux_is_native() ? 'pb-28' : 'pb-48' }}{% endblock %}

{% block body %}
    <header class="flex items-center justify-between">
        <h1 class="text-[22px]">Nouvelle tâche</h1>
        <a href="{{ ux_is_native() ? '/recede_historical_location' : path('app_home') }}" aria-label="Fermer" class="flex size-11 items-center justify-center rounded-full text-ink"><twig:Icon name="close" size="22" stroke="2.2"/></a>
    </header>

    <div class="flex items-end gap-2.5">
        <twig:CasaMini class="shrink-0"/>
        <p class="bubble mb-4">Qu’est-ce qu’il faut faire ?</p>
    </div>

    {% if catalog is not empty %}
        <section class="flex flex-col gap-2" aria-labelledby="catalog-title">
            <h2 id="catalog-title" class="field-label">Depuis le catalogue</h2>
            <ul class="-mx-5 flex gap-2 overflow-x-auto px-5 pb-1">
                {% for item in catalog %}
                    <li>
                        <a href="{{ path('task_new', {modele: item.id}) }}"
                           class="flex min-h-[76px] w-[116px] flex-col justify-between gap-1.5 rounded-2xl border-[1.5px] {{ template and template.id == item.id ? 'border-ink' : 'border-line' }} bg-surface p-2.5 text-ink no-underline transition hover:-translate-y-0.5 hover:border-ink hover:text-ink">
                            <span class="text-sm leading-tight font-bold">{{ item.title }}</span>
                            <span class="text-xs font-extrabold text-clay-dark">+{{ item.points }} pts</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {{ include('task/_form.html.twig', {submit_label: 'Ajouter la tâche'}) }}
{% endblock %}

{# In the Android app this form is a modal (see App\Native\NativeConfiguration): no bottom navigation. #}
{% block nav %}{% if not ux_is_native() %}<twig:BottomNav active="new"/>{% endif %}{% endblock %}
