{% extends 'base.html.twig' %}

{% block title %}Une tâche à faire · Companero{% endblock %}

{#
    Something to do: first among what the house already knows (the catalogue, the occasional tasks
    asleep), found by typing a few letters; or else a new one, which joins the catalogue.
#}
{% block body %}
    {{ include('task/_tunnel.html.twig', {
        step: 2,
        title: 'Une tâche à faire',
        icon: 'check',
        tile: 'tile-sun',
        what: 'Choisis-la parmi celles que la maison connaît déjà, ou crée-en une nouvelle.'
    }) }}

    <div class="flex flex-col gap-5" data-controller="filter">
        <label class="relative block">
            <span class="sr-only">Chercher une tâche</span>
            <span class="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-muted"><twig:Icon name="search" size="18" stroke="1.9"/></span>
            <input type="search" class="input bg-surface pl-10 shadow-[0_6px_16px_-12px_rgba(46,30,20,.35)]" placeholder="Chercher : vitres, placard, vomi…" autocomplete="off"
                   data-filter-target="input" data-action="input->filter#filter">
        </label>

        <a href="{{ path('task_new_one_off', {nouvelle: 1}) }}" data-filter-target="create" class="sheet list-row gap-3.5 px-4 py-3.5">
            <span class="tile tile-clay" aria-hidden="true"><twig:Icon name="plus" size="21" stroke="2.4"/></span>
            <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                <span class="row-title">Une nouvelle tâche</span>
                <span class="row-meta">Elle rejoint le catalogue pour la prochaine fois.</span>
            </span>
            <twig:Icon name="chevron-right" size="17" class="row-chevron"/>
        </a>

        {% if dormant is not empty %}
            <section class="flex flex-col gap-2.5" aria-labelledby="dormant-title" data-filter-target="group">
                <div class="px-1">
                    <h2 id="dormant-title" class="eyebrow">Ça arrive ?</h2>
                    <p class="mt-1 text-[12.5px] leading-snug text-muted">Les occasionnelles : un appui, et leur carte attend sur l’accueil.</p>
                </div>
                <ul class="flex flex-wrap gap-2">
                    {% for view in dormant %}
                        <li data-filter-target="item" data-filter-text="{{ view.task.title }} {{ task_place(view.task) }}"><twig:RaiseButton :task="view.task" compact/></li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {% if catalog is not empty %}
            <section class="flex flex-col gap-2" aria-labelledby="catalog-title" data-filter-target="group">
                <h2 id="catalog-title" class="group-label">Le catalogue</h2>
                <ul class="list-sheet">
                    {% for item in catalog %}
                        <li data-filter-target="item" data-filter-text="{{ item.title }} {{ item.category.label }} {{ item.zone.name ?? '' }}">
                            <a href="{{ path('task_new_one_off', {modele: item.id}) }}" class="list-row">
                                <twig:TaskVignette :task="item" class="vignette-small"/>
                                <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                                    <span class="row-title">{{ item.title }}</span>
                                    <span class="row-meta">{{ item.zone ? item.zone.name ~ ' · ' }}{{ item.category.label }}</span>
                                </span>
                                <span class="row-points">+{{ item.points }}</span>
                                <twig:Icon name="chevron-right" size="17" class="row-chevron"/>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        <p class="sheet-empty" data-filter-target="empty" hidden>Rien de tel pour l’instant : crée-la avec « Une nouvelle tâche », elle sera là la prochaine fois.</p>
    </div>
{% endblock %}

{# In the Android app this tunnel is a modal (see App\Native\NativeConfiguration): no bottom navigation. #}
{% block nav %}{% if not ux_is_native() %}<twig:BottomNav active="new"/>{% endif %}{% endblock %}
