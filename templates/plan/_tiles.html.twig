{# Rooms as simple tiles, when there is no plan: each on its floor, tinted by its mood like the plan's (55, 80, 92 %). #}
{% set cells = 0 %}
{% for room in rooms %}{% set cells = cells + (room.tasks|length >= 5 ? 2 : 1) %}{% endfor %}
<ul class="grid grid-flow-dense grid-cols-2 gap-3" aria-label="{{ label }}">
    {% for room in rooms %}
        {% set clean = room.cleanliness %}
        {% set floor = {radiant: '#FFFCF6', okay: '#FCF6EA', dusty: '#FBEACB', neglected: '#F8D9CC'}[room.mood.value] %}
        {# A big room takes the whole width, and the last one fills the gap if any. #}
        <li class="{{ room.tasks|length >= 5 or (loop.last and cells is odd) ? 'col-span-2' : '' }}">
            <a href="{{ path('plan_zone', {id: room.zone.id}) }}" class="sheet flex h-full min-h-[104px] flex-col justify-between gap-2 p-3.5 text-ink no-underline transition hover:-translate-y-0.5 hover:text-ink active:scale-[.98]" style="background: {{ floor }}"
               aria-label="{{ room.zone.name }} : propre à {{ clean }} %{{ room.pressingCount ? ', ' ~ room.pressingCount ~ ' à faire' }}">
                <span class="flex items-start justify-between gap-2">
                    <span class="text-[15px] leading-tight font-semibold">{{ room.zone.name }}</span>
                    <twig:CasaMini :size="34" :mood="room.mood" class="shrink-0"/>
                </span>
                <span class="flex items-center justify-between gap-2 text-[12.5px]">
                    <span class="font-semibold tabular-nums">{{ clean }} %<span class="font-normal text-muted">{{ room.zone.private ? ' · privée' }}</span></span>
                    {% if room.pressingCount %}
                        <span class="plan-row-count">{{ room.pressingCount }} à faire</span>
                    {% elseif room.tasks is empty %}
                        <span class="text-muted">rien de prévu</span>
                    {% endif %}
                </span>
            </a>
        </li>
    {% endfor %}
</ul>
