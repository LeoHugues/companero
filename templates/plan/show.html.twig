{% extends 'base.html.twig' %}

{% block title %}Le plan · Companero{% endblock %}

{% block body %}
    <header class="flex items-center justify-between">
        <div class="flex flex-col gap-0.5">
            <h1 class="text-[26px]">Le plan</h1>
            <p class="text-sm text-muted">La maison vue d’en haut : touche une pièce.</p>
        </div>
        <a href="{{ path('task_index') }}" class="chip shrink-0 gap-1.5"><twig:Icon name="list" size="18"/> Liste</a>
    </header>

    {% if rooms is empty %}
        <p class="card p-4 text-sm text-muted">Pas encore de pièces. <a href="{{ path('household_edit') }}">Ajoute des zones</a> pour dessiner le plan.</p>
    {% else %}
        <ul class="grid grid-cols-2 border-[3px] border-ink bg-ink gap-[3px] rounded-[14px] overflow-hidden" aria-label="Les pièces">
            {% for room in rooms %}
                {% set clean = room.cleanliness %}
                {% set floor = clean >= 92 ? 'bg-surface' : (clean >= 80 ? 'bg-[#FBEFD9]' : (clean >= 50 ? 'bg-[#F8DDA6]' : 'bg-[#F4C6A6]')) %}
                <li class="{{ room.tasks|length >= 5 ? 'col-span-2' : '' }}">
                    <a href="{{ path('plan_zone', {id: room.zone.id}) }}" class="flex h-full min-h-[104px] flex-col justify-between gap-2 p-3 text-ink no-underline transition hover:brightness-95 hover:text-ink {{ floor }}"
                       aria-label="{{ room.zone.name }} : propre à {{ clean }} %{{ room.pressingCount ? ', ' ~ room.pressingCount ~ ' à faire' }}">
                        <span class="flex items-start justify-between gap-2">
                            <span class="text-[15px] leading-tight font-extrabold">{{ room.zone.name }}</span>
                            <twig:CasaMini :size="36" :mood="room.mood" class="shrink-0"/>
                        </span>
                        <span class="flex items-center justify-between text-xs font-bold">
                            <span>{{ clean }} %{{ room.zone.private ? ' · privée' }}</span>
                            {% if room.pressingCount %}
                                <span class="rounded-full bg-clay px-2 py-0.5 text-ink">{{ room.pressingCount }} à faire</span>
                            {% elseif room.tasks is empty %}
                                <span class="text-muted">rien de prévu</span>
                            {% endif %}
                        </span>
                    </a>
                </li>
            {% endfor %}
        </ul>
        <p class="meta">Plus le sol est clair, plus la pièce est propre.</p>
    {% endif %}
{% endblock %}

{% block nav %}<twig:BottomNav active="tasks"/>{% endblock %}
