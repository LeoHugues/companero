{% extends 'base.html.twig' %}

{% block title %}Le plan · Companero{% endblock %}

{# The floor gets darker as a room needs attention; the garden stays green. #}
{% macro floor(clean) %}{{ clean >= 92 ? '#FFFCF6' : (clean >= 80 ? '#FBEFD9' : (clean >= 50 ? '#F8DDA6' : '#F4C6A6')) }}{% endmacro %}
{% macro grass(clean) %}{{ clean >= 80 ? '#BFD99A' : (clean >= 50 ? '#D3D99A' : '#E2D29A') }}{% endmacro %}

{% block body %}
    {% import _self as plan_colors %}
    <header class="flex items-center justify-between gap-3">
        <div class="flex flex-col gap-0.5">
            <h1 class="text-[26px]">Le plan</h1>
            <p class="text-sm text-muted">La maison vue d’en haut : touche une pièce.</p>
        </div>
        <a href="{{ path('task_index') }}" class="chip shrink-0 gap-1.5"><twig:Icon name="list" size="18"/> Liste</a>
    </header>

    {% if plan.drawn is empty and plan.others is empty %}
        <p class="card p-4 text-sm text-muted">Pas encore de pièces. <a href="{{ path('household_edit') }}">Ajoute des zones</a> pour dessiner le plan.</p>
    {% endif %}

    {% if plan.drawn %}
        {% set box = plan.viewBox %}
        <svg viewBox="{{ box.x }} {{ box.y }} {{ box.width }} {{ box.height }}" class="w-full select-none" role="group" aria-label="Plan de la maison" font-family="inherit">
            {% if plan.garden %}
                {% set garden = plan.garden %}
                <a href="{{ path('plan_zone', {id: garden.zone.id}) }}" aria-label="{{ garden.zone.name }} : propre à {{ garden.cleanliness }} %{{ garden.pressingCount ? ', ' ~ garden.pressingCount ~ ' à faire' }}" class="plan-room">
                    <rect x="{{ box.x + 0.4 }}" y="{{ box.y + 0.4 }}" width="{{ box.width - 0.8 }}" height="{{ box.height - 0.8 }}" rx="3" fill="{{ plan_colors.grass(garden.cleanliness) }}" stroke="#8DAF62" stroke-width="0.6"/>
                    <text x="{{ box.x + box.width / 2 }}" y="{{ box.y + box.height - 1.1 }}" text-anchor="middle" font-size="2.1" font-weight="800" fill="#4F6B2E">{{ garden.zone.name }}{{ garden.pressingCount ? ' · ' ~ garden.pressingCount ~ ' à faire' }}</text>
                </a>
            {% else %}
                <rect x="{{ box.x + 0.4 }}" y="{{ box.y + 0.4 }}" width="{{ box.width - 0.8 }}" height="{{ box.height - 0.8 }}" rx="3" fill="#D8E6C0"/>
            {% endif %}

            {# The walls: the gaps between rooms show the dark house underneath. #}
            {% set house = plan.houseBox %}
            <rect x="{{ house.x }}" y="{{ house.y }}" width="{{ house.width }}" height="{{ house.height }}" rx="0.8" fill="#4A3628"/>

            {% for item in plan.drawn %}
                {% set room = item.room %}
                {% set shape = item.shape %}
                {% set clean = room.cleanliness %}
                {% set name = room.zone.name|replace({'Chambre de ': 'Ch. ', 'Salle de bain': 'SDB', 'Terrasse de l’entrée': 'Terrasse entrée'}) %}
                <a href="{{ path('plan_zone', {id: room.zone.id}) }}" aria-label="{{ room.zone.name }} : propre à {{ clean }} %{{ room.pressingCount ? ', ' ~ room.pressingCount ~ ' à faire' }}" class="plan-room">
                    <polygon points="{{ shape.svgPoints }}" fill="{{ plan_colors.floor(clean) }}" stroke="#2E1E14" stroke-width="0.7" stroke-linejoin="round"/>
                    {% set lx = shape.label[0] %}
                    {% set ly = shape.label[1] %}
                    {% if shape.upright or shape.low %}
                        {% set label = shape.fit(name, 1.9, 1.2) %}
                        <text transform="translate({{ lx }} {{ ly }}){{ shape.upright ? ' rotate(-90)' }}" text-anchor="middle" dominant-baseline="central" font-size="{{ label.size|round(2) }}" font-weight="800" fill="#2E1E14">{{ name }}</text>
                    {% else %}
                        {% set label = shape.fit(name) %}
                        {% set top = ly - (label.lines|length - 1) * label.size * 0.55 - 0.6 %}
                        <text x="{{ lx }}" y="{{ top }}" text-anchor="middle" font-size="{{ label.size|round(2) }}" font-weight="800" fill="#2E1E14">
                            {%- for line in label.lines %}<tspan x="{{ lx }}" dy="{{ loop.first ? 0 : (label.size * 1.1)|round(2) }}">{{ line }}</tspan>{% endfor -%}
                        </text>
                        <text x="{{ lx }}" y="{{ top + (label.lines|length - 1) * label.size * 1.1 + 2.6 }}" text-anchor="middle" font-size="1.7" font-weight="700" fill="#7A6555">{{ clean }} %{{ room.zone.private and shape.maxX - shape.minX >= 20 ? ' · privée' }}</text>
                    {% endif %}
                    {% if room.pressingCount %}
                        <circle cx="{{ shape.maxX - 2.2 }}" cy="{{ shape.minY + 2.2 }}" r="1.6" fill="#E8692C" stroke="#2E1E14" stroke-width="0.35"/>
                        <text x="{{ shape.maxX - 2.2 }}" y="{{ shape.minY + 2.2 }}" text-anchor="middle" dominant-baseline="central" font-size="1.9" font-weight="800" fill="#2E1E14">{{ room.pressingCount }}</text>
                    {% endif %}
                </a>
            {% endfor %}
        </svg>
        <p class="meta flex flex-wrap items-center gap-x-3 gap-y-1">
            <span>Plus le sol est foncé, plus la pièce a besoin de toi.</span>
            <span class="flex items-center gap-1"><span class="inline-block size-3 rounded-full border border-ink bg-clay"></span>tâches à faire</span>
        </p>
    {% endif %}

    {% if plan.others %}
        {% if plan.drawn %}<h2 class="section-title mt-1">Hors du plan</h2>{% endif %}
        {{ include('plan/_tiles.html.twig', {rooms: plan.others, label: plan.drawn ? 'Les autres zones' : 'Les pièces'}) }}
        {% if plan.drawn is empty %}<p class="meta">Plus le sol est clair, plus la pièce est propre. Donne une forme aux zones dans les <a href="{{ path('household_edit') }}">réglages de la coloc</a> pour dessiner le vrai plan.</p>{% endif %}
    {% endif %}
{% endblock %}

{% block nav %}<twig:BottomNav active="tasks"/>{% endblock %}
