{% extends 'base.html.twig' %}

{% block title %}{{ room.zone.name }} · Companero{% endblock %}

{#
    A room of the plan: the little Casa of its mood, its cleanliness, its cards (compact), and what was done in it lately.
#}
{% block body %}
    {% set zone = room.zone %}
    {% set clean = room.cleanliness %}
    <header class="page-head">
        <a href="{{ ux_is_native() ? '/recede_historical_location' : path('plan_show') }}" aria-label="Retour au plan" class="head-button"><twig:Icon name="arrow-left" size="20" stroke="2"/></a>
        <a href="{{ path('zone_edit', {id: zone.id}) }}" class="head-link"><twig:Icon name="settings" size="16" stroke="1.9"/>Réglages</a>
    </header>
    <div class="-mb-1">
        <p class="eyebrow">Le plan{{ zone.private ? ' · pièce privée' }}</p>
        <h1 class="page-title mt-1">{{ zone.name }}</h1>
    </div>

    <section class="sheet flex flex-col gap-4 p-4" aria-label="État de la pièce">
        <div class="flex items-end gap-3">
            <twig:CasaMini :size="68" :mood="room.mood" class="shrink-0"/>
            <p class="bubble mb-6 flex-1 text-[14px]">{{ room.pressingCount ? room.pressingCount ~ ' chose' ~ (room.pressingCount > 1 ? 's') ~ ' à faire ici.' : 'Rien d’urgent par ici.' }}</p>
        </div>
        <div class="flex flex-col gap-2 border-t border-line/70 pt-3.5">
            <div class="flex items-baseline justify-between gap-2">
                <span class="eyebrow">Propreté</span>
                <span class="text-[24px] leading-none font-bold tracking-tight"><twig:Count :value="clean" :key="'zone-' ~ zone.id"/><span class="text-[14px] font-medium text-muted"> %</span></span>
            </div>
            <twig:ProgressBar :value="clean" :height="8" :color="clean >= 80 ? 'var(--color-ok)' : (clean >= 55 ? 'var(--color-warn)' : 'var(--color-danger)')" label="Propreté de {{ zone.name }}" :key="'zone-' ~ zone.id"/>
        </div>
    </section>

    <section class="flex flex-col gap-3" aria-labelledby="zone-tasks-title">
        <div class="section-head px-1">
            <h2 id="zone-tasks-title" class="eyebrow">Ce qui peut être fait</h2>
            {% if room.tasks is not empty %}<p class="text-[12.5px] text-muted">{{ room.tasks|length }} carte{{ room.tasks|length > 1 ? 's' }}</p>{% endif %}
        </div>
        {% for view in room.tasks %}
            <twig:TaskCard :view="view" :member="app.user" :back="'zone-' ~ zone.id" compact/>
        {% else %}
            <p class="sheet-empty">Aucune tâche dans cette pièce. <a href="{{ path('task_new') }}">En créer une</a></p>
        {% endfor %}
    </section>

    <section class="flex flex-col gap-2" aria-labelledby="zone-done-title">
        <h2 id="zone-done-title" class="group-label">Fait ces 30 derniers jours</h2>
        {% if done is not empty %}
            <ul class="list-sheet">
                {% for completion in done %}
                    <li class="list-row min-h-12">
                        <twig:Avatar :member="completion.member" size="30"/>
                        <span class="flex min-w-0 flex-1 flex-col">
                            <span class="row-title truncate">{{ completion.task.title }}</span>
                            <span class="row-meta">{{ completion.member.name }} · {{ completion.completedAt|format_date(pattern: 'EEEE d MMM', locale: 'fr') }}</span>
                        </span>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="sheet-empty">Rien de noté ici ces derniers temps.</p>
        {% endif %}
    </section>
{% endblock %}

{% block nav %}<twig:BottomNav active="tasks"/>{% endblock %}
