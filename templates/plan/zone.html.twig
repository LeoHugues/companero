{% extends 'base.html.twig' %}

{% block title %}{{ room.zone.name }} · Companero{% endblock %}

{% block body %}
    {% set zone = room.zone %}
    <header class="flex items-center gap-2">
        <a href="{{ path('plan_show') }}" aria-label="Retour au plan" class="flex size-11 shrink-0 items-center justify-center rounded-full text-ink hover:bg-track"><twig:Icon name="chevron-left" size="22" stroke="2.4"/></a>
        <h1 class="flex-1 text-[24px] leading-tight">{{ zone.name }}</h1>
    </header>

    <section class="card flex items-end gap-3 p-3.5" aria-label="État de la pièce">
        <twig:CasaMini :size="80" :mood="room.mood" class="shrink-0"/>
        <div class="mb-1 flex flex-1 flex-col gap-1.5">
            <p class="bubble text-sm">{{ room.pressingCount ? room.pressingCount ~ ' chose' ~ (room.pressingCount > 1 ? 's') ~ ' à faire ici.' : 'Rien d’urgent par ici.' }}</p>
            <div class="flex justify-between text-xs font-bold"><span>Propreté</span><span>{{ room.cleanliness }} %</span></div>
            <twig:ProgressBar :value="room.cleanliness" height="8" label="Propreté de {{ zone.name }}"/>
        </div>
    </section>

    <section class="flex flex-col gap-2.5" aria-labelledby="zone-tasks-title">
        <h2 id="zone-tasks-title" class="section-title">Ce qui peut être fait</h2>
        {% for view in room.tasks %}
            <twig:TaskRow :view="view" :member="app.user" :back="'zone-' ~ zone.id"/>
        {% else %}
            <p class="meta py-2">Aucune tâche dans cette pièce. <a href="{{ path('task_new') }}">En créer une</a></p>
        {% endfor %}
    </section>

    <section class="flex flex-col gap-2" aria-labelledby="zone-done-title">
        <h2 id="zone-done-title" class="section-title">Fait ces 30 derniers jours</h2>
        {% if done is not empty %}
            <ul class="card divide-y divide-line px-3.5 py-1">
                {% for completion in done %}
                    <li class="flex items-center gap-2.5 py-2">
                        <twig:Avatar :member="completion.member" size="26"/>
                        <span class="flex min-w-0 flex-1 flex-col">
                            <span class="truncate text-sm font-bold">{{ completion.task.title }}</span>
                            <span class="text-xs text-muted">{{ completion.member.name }} · {{ completion.completedAt|format_date(pattern: 'EEEE d MMM', locale: 'fr') }}</span>
                        </span>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="card p-4 text-sm text-muted">Rien de noté ici ces derniers temps.</p>
        {% endif %}
    </section>
{% endblock %}

{% block nav %}<twig:BottomNav active="tasks"/>{% endblock %}
