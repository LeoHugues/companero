<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The pages' feedback: a tick under the finger, points earned, a box that opens, a cat that purrs. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Updates itself from the server (Updater.kt): no need to uninstall for a new build. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The coloc's reminders (Notifier.kt), checked every quarter of an hour. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- usesCleartextTraffic: the self-hosted server is plain HTTP on the home Wi-Fi. -->
    <application
        android:name=".CompaneroApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Companero"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".UpdateReceiver" android:exported="false" />

        <!-- "À la maison" in the quick settings, next to Wi-Fi and Bluetooth. -->
        <service
            android:name=".PresenceTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_home"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
