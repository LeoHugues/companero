# Companero derrière Caddy (HTTPS automatique avec Let's Encrypt).
# À copier dans /etc/caddy/Caddyfile (ou à importer), en adaptant le domaine, le dossier et le socket PHP-FPM.

companero.example.org {
	root * /srv/companero/public
	encode zstd gzip

	# Les assets compilés ont une empreinte dans leur nom : ils peuvent rester en cache longtemps.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# L'APK de l'appli Android, à déposer dans public/ (voir docs/deploiement.md).
	@apk path /companero.apk
	header @apk Content-Type application/vnd.android.package-archive

	php_fastcgi unix//run/php/php8.4-fpm.sock
	file_server
}
