# Timer systemd de Companero, à copier dans /etc/systemd/system/ (voir docs/deploiement.md),
# en adaptant le dossier. L'utilisateur est celui qui fait tourner PHP.
[Unit]
Description=Companero : clôture de la semaine

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/srv/companero
Environment=APP_ENV=prod
ExecStart=/usr/bin/php bin/console app:week:close --no-interaction
